@import url("./theme.css");

/* ============================================
   TALLER - Estilos de layout específicos
   ============================================ */

/* Grid superior del taller */
.taller-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: stretch;
    margin-bottom: 1rem;
}

/* ============================================
   DROPZONE PARA FOTOS
   ============================================ */
.photo-dropzone {
    border: 2px dashed rgba(243, 197, 0, 0.35);
    border-radius: 16px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.03);
    position: relative;
    margin-bottom: 1rem;
}

.photo-dropzone:hover,
.photo-dropzone.dragover {
    border-color: rgba(243, 197, 0, 0.7);
    background: rgba(243, 197, 0, 0.06);
    box-shadow: 0 0 30px rgba(243, 197, 0, 0.05);
}

.photo-dropzone__title {
    display: block;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: 0.35rem;
}

.photo-dropzone__subtitle {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.photo-dropzone input[type="file"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 10;
}

/* ============================================
