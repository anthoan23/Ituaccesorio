					<button class="ui-btn ui-btn--primary" type="submit">Finalizar registro</button>
				</div>
			</form>
		</section>
	{% endcall %}
	
	{% call modal('modal-feedback-login', 'Mensaje', 'sm') %}
		<div class="ui-form__grid ui-form__grid--one">
			<p id="feedback-login-message">Mensaje</p>
		</div>
		<div class="ui-form__actions">
			<button class="ui-btn ui-btn--primary" type="button" data-close-modal>Aceptar</button>
		</div>
	{% endcall %}
{% endblock %}

{% block scripts %}
	<!-- SOLO CARGAR reCAPTCHA SI NO ESTÁ EN MODO PRUEBA Y LA CLAVE EXISTE -->
	{% if recaptcha_site_key and not is_test_mode %}
		<script src="https://www.google.com/recaptcha/api.js" async defer></script>
	{% endif %}
	<script src="{{ url_for('static', filename='js/field-validator.js') }}"></script>
	<script src="{{ url_for('static', filename='js/login.js') }}"></script>
{% endblock %}
</file>

<file path="views/ordenes_entregas.html">
{% extends 'components/layout/base.html' %}
{% from 'components/ui/modal.html' import modal %}

{% block title %}Ituaccesorio - Órdenes de Entregas / Recepción{% endblock %}

{% block head_extra %}
