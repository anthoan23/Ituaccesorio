                    c.Nombre_cargo AS nombre,
                    COUNT(e.ID_empleado) AS cantidad
                FROM Cargo c
                LEFT JOIN Empleado e ON e.ID_cargo = c.ID_cargo
                GROUP BY c.ID_cargo, c.Nombre_cargo
