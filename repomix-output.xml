<file path="app/static/css/entregas.css">
/* ============================================
   ENTREGAS.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

.entregas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   STATS - GRID DE 3 COLUMNAS
   ============================================ */
.stats--grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
}

.stat-card--accent {
    background: linear-gradient(145deg, rgba(243, 197, 0, 0.25), rgba(243, 197, 0, 0.12));
    border-color: rgba(243, 197, 0, 0.3);
}

.stat-card--accent .stat-card__value {
    color: var(--yellow);
}

.stat-card--accent .stat-card__label {
    color: var(--yellow-soft);
}

.stat-card--accent .stat-card__meta {
    color: rgba(243, 197, 0, 0.7);
}

/* ============================================
   HERO - ACCIONES
   ============================================ */
.hero__actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================
   CARD CON TABS
   ============================================ */
.card--tabs {
    padding: 0;
    overflow: hidden;
}

/* ============================================
   TABS
   ============================================ */
.tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border-light);
    padding: 0.5rem 1.25rem 0;
    background: var(--glass-bg);
}

.tab {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--text-muted);
    padding: 0.7rem 1rem;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    white-space: nowrap;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    position: relative;
}

.tab:hover {
    background: var(--ghost-hover-bg);
    color: var(--text-strong);
}

.tab.is-active {
    color: var(--text-strong);
    font-weight: 900;
}

.tab.is-active::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: -1px;
    height: 3px;
    border-radius: 999px;
    background: var(--yellow);
}

.tab-panel {
    padding: 1.25rem;
}

/* ============================================
   TOOLBAR DE ENTREGAS
   ============================================ */
.entregas-toolbar {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    align-items: end;
}

.entregas-toolbar__field {
    margin: 0;
}

.entregas-toolbar__field input,
.entregas-toolbar__field .select-wrapper select {
    width: 100%;
}

/* ============================================
   COLUMNAS DE TABLA
   ============================================ */
.col-id {
    width: 110px;
}

/* ============================================
   ESTADOS DE ENTREGA (badges)
   ============================================ */
.estado-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.estado-pendiente {
    background: rgba(245, 166, 35, 0.15);
    color: #f5a623;
    border: 1px solid rgba(245, 166, 35, 0.25);
}

.estado-camino {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.25);
}

.estado-entregado {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
}

.estado-cancelado {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
}

.estado-programado {
    background: rgba(139, 92, 246, 0.15);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.25);
}

/* ============================================
   TOAST
   ============================================ */
.toast {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 9999;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    background: var(--bg);
    color: var(--text-strong);
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    box-shadow: var(--shadow-card);
    pointer-events: none;
    font-weight: 700;
    border: 1px solid var(--glass-border);
}

.toast.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.toast--error {
    background: rgba(220, 38, 38, 0.92);
    color: #ffffff;
    border-color: rgba(220, 38, 38, 0.5);
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 1100px) {
    .hero {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 920px) {
    .entregas-toolbar {
        grid-template-columns: 1fr;
    }
    
    .hero__actions {
        justify-content: flex-start;
        width: 100%;
    }
    
    .hero__actions .ui-btn {
        flex: 1;
        min-width: 120px;
        justify-content: center;
    }
}

@media (max-width: 780px) {
    .stats--grid {
        grid-template-columns: 1fr 1fr;
    }
    
    .col-id {
        width: auto;
    }
    
    .table {
        min-width: 600px;
    }
    
    .tabs {
        padding: 0.5rem 0.75rem 0;
        overflow-x: auto;
    }
    
    .tab {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }
}

@media (max-width: 480px) {
    .stats--grid {
        grid-template-columns: 1fr;
    }
}
</file>

