@keyframes heroDriftRight {
	0%,
	100% {
		transform: translate3d(0, 0, 0) scale(1);
		opacity: 0.85;
	}

	50% {
		transform: translate3d(-2.4rem, 1rem, 0) scale(1.14);
		opacity: 1;
	}
}

@keyframes heroDriftLeft {
	0%,
	100% {
		transform: translate3d(0, 0, 0) scale(1);
		opacity: 0.55;
	}

	50% {
		transform: translate3d(2.2rem, -1.1rem, 0) scale(1.16);
		opacity: 0.8;
	}
}

@keyframes glowDriftOne {
	0%,
	100% {
		transform: translate3d(0, 0, 0) scale(1);
	}

