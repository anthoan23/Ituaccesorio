                <span class="breadcrumb__current">Órdenes de Entregas</span>
            </li>
        </ol>
    </nav>

    <!-- Hero unificado con glassmorphism -->
    <header class="hero" aria-label="Encabezado de órdenes de entregas">
        <div class="hero__copy">
            <p class="hero__eyebrow">Gestión de recepción</p>
            <h1 class="hero__title">Órdenes de Entregas de Proveedores</h1>
            <p class="hero__description">Registra la recepción de productos y actualiza el stock automáticamente.</p>
        </div>

        <div class="hero__actions" aria-label="Acciones">
            <button id="btn-actualizar" class="ui-btn ui-btn--ghost" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                    <polyline points="23 4 23 10 17 10"/>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
                Actualizar
            </button>
        </div>
    </header>

    <section class="content ordenes-entregas-grid" aria-label="Gestión de órdenes de entregas">
        <!-- Switcher de vistas -->
        <div class="vista-switcher">
            <button class="vista-switcher__btn is-active" id="btn-pendientes" data-view="pendientes">Pendientes de entrega</button>
            <button class="vista-switcher__btn" id="btn-entregadas" data-view="entregadas">Historial de entregas</button>
        </div>

        <!-- Vista Pendientes -->
        <div id="vista-pendientes" class="card card--table" aria-label="Órdenes pendientes de entrega">
            <div class="card__header">
                <div class="card__header-left">
                    <h2 class="card__title">Órdenes pendientes de entrega</h2>
                    <p class="card__subtitle">Órdenes listas para recibir en inventario.</p>
                </div>
            </div>
            <div class="table-wrap" role="region" aria-label="Tabla de órdenes pendientes">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="col-id">ID orden</th>
                            <th>Proveedor</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th class="col-status">Estado</th>
                            <th class="col-total">Costo total</th>
                            <th class="table__actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-ordenes-entregas-pendientes">
                        <tr><td colspan="7" class="table__loading">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Vista Entregadas -->
        <div id="vista-entregadas" class="card card--table is-hidden" aria-label="Historial de entregas">
            <div class="card__header">
                <div class="card__header-left">
                    <h2 class="card__title">Historial de entregas</h2>
                    <p class="card__subtitle">Registros de recepción de mercancía.</p>
                </div>
            </div>
            <div class="table-wrap" role="region" aria-label="Tabla de historial de entregas">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="col-id">ID entrega</th>
                            <th>ID orden</th>
                            <th>Proveedor</th>
                            <th>Fecha entrega</th>
                            <th>Hora</th>
                            <th>Recibido por</th>
                            <th class="table__actions">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-ordenes-entregas-historial">
                        <tr><td colspan="7" class="table__loading">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Modal Registrar Entrega -->
    {% call modal('modal-registrar-entrega', 'Registrar entrega', 'lg') %}
        <form id="form-registrar-entrega" class="ui-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" id="entrega-orden-id" value="">

            <div class="ui-form__grid ui-form__grid--two">
                <label class="field">
                    <span>Recibido por <span class="required-indicator">*</span></span>
                    <input type="text" id="entrega-recibido-por" class="form__input" 
                           placeholder="Nombre de quien recibe" maxlength="20"
                           data-validation-rules="soloLetrasNumeros,capitalizar"
                           title="Solo letras, números, espacios, acentos y ñ">
                    <small class="field-hint">Solo letras, números, espacios (máximo 20 caracteres)</small>
                </label>
                <label class="field">
                    <span>Fecha de entrega <span class="required-indicator">*</span></span>
                    <input type="date" id="entrega-fecha" class="form__input">
                </label>
            </div>

            <div id="entrega-productos-preview" class="entrega-preview"></div>

            <div class="ui-form__actions">
                <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
                <button id="btn-confirmar-entrega" class="ui-btn ui-btn--primary" type="submit">Registrar entrega</button>
            </div>
        </form>
    {% endcall %}

    <!-- Modal Detalle Orden -->
    {% call modal('modal-detalle-orden', 'Detalle de orden', 'lg') %}
        <div id="detalle-orden-info" class="device-detail__grid">
            <p class="device-detail__empty">Cargando...</p>
        </div>
        <div class="table-wrap table-wrap--mt">
            <table class="table">
                <thead>
                    <tr>
                        <th>Marca</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Costo</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody id="detalle-orden-productos">
                    <tr><td colspan="5" class="table__empty">No hay productos</td></tr>
                </tbody>
            </table>
        </div>
        <p class="form__total form__total--mt">Costo total: <strong>Bs. <span id="detalle-orden-total-value">0</span></strong></p>
    {% endcall %}

    <!-- Modal Editar Entrega -->
    {% call modal('modal-editar-entrega', 'Editar entrega', 'md') %}
        <form id="form-editar-entrega" class="ui-form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
            
            <div class="ui-form__grid ui-form__grid--two">
                <label class="field">
                    <span>ID Entrega</span>
                    <input id="editar-id-entrega" type="text" readonly>
                </label>
                <label class="field">
                    <span>ID Orden</span>
                    <input id="editar-id-orden-entrega" type="text" readonly>
                </label>
            </div>
            
            <div class="ui-form__grid ui-form__grid--two">
                <label class="field">
                    <span>Recibido por <span class="required-indicator">*</span></span>
                    <input type="text" id="editar-recibido-por" class="form__input" 
                           placeholder="Nombre de quien recibe" maxlength="20"
                           data-validation-rules="soloLetrasNumeros,capitalizar"
                           title="Solo letras, números, espacios, acentos y ñ">
                    <small class="field-hint">Solo letras, números, espacios (máximo 20 caracteres)</small>
                </label>
                <label class="field">
                    <span>Fecha de entrega <span class="required-indicator">*</span></span>
                    <input type="date" id="editar-fecha-entrega" class="form__input">
                </label>
                <label class="field">
                    <span>Hora de entrega</span>
                    <input type="time" id="editar-hora-entrega" class="form__input">
                </label>
            </div>

            <div class="ui-form__actions">
                <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
                <button id="btn-guardar-editar-entrega" class="ui-btn ui-btn--primary" type="submit">Actualizar entrega</button>
            </div>
        </form>
    {% endcall %}

    <!-- Modal Confirmar Eliminar Entrega -->
    {% call modal('modal-confirmar-eliminar-entrega', 'Confirmar eliminación', 'sm') %}
        <p id="texto-confirmar-eliminar-entrega" class="confirm-text">¿Seguro que desea eliminar esta entrega? Se revertirá el stock.</p>
        <div class="ui-form__actions">
            <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
            <button id="btn-confirmar-eliminar-entrega" class="ui-btn ui-btn--danger">Eliminar</button>
        </div>
    {% endcall %}

    <!-- Modal de Feedback (para mensajes) -->
    <div id="feedback-modal" class="ui-modal" data-modal hidden>
        <div class="ui-modal__dialog ui-modal__dialog--sm">
            <div class="ui-modal__header">
                <h3 class="ui-modal__title">Notificación</h3>
                <button class="ui-modal__close" data-close-modal aria-label="Cerrar">×</button>
            </div>
            <div class="ui-modal__body">
                <p id="mensaje-texto"></p>
            </div>
        </div>
    </div>

</main>


{% endblock %}

{% block scripts %}
    <script src="{{ url_for('static', filename='js/field-validator.js') }}"></script>
    <script src="{{ url_for('static', filename='js/ordenes_entregas.js') }}"></script>
{% endblock %}
</file>

<file path="views/tradein_empleados.html">
{% extends 'components/layout/base.html' %}

{% block title %}Ituaccesorio - Gestión de Trade-In{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/tradein_empleados.css') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/field-validator.css') }}">
{% endblock %}

{% block content %}
<main class="page">
  <!-- Breadcrumb unificado -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
      <li aria-current="page">
        <span class="breadcrumb__current">Gestión de Trade-In</span>
      </li>
    </ol>
  </nav>

  <!-- Hero unificado con glassmorphism -->
  <header class="hero" aria-label="Encabezado de trade-in empleados">
    <div class="hero__copy">
      <p class="hero__eyebrow">Gestión de Trade-In</p>
      <h1 class="hero__title">Registro de equipos recibidos</h1>
      <p class="hero__description">Administra los equipos trade-in recibidos en la tienda.</p>
    </div>
    <div class="hero__actions">
      <button id="btn-nuevo-tradein" class="ui-btn ui-btn--primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        Nuevo Trade-In
      </button>
    </div>
  </header>

  <!-- Tarjetas de estadísticas -->
  <div class="stats stats--grid">
    <div class="stat-card">
      <div class="stat-card__icon">📱</div>
      <div class="stat-card__info">
        <span class="stat-card__value" id="stat-total">0</span>
        <span class="stat-card__label">Total Trade-Ins</span>
      </div>
    </div>
    <div class="stat-card stat-card--accent">
      <div class="stat-card__icon">💰</div>
      <div class="stat-card__info">
        <span class="stat-card__value" id="stat-valor-total">$0</span>
        <span class="stat-card__label">Total Pagado</span>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-card__icon">📱</div>
      <div class="stat-card__info">
        <span class="stat-card__value" id="stat-equipos">0</span>
        <span class="stat-card__label">Equipos Únicos</span>
      </div>
    </div>
  </div>

  <!-- Tabla de trade-ins -->
  <article class="card card--table" aria-label="Equipos recibidos">
    <div class="card__header">
      <div class="card__header-left">
        <h2 class="card__title">Equipos recibidos</h2>
        <p class="card__subtitle">Historial de todos los equipos trade-in registrados</p>
      </div>
      <div class="card__actions">
        <div class="search-box">
          <input
            type="text"
            id="search-tradein"
            placeholder="Buscar por cliente o equipo..."
            class="field__input"
          />
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Equipo</th>
            <th>Marca</th>
            <th>Cotización</th>
            <th>Tests</th>
            <th class="table__actions">Acciones</th>
          </tr>
        </thead>
        <tbody id="tradein-list">
          <tr>
            <td colspan="8" class="table__empty">Cargando...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </article>
</main>

<!-- Modal para REGISTRAR/EDITAR trade-in -->
<div id="modal-registrar" class="ui-modal" data-modal hidden>
  <div class="ui-modal__dialog ui-modal__dialog--lg">
    <div class="ui-modal__header">
      <h3 class="ui-modal__title">Registrar nuevo Trade-In</h3>
      <button class="ui-modal__close" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body">
      <form id="form-registrar-tradein" class="ui-form" enctype="multipart/form-data">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}" />

        <div class="ui-form__grid">
          <!-- Buscar cliente -->
          <label class="field field--full">
            <span>Cliente <span class="required-indicator">*</span></span>
            <div class="cliente-search">
              <input
                type="text"
                id="cliente-search-input"
                class="field__input"
                placeholder="Buscar por cédula, nombre o apellido..."
              />
              <input type="hidden" id="cliente-id" name="cliente_id" />
            </div>
            <div id="cliente-results" class="search-results is-hidden"></div>
          </label>

          <!-- Datos del equipo -->
          <label class="field">
            <span>Producto/Modelo <span class="required-indicator">*</span></span>
            <div class="select-wrapper">
              <select id="producto-id" name="id_producto" class="field__input" required>
                <option value="">Seleccionar producto...</option>
              </select>
            </div>
          </label>

          <label class="field">
            <span>IMEI / ID del equipo <span class="required-indicator">*</span></span>
            <input
              type="text"
              id="id_equipo"
              name="id_equipo"
              class="field__input"
              placeholder="Número IMEI o ID único del equipo"
              required
              maxlength="15"
              data-validation-rules="soloNumeros,sinEspacios"
              title="Solo números, sin espacios"
            />
            <small class="field-hint">Ingrese el IMEI del equipo solo números, sin espacios.</small>
          </label>

          <label class="field">
            <span>Color</span>
            <input
              type="text"
              id="color"
              name="color"
              class="field__input"
              placeholder="Ej: Negro, Azul..."
              maxlength="30"
              data-validation-rules="soloLetras,capitalizar"
              title="Solo letras, espacios, acentos y ñ"
            />
            <small class="field-hint">Solo letras, espacios, acentos y ñ</small>
          </label>

          <label class="field">
            <span>Capacidad</span>
            <input
              type="text"
              id="capacidad"
              name="capacidad"
              class="field__input"
              placeholder="Ej: 128GB, 256GB..."
              maxlength="20"
              data-validation-rules="soloLetrasNumeros"
              title="Solo letras y números"
            />
            <small class="field-hint">Solo letras y números (ej: 128GB)</small>
          </label>

          <label class="field">
            <span>Clave numérica</span>
            <input
              type="text"
              id="clave"
              name="clave"
              class="field__input"
              placeholder="Código de desbloqueo"
              maxlength="10"
              data-validation-rules="soloNumeros"
              title="Solo números"
            />
            <small class="field-hint">Solo números</small>
          </label>

          <label class="field">
            <span>Patrón</span>
            <input
              type="text"
              id="patron"
              name="patron"
              class="field__input"
              placeholder="Patrón de desbloqueo"
              maxlength="20"
              data-validation-rules="soloNumeros"
              title="Solo números"
            />
            <small class="field-hint">Solo números</small>
          </label>

          <label class="field">
            <span>Valor pagado ($) <span class="required-indicator">*</span></span>
            <input
              type="text"
              id="valor-pagado"
              name="valor_pagado"
              class="field__input"
              placeholder="0.00"
              required
              data-validation-rules="decimal"
              title="Solo números, puede incluir hasta 2 decimales"
            />
            <small class="field-hint">Solo números (ej: 100, 150.50, 99.99)</small>
          </label>

          <label class="field field--full">
            <span>Observaciones</span>
            <textarea
              id="observaciones"
              name="observaciones"
              class="field__input"
              rows="3"
              placeholder="Notas adicionales sobre el equipo..."
              maxlength="500"
              data-validation-rules="sinCaracteresEspeciales"
              title="Sin caracteres especiales"
            ></textarea>
            <small class="field-hint">Sin caracteres especiales (máximo 500 caracteres)</small>
          </label>

          <!-- SECCIÓN DE TESTS - AHORA DENTRO DEL FORMULARIO DE REGISTRO -->
          <div class="tests-section-container">
            <hr class="tests-divider">
            <div id="tests-container-registro"></div>
          </div>

          <label class="field field--full">
            <span>Fotos del equipo</span>
            <div id="fotos-preview" class="fotos-preview"></div>
            <input
              type="file"
              id="fotos"
              name="fotos"
              class="field__input"
              accept="image/*"
              multiple
            />
            <small class="field-hint">📸 Puede seleccionar múltiples fotos (JPG, PNG)</small>
          </label>
        </div>

        <div class="ui-form__actions">
          <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
          <button type="submit" class="ui-btn ui-btn--primary">Registrar Trade-In</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal para REGISTRAR TESTS (mantenido para compatibilidad) -->
<div id="modal-tests" class="ui-modal" data-modal hidden>
  <div class="ui-modal__dialog ui-modal__dialog--lg">
    <div class="ui-modal__header">
      <h3 class="ui-modal__title">Realizar pruebas al equipo</h3>
      <button class="ui-modal__close" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body">
      <div id="tests-equipo-info" class="equipo-info"></div>

      <div class="tests-categorias">
        <div id="tests-container" class="tests-grid"></div>
      </div>

      <div class="ui-form__actions">
        <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
        <button type="button" id="btn-guardar-tests" class="ui-btn ui-btn--primary">Guardar pruebas</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de DETALLE -->
<div id="modal-detalle" class="ui-modal" data-modal hidden>
  <div class="ui-modal__dialog ui-modal__dialog--lg">
    <div class="ui-modal__header">
      <h3 class="ui-modal__title">Detalle del Trade-In</h3>
      <button class="ui-modal__close" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body" id="detalle-contenido"></div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/field-validator.js') }}"></script>
<script defer src="{{ url_for('static', filename='js/tradein_empleados.js') }}"></script>
{% endblock %}
</file>

