        <nav class="drawer__nav" id="drawerNav" data-nav-container>
            {# Verificar si es admin #}
            {% set es_admin = g.user and (g.user.rol_id == 1 or g.user.rol_nombre == 'admin') %}
            {# Verificar si es cliente (rol 'cliente' o rol_id 7) #}
            {% set es_cliente = g.user and ((g.user.rol_nombre is defined and g.user.rol_nombre|lower == 'cliente') or (g.user.rol_id is defined and g.user.rol_id == 7)) %}
            
