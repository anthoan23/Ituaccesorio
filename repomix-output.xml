<file path="app/static/css/index.css">
/* ============================================
   DASHBOARD iOS 18 STYLE - UNIFICADO CON THEME.CSS
   ============================================ */
.dashboard {
    font-family: 'SF Pro Display', 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    width: 100%;
    max-width: 100%;
    padding: 20px 28px 32px;
    margin: 0;
    display: block;
    overflow-x: hidden;
    box-sizing: border-box;
}

/* ============================================ */
/* KPI CARDS */
/* ============================================ */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}

.kpi-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    border: 1px solid var(--border-color);
    transition: var(--transition);
    min-height: 110px;
}

.kpi-card:hover {
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    border-color: var(--border-light);
    box-shadow: var(--shadow-dash);
}

.kpi-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.kpi-card__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.kpi-card__icon svg {
    width: 18px;
    height: 18px;
}

.kpi-card__icon--yellow {
    background: rgba(255,214,10,0.15);
    color: #FFD60A;
}

.kpi-card__icon--blue {
    background: rgba(0,122,255,0.15);
    color: #007AFF;
}

.kpi-card__icon--green {
    background: rgba(52,199,89,0.15);
    color: #34C759;
}

.kpi-card__icon--red {
    background: rgba(255,69,58,0.15);
    color: #FF3B30;
}

.kpi-card__trend {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 20px;
}

.trend-up {
    color: var(--green);
    background: rgba(52, 199, 89, 0.12);
}

.trend-down {
    color: var(--red);
    background: rgba(255, 69, 58, 0.12);
}

.kpi-card__value {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.2;
}

.kpi-card__label {
    font-size: 12px;
    color: var(--text-secondary);
}

.kpi-card__chart {
    height: 24px;
    margin-top: 4px;
}

.kpi-card__chart svg {
    width: 100%;
    height: 100%;
}

/* ============================================ */
/* SECCIÓN: GRÁFICO + ACTIVIDAD */
/* ============================================ */
.two-col-grid {
    display: grid;
    grid-template-columns: 7fr 3fr;
    gap: 20px;
    margin-bottom: 24px;
}

.chart-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius);
    padding: 20px 24px 24px;
    border: 1px solid var(--border-color);
}

.chart-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.chart-card__title {
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
}

.chart-card__subtitle {
    font-size: 11px;
    color: var(--text-secondary);
    margin: 0;
}

.chart-card__legend {
    display: flex;
    gap: 14px;
    font-size: 11px;
    color: var(--text-secondary);
}

.legend-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 5px;
}

.legend-dot--income {
    background: var(--yellow);
}

.legend-dot--expense {
    background: var(--text-muted);
}

.chart-card__body {
    height: 200px;
}

.chart-card__body canvas {
    width: 100% !important;
    height: 100% !important;
}

/* ============================================ */
/* ACTIVITY CARD */
/* ============================================ */
.activity-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius);
    padding: 20px 20px 16px;
    border: 1px solid var(--border-color);
}

.activity-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.activity-card__title {
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
}

.activity-card__more {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
    transition: var(--transition);
}

.activity-card__more:hover {
    color: var(--text-primary);
}

.activity-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 260px;
    overflow-y: auto;
}

.activity-list::-webkit-scrollbar {
    width: 3px;
}

.activity-list::-webkit-scrollbar-track {
    background: transparent;
}

.activity-list::-webkit-scrollbar-thumb {
    background: var(--text-muted);
    border-radius: 999px;
}

.activity-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 12px;
    background: var(--bg-card-hover);
    transition: var(--transition);
}

.activity-item:hover {
    background: var(--bg-card-hover);
}

.activity-item__icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-card-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 14px;
}

.activity-item__content {
    flex: 1;
    min-width: 0;
}

.activity-item__text {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.3;
}

.activity-item__text strong {
    color: var(--text-primary);
}

.activity-item__time {
    font-size: 10px;
    color: var(--text-muted);
    display: block;
    margin-top: 1px;
}

/* ============================================ */
/* SECCIÓN: ÓRDENES + ACCIONES RÁPIDAS */
/* ============================================ */
.orders-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius);
    padding: 20px 20px 16px;
    border: 1px solid var(--border-color);
}

.orders-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.orders-card__title {
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
}

.orders-card__more {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 12px;
    cursor: pointer;
    transition: var(--transition);
}

.orders-card__more:hover {
    color: var(--text-primary);
}

.orders-card__table-wrap {
    overflow-x: auto;
}

.orders-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    color: var(--text-secondary);
}

.orders-table thead th {
    text-align: center;
    padding: 8px 10px;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--border-color);
}

.orders-table tbody td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
}

.orders-table tbody tr {
    transition: var(--transition);
    cursor: pointer;
}

.orders-table tbody tr:hover {
    background: var(--bg-card-hover);
}

.orders-table tbody td:first-child {
    font-weight: 500;
    color: var(--text-primary);
}

.orders-table tbody td:last-child {
    font-weight: 500;
    color: var(--text-primary);
}

.status-chip {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 600;
}

.status-chip--pendiente {
    background: rgba(255, 214, 10, 0.15);
    color: var(--yellow);
}

.status-chip--proceso {
    background: rgba(0, 122, 255, 0.15);
    color: var(--blue);
}

.status-chip--completada {
    background: rgba(52, 199, 89, 0.15);
    color: var(--green);
}

/* ============================================ */
/* ACCIONES RÁPIDAS */
/* ============================================ */
.quick-actions {
    display: flex;
    align-items: stretch;
}

.quick-actions__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
}

.quick-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px 12px;
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
    font-family: inherit;
}

.quick-action:hover {
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    border-color: var(--yellow);
    color: var(--text-primary);
}

.quick-action__icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--bg-card-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
}

.quick-action:hover .quick-action__icon {
    background: rgba(255, 214, 10, 0.12);
}

.quick-action__icon svg {
    width: 20px;
    height: 20px;
}

.quick-action span {
    font-size: 11px;
    font-weight: 500;
}

/* ============================================ */
/* WIDGETS (iOS Style) */
/* ============================================ */
.widgets-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 24px;
}

.widget {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    transition: var(--transition);
}

.widget:hover {
    background: var(--bg-card-hover);
    transform: translateY(-2px);
    border-color: var(--border-light);
}

.widget__icon {
    font-size: 24px;
    flex-shrink: 0;
}

.widget__content {
    flex: 1;
}

.widget__number {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
}

.widget__label {
    font-size: 11px;
    color: var(--text-secondary);
}

.widget__trend {
    font-size: 10px;
    color: var(--green);
    font-weight: 500;
    flex-shrink: 0;
}

.widget__trend--danger {
    color: var(--red);
}

/* ============================================ */
/* LOADING / EMPTY */
/* ============================================ */
.loading {
    color: var(--text-secondary);
    font-size: 13px;
    padding: 12px;
    text-align: center;
}

.empty-message {
    color: var(--text-muted);
    font-size: 12px;
    padding: 12px;
    text-align: center;
}

.celda-cargando {
    text-align: center;
    color: var(--text-muted);
    padding: 16px;
}

/* ============================================ */
/* RESPONSIVE */
/* ============================================ */
@media (max-width: 1200px) {
    .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .widgets-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 992px) {
    .two-col-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .dashboard {
        padding: 12px 16px 20px;
    }

    .kpi-card__value {
        font-size: 20px;
    }

    .quick-actions__grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 480px) {
    .dashboard {
        padding: 8px 10px 16px;
    }

    .kpi-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .kpi-card {
        padding: 12px 14px;
        min-height: 90px;
    }

    .kpi-card__value {
        font-size: 18px;
    }

    .widgets-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .widget {
        padding: 12px 14px;
    }

    .quick-actions__grid {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .quick-action {
        padding: 12px 8px;
    }

    .quick-action__icon {
        width: 32px;
        height: 32px;
    }

    .quick-action__icon svg {
        width: 16px;
        height: 16px;
    }

    .quick-action span {
        font-size: 10px;
    }

    .orders-table {
        font-size: 11px;
    }

    .orders-table thead th,
    .orders-table tbody td {
        padding: 6px 8px;
    }
}
