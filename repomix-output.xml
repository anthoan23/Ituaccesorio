<!-- TOPBAR - SIN HAMBURGUESA -->
<!-- ============================================ -->
<header class="topbar">
    <div class="topbar__left">
        <a class="brand" href="/" aria-label="Ir al inicio">
            <img class="brand__logo" src="{{ url_for('static', filename='img/LOGO TRAZO BLANCO.png') }}" alt="iTuAccesorio">
        </a>
    </div>

    <div class="topbar__center">
        <div class="search-spotlight">
            <svg class="search-spotlight__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" class="search-spotlight__input" placeholder="Buscar en iTuAccesorio..." />
            <kbd class="search-spotlight__shortcut">⌘K</kbd>
        </div>
    </div>

    <div class="topbar__right">
        <div class="topbar__right-capsule">
            <!-- Modo claro / oscuro -->
            <button class="icon-btn" type="button" aria-label="Cambiar tema" data-theme-toggle>
                <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                </svg>
                <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
                </svg>
            </button>

            {% if g.user %}
            <!-- Notificaciones -->
            <div class="notifications" data-notifications-root>
                <button class="icon-btn" type="button" aria-label="Notificaciones" data-notifications-toggle>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.93 6 11v5l-2 2v1h16v-1l-2-2z"/>
                    </svg>
                    <span class="notifications__badge" data-notifications-badge hidden>0</span>
                </button>
                
                <div class="notifications__panel" data-notifications-panel hidden>
                    <div class="notifications__header">
                        <strong>Notificaciones</strong>
                        <small data-notifications-status>Conectando...</small>
                    </div>
                    
                    <div class="notifications__list" data-notifications-list></div>
                    
                    <div class="notifications__empty" data-notifications-empty hidden>
                        No hay notificaciones nuevas
                    </div>
                </div>
            </div>

            <!-- ===== CARRITO DE COMPRAS ===== -->
            {% if es_cliente %}
            <div class="cart-widget" data-cart-root>
                <button class="icon-btn" type="button" aria-label="Carrito de compras" data-cart-toggle>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"/>
                        <circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                    <span class="cart-badge" data-cart-badge hidden>0</span>
                </button>
                
                <!-- Panel desplegable del carrito -->
                <div class="cart-panel" data-cart-panel hidden>
                    <div class="cart-panel__header">
                        <strong>Mi carrito</strong>
                        <small data-cart-count>0 productos</small>
                    </div>
                    
                    <div class="cart-panel__list" data-cart-list>
                        <div class="cart-panel__empty">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="9" cy="21" r="1"/>
                                <circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                            <p>Tu carrito está vacío</p>
                        </div>
                    </div>
                    
                    <div class="cart-panel__footer">
                        <div class="cart-panel__total">
                            <span>Total:</span>
                            <strong data-cart-total>Bs. 0</strong>
                        </div>
                        <button class="cart-panel__checkout" data-cart-checkout disabled>
                            Ir a pagar
                        </button>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Mensajes -->
            <button class="icon-btn" aria-label="Mensajes">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
            </button>

            <!-- User Menu -->
            <details class="user-menu">
                <summary class="user-menu__trigger">
                    <span class="user__avatar" aria-hidden="true">
                        {% if g.user.foto_perfil %}
                        <img class="user__avatar-image" src="{{ g.user.foto_perfil }}" alt="">
                        {% else %}
                        <span class="user__avatar-initial">{{ (g.user.usuario_nombre[:1] if g.user.usuario_nombre else 'U')|upper }}</span>
                        {% endif %}
                    </span>
                    <span class="user__meta">
                        <strong class="user__name">{{ g.user.usuario_nombre }}</strong>
                        <span class="user__role">{{ g.user.rol_nombre }}</span>
                    </span>
                    <svg class="user-menu__chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </summary>

                <div class="user-menu__panel" role="menu" aria-label="Menú de usuario">
                    <div class="user-menu__identity">
                        <span class="user-menu__identity-avatar" aria-hidden="true">
                            {% if g.user.foto_perfil %}
                            <img class="user__avatar-image" src="{{ g.user.foto_perfil }}" alt="">
                            {% else %}
                            <span class="user__avatar-initial">{{ (g.user.usuario_nombre[:1] if g.user.usuario_nombre else 'U')|upper }}</span>
                            {% endif %}
                        </span>
                        <span class="user-menu__label">Usuario</span>
                        <strong class="user-menu__full-name">{{ g.user.usuario_nombre }}</strong>
                        <span class="user-menu__role-text">{{ g.user.rol_nombre }}</span>
                    </div>

                    <form class="user-menu__logout" action="{{ url_for('login.logout') }}" method="GET">
                        <button class="user-menu__action-btn" type="button" data-open-modal="modal-mi-perfil">Editar perfil</button>
                        <button class="user-menu__logout-btn" type="submit">Cerrar sesión</button>
                    </form>
                </div>
            </details>
            {% else %}
            <div class="user user--guest">
                <a class="btn btn--yellow" href="{{ url_for('login.pagina_login') }}">Iniciar sesión</a>
            </div>
            {% endif %}
        </div>
    </div>
</header>

<!-- BACKDROP (para móvil) -->
<div class="backdrop" id="menu-backdrop"></div>

{% if g.user %}
{% call modal('modal-mi-perfil', 'Mi perfil', 'sm') %}
    <form id="mi-perfil-form" class="ui-form" autocomplete="off">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
        <label class="ui-field">
            <span>Usuario</span>
            <input id="mi-perfil-nombre" name="nombre" type="text" value="{{ g.user.usuario_nombre or '' }}" required maxlength="50">
        </label>
        <label class="ui-field">
            <span>Cédula</span>
            <input id="mi-perfil-cedula" type="text" value="{{ g.user.cedula or g.user.cedula_personal or '' }}" readonly data-validator-disabled="true">
        </label>
        <label class="ui-field">
            <span>Rol</span>
            <input id="mi-perfil-rol" type="text" value="{{ g.user.rol_nombre or '' }}" readonly data-validator-disabled="true">
        </label>
        <label class="ui-field">
            <span>Nueva contraseña (opcional)</span>
            <div class="password-field">
                <input id="mi-perfil-password" name="password" type="password" placeholder="Dejar vacío para no cambiar" minlength="6" maxlength="50">
                <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña">Mostrar</button>
            </div>
        </label>
        <label class="ui-field">
            <span>Confirmar contraseña</span>
            <div class="password-field">
                <input id="mi-perfil-password-confirm" type="password" placeholder="Repite la nueva contraseña" minlength="6" maxlength="50">
                <button class="password-toggle" type="button" data-password-toggle aria-label="Mostrar contraseña">Mostrar</button>
            </div>
        </label>
        <label class="ui-field">
            <span>Foto de perfil</span>
            <input id="mi-perfil-foto-input" name="foto_perfil" type="file" accept="image/*" hidden data-validator-disabled="true">
            <button id="mi-perfil-foto-btn" class="ui-btn ui-btn--ghost" type="button">Subir foto</button>
            <small id="mi-perfil-foto-name" class="user-menu__hint">Ningún archivo seleccionado</small>
            <div class="user-menu__avatar-preview">
                <img id="mi-perfil-foto-preview" src="{{ g.user.foto_perfil if g.user.foto_perfil else url_for('static', filename='img/LOGO.png') }}" alt="Vista previa de foto de perfil">
            </div>
        </label>
        <div class="ui-form__actions">
            <button class="ui-btn ui-btn--ghost" type="button" data-close-modal>Cancelar</button>
            <button class="ui-btn ui-btn--primary" type="submit">Guardar cambios</button>
        </div>
    </form>
{% endcall %}
{% endif %}
</file>

<file path="views/ventas/reportes.html">
{% extends 'components/layout/base.html' %}

{% block title %}Ituaccesorio - Reportes de Ventas{% endblock %}

{% block head_extra %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/reportes_ventas.css') }}">
<link rel="stylesheet" href="{{ url_for('static', filename='css/field-validator.css') }}">
{% endblock %}

{% block content %}
<main class="page">
  <!-- Breadcrumb unificado -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
      <li aria-current="page">
        <span class="breadcrumb__current">Reportes de Ventas</span>
      </li>
    </ol>
  </nav>

  <!-- Hero unificado con glassmorphism -->
  <header class="hero" aria-label="Encabezado de reportes de ventas">
    <div class="hero__copy">
      <p class="hero__eyebrow">Reportes y ventas</p>
      <h1 class="hero__title">Reportes de Ventas</h1>
      <p class="hero__description">Consulta el historial de ventas y registra nuevas ventas locales</p>
    </div>
    <div class="hero__actions">
      <button id="btn-venta-local" class="ui-btn ui-btn--primary" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        Nueva Venta Local
      </button>
    </div>
  </header>

  <!-- Tabs -->
  <div class="tabs" role="tablist" aria-label="Pestañas de reportes">
    <button class="tab-btn is-active" data-tab="reportes" role="tab" aria-selected="true">Reportes</button>
    <button class="tab-btn" data-tab="ventas-local" role="tab" aria-selected="false">Ventas Locales</button>
  </div>

  <!-- ==================== TAB REPORTES ==================== -->
  <div id="reportes-tab" class="tab-content">
    <div class="card card--filters">
      <!-- Filtros -->
      <div class="filters-section">
        <h4 class="filters-title">Filtros de búsqueda</h4>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Búsqueda</span>
            <input
              type="text"
              id="reporte-busqueda"
              class="field__input"
              placeholder="Factura, cliente..."
              data-validation-rules="sinCaracteresEspeciales"
              title="Sin caracteres especiales"
            />
          </div>

          <div class="field">
            <span class="field__label">Estado</span>
            <div class="select-wrapper">
              <select id="reporte-estado" class="field__input">
                <option value="">Todos</option>
                <option value="pendiente">Pendiente</option>
                <option value="aprobado">Aprobado</option>
                <option value="rechazado">Rechazado</option>
              </select>
            </div>
          </div>
        </div>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Método de pago</span>
            <div class="select-wrapper">
              <select id="reporte-metodo" class="field__input">
                <option value="">Todos</option>
                <option value="pago_movil">Pago Móvil</option>
                <option value="zelle">Zelle</option>
                <option value="binance">Binance</option>
                <option value="efectivo_usd">Efectivo USD</option>
                <option value="efectivo_bs">Efectivo Bs</option>
              </select>
            </div>
          </div>

          <div class="field">
            <span class="field__label">Moneda</span>
            <div class="select-wrapper">
              <select id="reporte-moneda" class="field__input">
                <option value="">Todas</option>
                <option value="USD">USD</option>
                <option value="VES">VES</option>
                <option value="USDT">USDT</option>
              </select>
            </div>
          </div>
        </div>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Fecha desde</span>
            <input type="date" id="reporte-fecha-desde" class="field__input" />
          </div>

          <div class="field">
            <span class="field__label">Fecha hasta</span>
            <input type="date" id="reporte-fecha-hasta" class="field__input" />
          </div>
        </div>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Monto mínimo</span>
            <input
              type="number"
              id="reporte-monto-min"
              step="0.01"
              min="0"
              class="field__input"
              placeholder="0.00"
            />
          </div>

          <div class="field">
            <span class="field__label">Monto máximo</span>
            <input
              type="number"
              id="reporte-monto-max"
              step="0.01"
              min="0"
              class="field__input"
              placeholder="0.00"
            />
          </div>
        </div>

        <div class="filters-actions">
          <button id="btn-generar-reporte" class="ui-btn ui-btn--primary">Generar reporte</button>
          <button id="btn-limpiar-filtros" class="ui-btn ui-btn--ghost">Limpiar filtros</button>
        </div>
      </div>

      <!-- Resumen -->
      <div id="reporte-resumen" class="reporte-resumen is-hidden">
        <h4 class="filters-title">Resumen</h4>
        <div class="stats-summary">
          <div class="stat-summary stat-summary--total">
            <span class="stat-summary__label">Total transacciones</span>
            <span class="stat-summary__value" id="reporte-total">0</span>
          </div>
          <div class="stat-summary stat-summary--monto">
            <span class="stat-summary__label">Monto total</span>
            <span class="stat-summary__value" id="reporte-total-monto">$0.00</span>
          </div>
          <div class="stat-summary stat-summary--pendiente">
            <span class="stat-summary__label">Pendientes</span>
            <span class="stat-summary__value" id="reporte-pendientes">0</span>
          </div>
          <div class="stat-summary stat-summary--aprobado">
            <span class="stat-summary__label">Aprobados</span>
            <span class="stat-summary__value" id="reporte-aprobados">0</span>
          </div>
          <div class="stat-summary stat-summary--rechazado">
            <span class="stat-summary__label">Rechazados</span>
            <span class="stat-summary__value" id="reporte-rechazados">0</span>
          </div>
        </div>
      </div>

      <!-- Tabla -->
      <div id="reporte-preview" class="reporte-preview is-hidden">
        <h4 class="filters-title">Resultados</h4>
        <div class="table-wrap table-wrap--scroll">
          <table class="table">
            <thead>
              <tr>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Método</th>
                <th>Referencia</th>
                <th>Monto</th>
                <th>Estado</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="reporte-tabla">
              <tr>
                <td colspan="8" class="table__empty">Selecciona filtros y genera un reporte</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Exportar -->
      <div id="reporte-export" class="reporte-export is-hidden">
        <div class="export-actions">
          <button id="btn-exportar-excel" class="ui-btn ui-btn--success" disabled>Exportar Excel</button>
          <button id="btn-exportar-pdf" class="ui-btn ui-btn--danger" disabled>Exportar PDF</button>
          <button id="btn-imprimir" class="ui-btn ui-btn--ghost" disabled>Imprimir</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== TAB VENTAS LOCALES ==================== -->
  <div id="ventas-local-tab" class="tab-content is-hidden">
    <div class="card card--table">
      <div class="card__header">
        <div class="card__header-left">
          <h2 class="card__title">Ventas Locales Registradas</h2>
          <p class="card__subtitle">Historial de ventas realizadas directamente en tienda física.</p>
        </div>
      </div>

      <div class="filters-section">
        <div class="filters-row">
          <div class="field">
            <span class="field__label">Buscar</span>
            <input
              type="text"
              id="venta-local-busqueda"
              class="field__input"
              placeholder="Factura o cliente..."
              data-validation-rules="sinCaracteresEspeciales"
              title="Sin caracteres especiales"
            />
          </div>
          <div class="field">
            <span class="field__label">Fecha</span>
            <input type="date" id="venta-local-fecha" class="field__input" />
          </div>
        </div>
        <div class="filters-actions">
          <button id="btn-buscar-ventas-locales" class="ui-btn ui-btn--primary">Buscar</button>
          <button id="btn-limpiar-filtros-locales" class="ui-btn ui-btn--ghost">Limpiar</button>
        </div>
      </div>

      <div class="table-wrap table-wrap--scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Factura</th>
              <th>Cliente</th>
              <th>Fecha</th>
              <th>Método</th>
              <th>Monto</th>
              <th>Estado</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody id="ventas-locales-tabla">
            <tr>
              <td colspan="7" class="table__loading">Cargando ventas locales...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- ==================== MODAL NUEVA VENTA LOCAL ==================== -->
<div id="venta-local-modal" class="ui-modal" data-modal hidden aria-hidden="true">
  <div class="ui-modal__dialog ui-modal__dialog--lg" role="dialog" aria-modal="true" aria-labelledby="venta-local-title">
    <div class="ui-modal__header">
      <h3 id="venta-local-title" class="ui-modal__title">Nueva Venta Local</h3>
      <button class="ui-modal__close" type="button" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body">
      <form id="form-venta-local" class="ui-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">

        <!-- ====== BUSCADOR DE CLIENTES (estilo proveedores) ====== -->
        <div class="field field--full">
          <span class="field__label">Cliente</span>
          <div class="cliente-busqueda-container">
            <div class="cliente-busqueda-input-wrapper">
              <input
                type="text"
                id="cliente-busqueda-input"
                class="field__input"
                placeholder="Buscar cliente por ID, nombre o cédula..."
                autocomplete="off"
              />
              <button type="button" id="cliente-buscar-btn" class="ui-btn ui-btn--ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                  <circle cx="11" cy="11" r="8"/>
                  <path d="m21 21-4.35-4.35"/>
                </svg>
              </button>
            </div>
            <div id="cliente-resultados" class="cliente-resultados-dropdown is-hidden"></div>
          </div>
          <input type="hidden" id="cliente-id" name="cliente_id" />
          <div id="cliente-seleccionado" class="cliente-seleccionado is-hidden">
            <span id="cliente-seleccionado-info"></span>
            <button type="button" id="cliente-limpiar" class="icon-action" aria-label="Limpiar cliente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                <path d="M18 6 6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <small class="field-hint">Busca por ID, cédula, nombre o apellido</small>
        </div>

        <!-- ====== MÉTODO DE PAGO ====== -->
        <div class="ui-form__grid ui-form__grid--two">
          <div class="field">
            <span class="field__label">Método de pago</span>
            <div class="select-wrapper">
              <select id="metodo-local" class="field__input">
                <option value="">-- Selecciona --</option>
                <option value="pago_movil">Pago Móvil (Bs)</option>
                <option value="zelle">Zelle (USD)</option>
                <option value="binance">Binance (USDT)</option>
                <option value="efectivo_bs">Efectivo (Bs)</option>
                <option value="efectivo_usd">Efectivo (USD)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ====== PRODUCTOS ====== -->
        <div class="field field--full">
          <span class="field__label">Agregar Producto</span>
          <div class="producto-agregar-row">
            <div class="select-wrapper select-flexible">
              <select id="producto-select" class="field__input">
                <option value="">-- Selecciona un producto --</option>
              </select>
            </div>
            <div class="field campo-cantidad">
              <input type="number" id="cantidad-local" class="field__input" value="1" min="1" />
            </div>
            <button type="button" id="agregar-producto-local" class="ui-btn ui-btn--primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Agregar
            </button>
          </div>
        </div>

        <!-- ====== LISTA DE PRODUCTOS AGREGADOS ====== -->
        <div class="field field--full">
          <span class="field__label">Productos agregados</span>
          <div id="items-local-list" class="items-local">
            <div class="sin-resultados">No hay productos agregados</div>
          </div>
        </div>

        <!-- ====== ACCIONES ====== -->
        <div class="ui-form__actions">
          <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
          <button type="submit" class="ui-btn ui-btn--primary" id="btn-registrar-venta-local">Registrar Venta</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ==================== MODAL DETALLE VENTA ==================== -->
<div id="modal-detalle-venta" class="ui-modal" data-modal hidden aria-hidden="true">
  <div class="ui-modal__dialog ui-modal__dialog--lg" role="dialog" aria-modal="true" aria-labelledby="detalle-venta-title">
    <div class="ui-modal__header">
      <h3 id="detalle-venta-title" class="ui-modal__title">Detalle de Venta</h3>
      <button class="ui-modal__close" type="button" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body">
      <div id="detalle-venta-info" class="detail-info"></div>
      <div class="table-wrap table-wrap--scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Marca</th>
              <th>Clase</th>
              <th>Cantidad</th>
              <th>Precio Unitario</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody id="detalle-venta-productos"></tbody>
          <tfoot>
            <tr id="detalle-venta-total">
              <td colspan="5" class="detalle-total-label">Total:</td>
              <td id="detalle-venta-total-amount" class="detalle-total-amount"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
<script defer src="{{ url_for('static', filename='js/reportes_ventas.js') }}"></script>
{% endblock %}
</file>

<file path="views/empleados.html">
{% extends 'components/layout/base.html' %}
{% from 'components/ui/modal.html' import modal %}

{% block title %}Ituaccesorio - Empleados{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/empleados.css') }}">
{% endblock %}

{% block content %}
  <main class="page empleados-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li><a href="{{ url_for('home.home') }}">Inicio</a></li>    
        <li aria-current="page">
          <span class="breadcrumb__current">Empleados</span>
        </li>
      </ol>
    </nav>

    <header class="empleados-hero">
      <div class="empleados-hero__copy">
        <p class="empleados-hero__eyebrow">Gestión de personal</p>
        <h1 class="empleados-hero__title">Empleados</h1>
        <p class="empleados-hero__description">Vista simple para consultar y registrar empleados.</p>
      </div>

      <div class="stats stats--single" aria-label="Resumen de empleados">
        <article class="stat-card">
          <span class="stat-card__label">Empleados</span>
          <strong class="stat-card__value" data-count="7">0</strong>
          <small class="stat-card__meta">Total de empleados visibles</small>
        </article>
      </div>
    </header>

    <section class="content vista-1 empleados-grid" aria-label="Gestión de empleados">
      <article class="card card--table empleados-table-card" aria-label="Empleados registrados">
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Catálogo de empleados</h2>
            <p class="card__subtitle">Tabla principal de empleados registrados.</p>
          </div>
          <div class="card__actions">
            <button class="btn-icon-action--success" type="button" data-open-modal="modal-registrar-empleado">
              Nuevo Empleado
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                <polyline points="17 21 17 13 7 13 7 21"/>
                <polyline points="7 3 7 8 15 8"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="table-wrap table-wrap--tall" role="region" aria-label="Tabla de empleados">
          <table class="table">
            <thead>
              <tr>
                <th>Cédula</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Cargo</th>
                <th class="table__actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-empleados"></tbody>
          </table>
