.tradein-choice input,
.tradein-check input {
    accent-color: var(--yellow);
    flex-shrink: 0;
}

.tradein-choice span,
.tradein-check span {
    font-weight: 600;
    color: var(--text-strong);
}

.tradein-fallas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.25rem;
}

/* ============================================
   ALERTA DE LIBERACIÓN
   ============================================ */
.tradein-alert {
    margin: 0.75rem 0 0;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.22);
    color: #dc2626;
    font-weight: 700;
}

/* ============================================
   BOTÓN DE ENVÍO
