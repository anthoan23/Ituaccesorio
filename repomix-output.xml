            estado_pago=estado_pago,
            datos_pago=datos_pago,
            usuario_id=usuario_id
        )
        modelo_pago.guardar_registro_pago()
        
        # Vaciar el carrito
        modelo_carrito.vaciar_carrito()
        
        return jsonify({
            "success": True,
