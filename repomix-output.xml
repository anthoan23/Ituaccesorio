}

.tradein-result__section-title {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.tradein-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
}

.tradein-list li {
    display: flex;
