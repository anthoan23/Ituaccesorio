/* ============================================
   FIELD-VALIDATOR.CSS - Validación de campos
   ============================================ */

/* Contenedor del campo */
.field-validator-wrapper {
  position: relative;
  width: 100%;
  display: block;
}

/* ===== CAMPOS CON ICONOS ===== */
.field-validator-wrapper input,
.field-validator-wrapper textarea,
.field-validator-wrapper select {
  padding-right: 38px !important;
  transition: padding-right 0.3s ease;
  width: 100%;
  box-sizing: border-box;
}

/* Ajuste para textarea */
.field-validator-wrapper textarea {
  resize: vertical;
  min-height: 60px;
}

/* ===== ICONO DE VALIDACIÓN - SOLO LA IMAGEN ===== */
.validation-icon {
  position: absolute;
  top: 50%;
  right: 8px;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  z-index: 5;
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  width: auto !important;
  height: auto !important;
  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Icono visible - con animación de entrada */
.validation-icon.visible {
  opacity: 1;
  transform: translateY(-50%) scale(1);
}

/* ===== ANIMACIONES ===== */

/* Animación de aparición */
.validation-icon.icon-appear {
  animation: iconAppear 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes iconAppear {
  0% {
    opacity: 0;
    transform: translateY(-50%) scale(0.5) rotate(-10deg);
  }
  50% {
    opacity: 0.8;
    transform: translateY(-50%) scale(1.2) rotate(5deg);
  }
  70% {
    transform: translateY(-50%) scale(0.95) rotate(-2deg);
  }
  100% {
    opacity: 1;
    transform: translateY(-50%) scale(1) rotate(0deg);
  }
}

/* Animación de cambio de tipo */
.validation-icon.icon-change {
  animation: iconChange 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes iconChange {
  0% {
    opacity: 1;
    transform: translateY(-50%) scale(1) rotate(0deg);
  }
  30% {
    opacity: 0.6;
    transform: translateY(-50%) scale(0.8) rotate(-15deg);
  }
  60% {
    opacity: 0.8;
    transform: translateY(-50%) scale(1.2) rotate(10deg);
  }
  80% {
    transform: translateY(-50%) scale(0.95) rotate(-3deg);
  }
  100% {
    opacity: 1;
    transform: translateY(-50%) scale(1) rotate(0deg);
  }
}

/* Animación de ocultación */
.validation-icon.icon-hide {
  animation: iconHide 0.3s ease-in forwards;
}

@keyframes iconHide {
  0% {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateY(-50%) scale(0.5) rotate(10deg);
  }
}

/* ===== IMÁGENES DE VALIDACIÓN ===== */
.validation-icon-img {
  display: block;
  width: 24px;
  height: 24px;
  object-fit: contain;
}

/* ===== POSICIONES ESPECÍFICAS ===== */

/* Para textarea */
.field-validator-wrapper textarea ~ .validation-icon {
  top: 12px;
  transform: translateY(0);
}

.field-validator-wrapper textarea ~ .validation-icon.visible {
  transform: translateY(0) scale(1);
}

/* Para textarea - animaciones sin translateY */
.field-validator-wrapper textarea ~ .validation-icon.icon-appear {
  animation: iconAppearTextarea 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes iconAppearTextarea {
  0% {
    opacity: 0;
    transform: scale(0.5) rotate(-10deg);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.2) rotate(5deg);
  }
  70% {
    transform: scale(0.95) rotate(-2deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

.field-validator-wrapper textarea ~ .validation-icon.icon-change {
  animation: iconChangeTextarea 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes iconChangeTextarea {
  0% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  30% {
    opacity: 0.6;
    transform: scale(0.8) rotate(-15deg);
  }
  60% {
    opacity: 0.8;
    transform: scale(1.2) rotate(10deg);
  }
  80% {
    transform: scale(0.95) rotate(-3deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

.field-validator-wrapper textarea ~ .validation-icon.icon-hide {
  animation: iconHideTextarea 0.3s ease-in forwards;
}

@keyframes iconHideTextarea {
  0% {
    opacity: 1;
    transform: scale(1);
  }
  100% {
    opacity: 0;
    transform: scale(0.5) rotate(10deg);
  }
}

/* Para select */
.field-validator-wrapper select ~ .validation-icon {
  top: 50%;
  transform: translateY(-50%);
}

/* ===== ESTILOS DE BORDE - SOLO BORDE Y SOMBRA, SIN CAMBIAR FONDO ===== */

/* Campo válido */
.field-validator-wrapper input.field-success,
.field-validator-wrapper textarea.field-success,
.field-validator-wrapper select.field-success {
  border-color: #22c55e !important;
  box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.15) !important;
}

.field-validator-wrapper input.field-success:focus,
.field-validator-wrapper textarea.field-success:focus,
.field-validator-wrapper select.field-success:focus {
  border-color: #16a34a !important;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2) !important;
}

/* Campo con error */
.field-validator-wrapper input.field-error,
.field-validator-wrapper textarea.field-error,
.field-validator-wrapper select.field-error {
  border-color: #ef4444 !important;
  box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.15) !important;
}

.field-validator-wrapper input.field-error:focus,
.field-validator-wrapper textarea.field-error:focus,
.field-validator-wrapper select.field-error:focus {
  border-color: #dc2626 !important;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2) !important;
}

/* ===== MENSAJES DE ERROR ===== */
.field-message {
  font-size: 0.75rem;
  margin-top: 0.25rem;
  color: #ef4444;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  animation: slideDown 0.2s ease-out;
}

/* ===== CONTADOR DE CARACTERES ===== */
.field-counter {
  font-size: 0.7rem;
  margin-top: 0.25rem;
  color: #6c757d;
  text-align: right;
  font-family: monospace;
  transition: color 0.3s ease;
}

.field-counter .counter-current {
  font-weight: 600;
  transition: color 0.3s ease;
}

.field-counter .counter-max {
  color: #6c757d;
}

.field-counter.counter-warning .counter-current {
  color: #f59e0b;
}

.field-counter.counter-danger .counter-current {
  color: #ef4444;
}

/* ===== ADVERTENCIA ===== */
.field-warning {
  font-size: 0.7rem;
  margin-top: 0.25rem;
  color: #f59e0b;
  animation: slideDown 0.2s ease-out;
}

/* ===== INDICADOR DE CAMPO REQUERIDO ===== */
.required-indicator {
  color: #ef4444;
  margin-left: 0.25rem;
  font-size: 1rem;
  font-weight: 700;
  display: inline-block;
}

/* ===== ANIMACIONES BASE ===== */
@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== RESPONSIVE ===== */

/* Tablets y móviles pequeños */
@media (max-width: 768px) {
  .validation-icon {
    right: 6px;
  }
  
  .validation-icon-img {
    width: 20px;
    height: 20px;
  }
  
  .field-validator-wrapper input,
  .field-validator-wrapper textarea,
  .field-validator-wrapper select {
    padding-right: 32px !important;
  }
}

/* Móviles muy pequeños */
@media (max-width: 480px) {
  .validation-icon {
    right: 4px;
  }
  
  .validation-icon-img {
    width: 18px;
    height: 18px;
  }
  
  .field-validator-wrapper input,
  .field-validator-wrapper textarea,
  .field-validator-wrapper select {
    padding-right: 28px !important;
  }
}

/* ===== SOPORTE PARA TEMA OSCURO/CLARO ===== */

/* Modo oscuro */
[data-theme="dark"] .field-message {
  color: #f87171;
}

[data-theme="dark"] .field-counter {
  color: #9ca3af;
}

[data-theme="dark"] .field-counter .counter-max {
  color: #6b7280;
}

[data-theme="dark"] .field-warning {
  color: #fbbf24;
}

[data-theme="dark"] .required-indicator {
  color: #f87171;
}

/* Modo claro */
[data-theme="light"] .field-message {
  color: #dc2626;
}

[data-theme="light"] .field-counter {
  color: #6b7280;
}

[data-theme="light"] .field-warning {
  color: #d97706;
}

[data-theme="light"] .required-indicator {
  color: #dc2626;
}

/* ===== GRUPO DE CAMPOS ===== */
.field-group .field-validator-wrapper {
  margin-bottom: 0.5rem;
}

.field-group .field-validator-wrapper:last-child {
  margin-bottom: 0;
}
