<file path="views/ventas/validacion.html">
{% extends 'components/layout/base.html' %}

{% block title %}Ituaccesorio - Validación de Pagos{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/validacion_pagos.css') }}">
  <link rel="stylesheet" href="{{ url_for('static', filename='css/field-validator.css') }}">
{% endblock %}

{% block content %}
<main class="page">
  <!-- Breadcrumb unificado -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
      <li aria-current="page">
        <span class="breadcrumb__current">Validación de Pagos</span>
      </li>
    </ol>
  </nav>

  <!-- Hero unificado con glassmorphism -->
  <header class="hero" aria-label="Encabezado de validación de pagos">
    <div class="hero__copy">
      <p class="hero__eyebrow">Gestión de pagos</p>
      <h1 class="hero__title">Validación de Pagos</h1>
      <p class="hero__description">Revisa los comprobantes de pago y aprueba o rechaza las transacciones</p>
    </div>
    <div class="hero__actions">
      <button id="btn-reportes-pagos" class="ui-btn ui-btn--ghost" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <path d="M21 12v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        Reportes
      </button>
    </div>
  </header>

  <!-- Tabs -->
  <div class="tabs" role="tablist" aria-label="Pestañas de validación">
    <button class="tab-btn is-active" data-tab="pendientes" role="tab" aria-selected="true">Pendientes</button>
    <button class="tab-btn" data-tab="aprobados" role="tab" aria-selected="false">Aprobados</button>
    <button class="tab-btn" data-tab="rechazados" role="tab" aria-selected="false">Rechazados</button>
  </div>

  <!-- Contenido de pestañas -->
  <div id="pendientes-tab" class="tab-content">
    <div id="pendientes-list" class="pagos-grid"></div>
  </div>
  <div id="aprobados-tab" class="tab-content is-hidden">
    <div id="aprobados-list" class="pagos-grid"></div>
  </div>
  <div id="rechazados-tab" class="tab-content is-hidden">
    <div id="rechazados-list" class="pagos-grid"></div>
  </div>
</main>

<!-- Modal de rechazo -->
<div id="rechazo-modal" class="modal-rechazo is-hidden" role="dialog" aria-modal="true" aria-label="Rechazar pago">
  <div class="modal-panel">
    <h3 class="modal-title">Rechazar pago</h3>
    <p class="modal-note">Motivo del rechazo:</p>
    <textarea
      id="motivo-rechazo"
      class="motivo-rechazo"
      placeholder="Ej: Comprobante ilegible, Monto incorrecto..."
      rows="3"
      maxlength="200"
      data-validation-rules="sinCaracteresEspeciales"
      title="Sin caracteres especiales"
    ></textarea>
    <div class="rechazo-actions">
      <button id="cancelar-rechazo" class="ui-btn ui-btn--ghost">Cancelar</button>
      <button id="confirmar-rechazo" class="ui-btn ui-btn--primary">Confirmar rechazo</button>
    </div>
  </div>
</div>

<!-- Modal de Reportes -->
<div id="modal-reportes-pagos" class="ui-modal" data-modal hidden aria-hidden="true">
  <div class="ui-modal__dialog ui-modal__dialog--lg" role="dialog" aria-modal="true" aria-labelledby="reportes-pagos-title">
    <div class="ui-modal__header">
      <h3 id="reportes-pagos-title" class="ui-modal__title">Reporte de Pagos</h3>
      <button class="ui-modal__close" type="button" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body">
      <!-- Filtros -->
      <div class="filters-section">
        <h4 class="filters-title">Filtros avanzados</h4>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Búsqueda</span>
            <input
              type="text"
              id="reporte-busqueda-pagos"
              class="field__input"
              placeholder="Factura, nombre del cliente..."
              data-validation-rules="sinCaracteresEspeciales"
              title="Sin caracteres especiales"
            />
            <small class="field-hint">Buscar por ID de factura o nombre del cliente</small>
          </div>

          <div class="field">
            <span class="field__label">Estado</span>
            <div class="select-wrapper">
              <select id="reporte-estado-pagos" class="field__input">
                <option value="">Todos</option>
                <option value="pendiente">Pendiente</option>
                <option value="aprobado">Aprobado</option>
                <option value="rechazado">Rechazado</option>
              </select>
            </div>
          </div>
        </div>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Método de pago</span>
            <div class="select-wrapper">
              <select id="reporte-metodo-pagos" class="field__input">
                <option value="">Todos</option>
                <option value="pago_movil">Pago Móvil</option>
                <option value="zelle">Zelle</option>
                <option value="binance">Binance</option>
                <option value="efectivo_usd">Efectivo USD</option>
                <option value="efectivo_bs">Efectivo Bs</option>
              </select>
            </div>
          </div>

          <div class="field">
            <span class="field__label">Moneda</span>
            <div class="select-wrapper">
              <select id="reporte-moneda-pagos" class="field__input">
                <option value="">Todas</option>
                <option value="USD">USD</option>
                <option value="VES">VES</option>
                <option value="USDT">USDT</option>
              </select>
            </div>
          </div>
        </div>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Fecha desde</span>
            <input type="date" id="reporte-fecha-desde-pagos" class="field__input" />
          </div>

          <div class="field">
            <span class="field__label">Fecha hasta</span>
            <input type="date" id="reporte-fecha-hasta-pagos" class="field__input" />
          </div>
        </div>

        <div class="filters-row">
          <div class="field">
            <span class="field__label">Monto mínimo</span>
            <input type="number" id="reporte-monto-min-pagos" step="0.01" min="0" class="field__input" placeholder="0.00" />
          </div>

          <div class="field">
            <span class="field__label">Monto máximo</span>
            <input type="number" id="reporte-monto-max-pagos" step="0.01" min="0" class="field__input" placeholder="0.00" />
          </div>
        </div>
      </div>

      <!-- Botones de acción -->
      <div class="filters-actions">
        <button id="btn-generar-reporte-pagos" class="ui-btn ui-btn--primary">Generar reporte</button>
        <button id="btn-limpiar-filtros-pagos" class="ui-btn ui-btn--ghost">Limpiar filtros</button>
      </div>

      <!-- Resumen estadístico -->
      <div id="reporte-resumen-pagos" class="reporte-resumen is-hidden">
        <h4 class="filters-title">Resumen</h4>
        <div class="stats-summary">
          <div class="stat-summary stat-summary--total">
            <span class="stat-summary__label">Total transacciones</span>
            <span id="reporte-total-pagos" class="stat-summary__value">0</span>
          </div>
          <div class="stat-summary stat-summary--monto">
            <span class="stat-summary__label">Monto total</span>
            <span id="reporte-total-monto-pagos" class="stat-summary__value">$0</span>
          </div>
          <div class="stat-summary stat-summary--pendiente">
            <span class="stat-summary__label">Pendientes</span>
            <span id="reporte-pendientes-pagos" class="stat-summary__value">0</span>
          </div>
          <div class="stat-summary stat-summary--aprobado">
            <span class="stat-summary__label">Aprobados</span>
            <span id="reporte-aprobados-pagos" class="stat-summary__value">0</span>
          </div>
          <div class="stat-summary stat-summary--rechazado">
            <span class="stat-summary__label">Rechazados</span>
            <span id="reporte-rechazados-pagos" class="stat-summary__value">0</span>
          </div>
        </div>
      </div>

      <!-- Previsualización -->
      <div id="reporte-preview-pagos" class="reporte-preview is-hidden">
        <h4 class="filters-title">Previsualización</h4>
        <div class="table-wrap table-wrap--scroll">
          <table class="table">
            <thead>
              <tr>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Fecha</th>
                <th>Método</th>
                <th>Referencia</th>
                <th>Monto</th>
                <th>Estado</th>
                <th>Prod.</th>
                <th>Acción</th>
              </tr>
            </thead>
            <tbody id="reporte-tabla-pagos">
              <tr>
                <td colspan="9" class="table__empty">Selecciona filtros y genera un reporte</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Botones de exportación -->
      <div class="ui-form__actions">
        <button id="btn-exportar-excel-pagos" class="ui-btn ui-btn--primary" disabled>Exportar Excel</button>
        <button id="btn-exportar-pdf-pagos" class="ui-btn ui-btn--primary" disabled>Exportar PDF</button>
        <button id="btn-imprimir-pagos" class="ui-btn ui-btn--ghost" disabled>Imprimir</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de detalle de venta -->
<div id="modal-detalle-venta" class="ui-modal" data-modal hidden aria-hidden="true">
  <div class="ui-modal__dialog ui-modal__dialog--lg" role="dialog" aria-modal="true" aria-labelledby="detalle-venta-title">
    <div class="ui-modal__header">
      <h3 id="detalle-venta-title" class="ui-modal__title">Detalle de Venta</h3>
      <button class="ui-modal__close" type="button" data-close-modal aria-label="Cerrar">×</button>
    </div>
    <div class="ui-modal__body">
      <div id="detalle-venta-info" class="detail-info"></div>
      <div class="table-wrap table-wrap--scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Marca</th>
              <th>Clase</th>
              <th>Cantidad</th>
              <th>Precio Unitario</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody id="detalle-venta-productos"></tbody>
          <tfoot>
            <tr id="detalle-venta-total">
              <td colspan="5" class="detalle-total-label">Total:</td>
              <td id="detalle-venta-total-amount" class="detalle-total-amount"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
  <script src="{{ url_for('static', filename='js/field-validator.js') }}"></script>
  <script defer src="{{ url_for('static', filename='js/validacion_pagos.js') }}"></script>
{% endblock %}
</file>

<file path="views/bitacora.html">
{% extends 'components/layout/base.html' %}

{% block title %}Ituaccesorio - Bitácora del Sistema{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/bitacora.css') }}">
{% endblock %}

{% block content %}
<main class="page bitacora-page">
  <!-- Breadcrumb unificado -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
      <li aria-current="page">
        <span class="breadcrumb__current">Bitácora del Sistema</span>
      </li>
    </ol>
  </nav>

  <!-- Hero unificado con glassmorphism -->
  <header class="hero" aria-label="Encabezado de bitácora">
    <div class="hero__copy">
      <p class="hero__eyebrow">Registro de actividades</p>
      <h1 class="hero__title">Bitácora del Sistema</h1>
      <p class="hero__description">Registro de actividades y eventos del sistema</p>
    </div>
    <div class="hero__actions">
      <button id="btn-refrescar" class="ui-btn ui-btn--ghost" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
          <polyline points="23 4 23 10 17 10"/>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        Refrescar
      </button>
    </div>
  </header>

  <!-- Contenido principal -->
  <section class="content bitacora-grid" aria-label="Gestión de bitácora">
    <article class="card card--table" aria-label="Listado de eventos">
      <div class="card__header">
        <div class="card__header-left">
          <h2 class="card__title">Eventos Registrados</h2>
          <p class="card__subtitle">Historial de actividades del sistema</p>
        </div>
      </div>

      <div class="table-wrap" role="region" aria-label="Tabla de eventos">
        <table class="table bitacora-table">
          <thead>
            <tr>
              <th class="col-id">ID</th>
              <th class="col-usuario">Usuario</th>
              <th class="col-accion">Acción</th>
              <th class="col-modulo">Módulo</th>
              <th>Descripción</th>
              <th class="col-fecha">Fecha/Hora</th>
            </tr>
          </thead>
          <tbody id="tabla-bitacora">
            {% if registros %}
              {% for registro in registros %}
              <tr class="evento-row" data-id="{{ registro.id }}" data-usuario="{{ registro.usuario_id }}" data-accion="{{ registro.accion }}" data-modulo="{{ (registro.modulo_nombre or 'General')|escape }}" data-descripcion="{{ registro.descripcion|escape }}" data-fecha="{{ registro.fecha_hora }}">
                <td class="col-id"><span class="chip">{{ registro.id }}</span></td>
                <td class="col-usuario">
                  <div class="user-cell">
                    <div class="user-avatar">{{ (registro.usuario_nombre or registro.usuario_id or 'U')[0]|upper }}</div>
                    <span>{{ registro.usuario_nombre or registro.usuario_id }}</span>
                  </div>
                </td>
                <td class="col-accion">
                  <span class="badge badge--{{ registro.accion|lower|replace(' ', '-') }}">{{ registro.accion }}</span>
                </td>
                <td class="col-modulo">
                  <span class="badge badge--default">{{ registro.modulo_nombre or 'General' }}</span>
                </td>
                <td title="{{ registro.descripcion|escape }}">{{ registro.descripcion|truncate(80) }}</td>
                <td class="col-fecha">{{ registro.fecha_hora }}</td>
              </tr>
              {% endfor %}
            {% else %}
              <tr>
                <td colspan="6" class="table__empty">No hay eventos registrados para mostrar.</td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </article>
  </section>

  <!-- Modal Detalle -->
  <div id="modal-detalle" class="ui-modal" data-modal hidden aria-hidden="true">
    <div class="ui-modal__dialog ui-modal__dialog--md" role="dialog" aria-modal="true" aria-labelledby="detalle-title">
      <div class="ui-modal__header">
        <h2 id="detalle-title" class="ui-modal__title">Detalle del evento</h2>
        <button class="ui-modal__close" type="button" data-close-modal aria-label="Cerrar">×</button>
      </div>
      <div class="ui-modal__body">
        <div class="detail-grid" aria-label="Información del evento">
          <div class="detail-item">
            <span class="detail-label">ID del evento</span>
            <span id="d-id" class="detail-value"></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Usuario</span>
            <span id="d-usuario" class="detail-value"></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Acción</span>
            <span id="d-accion" class="detail-value"></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Módulo</span>
            <span id="d-modulo" class="detail-value"></span>
          </div>
          <div class="detail-item detail-item--full">
            <span class="detail-label">Fecha y hora</span>
            <span id="d-fecha" class="detail-value"></span>
          </div>
          <div class="detail-item detail-item--full">
            <span class="detail-label">Descripción</span>
            <span id="d-descripcion" class="detail-value"></span>
          </div>
        </div>
        <div class="ui-form__actions">
          <button class="ui-btn ui-btn--ghost" type="button" data-close-modal>Cerrar</button>
        </div>
      </div>
    </div>
  </div>
</main>
{% endblock %}

{% block scripts %}
  <script defer src="{{ url_for('static', filename='js/bitacora.js') }}"></script>
{% endblock %}
</file>

<file path="views/cargos.html">
{% extends 'components/layout/base.html' %}
{% from 'components/ui/modal.html' import modal %}

{% block title %}Ituaccesorio - Cargos{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/cargos.css') }}">
{% endblock %}

{% block content %}
  <main class="page cargos-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
        <li aria-current="page">
          <span class="breadcrumb__current">Cargos</span>
        </li>
      </ol>
    </nav>

    <header class="cargos-hero">
      <div class="cargos-hero__copy">
        <p class="cargos-hero__eyebrow">Gestión de cargos</p>
        <h1 class="cargos-hero__title">Cargos</h1>
        <p class="cargos-hero__description">Vista simple para consultar y registrar cargos.</p>
      </div>

      <div class="stats stats--single" aria-label="Resumen de cargos">
        <article class="stat-card">
          <span class="stat-card__label">Cargos</span>
          <strong class="stat-card__value" data-count="7">0</strong>
          <small class="stat-card__meta">Total de cargos visibles</small>
        </article>
      </div>
    </header>

    <section class="content vista-1 cargos-grid" aria-label="Gestión de cargos">
      <article class="card card--table cargos-table-card" aria-label="Cargos registrados">
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Catálogo de cargos</h2>
            <p class="card__subtitle">Tabla principal de cargos registrados.</p>
          </div>
        </div>

        <div class="table-wrap table-wrap--tall" role="region" aria-label="Tabla de cargos">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="table__actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-cargos"></tbody>
          </table>
        </div>
      </article>

      <article class="card card--form cargo-create-card" aria-label="Registrar nuevo cargo">
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Registrar nuevo cargo</h2>
            <p class="card__subtitle">Completa nombre y descripción para crear un cargo.</p>
          </div>
        </div>

        <form id="form-cargo" class="cargo-form" autocomplete="off">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
            <label class="cargo-form__field">
              <span>Nombre</span>
              <input type="text" 
                    name="nombre_cargo" 
                    placeholder="Ej: Gerente de Ventas" 
                    minlength="3"
                    maxlength="30"
                    required
                    data-validation-rules="soloLetras,capitalizar,noDuplicadoTabla"
                    data-validar-tabla="#tabla-cargos"
                    data-validar-columna="2"
                    title="Solo letras, espacios, acentos y ñ">
              <small class="field-hint" >Solo letras, espacios, acentos y ñ (mínimo 3 caracteres)</small>
            </label>

            <label class="cargo-form__field cargo-form__field--full">
              <span>Descripción</span>
              <textarea name="descripcion_cargo" 
                        rows="4" 
                        placeholder="Ej: Responsable de la gestión de ventas y el desarrollo de estrategias de marketing"
                        minlength="3"
                        maxlength="250"
                        required
                        data-validation-rules="sinSimbolos"
                        title="No se permiten números ni símbolos especiales"></textarea>
              <small class="field-hint" >No se permiten números ni símbolos especiales (mínimo 3 caracteres)</small>
            </label>
          <div class="cargo-form__actions cargo-form__actions--top cargo-form__actions--center">
              <button class="btn-icon-action--success" type="submit">
                  Registrar nuevo cargo
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                      <polyline points="17 21 17 13 7 13 7 21"/>
                      <polyline points="7 3 7 8 15 8"/>
                  </svg>
              </button>
          </div>
        </form>
      </article>
    </section>

    {% call modal('modal-editar-cargo', 'Modificar cargo', 'sm') %}
      <form id="form-editar-cargo" class="ui-form" autocomplete="off">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="id_cargo" id="editar-id-cargo">

        <div class="ui-form__grid ui-form__grid--one">
          <label class="cargo-form__field">
            <span>Nombre</span>
            <input id="editar-nombre-cargo" 
                   type="text" 
                   name="nombre_cargo" 
                   required
                   minlength="3"
                   maxlength="30"
                   data-validation-rules="soloLetras,capitalizar"
                   title="Solo letras, espacios, acentos y ñ">
            <small class="field-hint" >Solo letras, espacios, acentos y ñ (mínimo 3 caracteres)</small>
          </label>
          <label class="cargo-form__field cargo-form__field--full">
            <span>Descripción</span>
            <textarea id="editar-descripcion-cargo" 
                      name="descripcion_cargo" 
                      rows="4" 
                      required
                      minlength="3"
                      maxlength="250"
                      data-validation-rules="sinSimbolos"
                      title="No se permiten números ni símbolos especiales"></textarea>
            <small class="field-hint" >No se permiten números ni símbolos especiales (mínimo 3 caracteres)</small>
          </label>
        </div>

        <div class="ui-form__actions">
          <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
          <button type="submit" class="ui-btn ui-btn--primary">Guardar cambios</button>
        </div>
      </form>
    {% endcall %}

    {% call modal('modal-eliminar-cargo', 'Eliminar cargo', 'sm') %}
      <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
      <p id="texto-confirmar-eliminar-cargo" class="confirm-text">¿Estás seguro de que quieres eliminar este registro?</p>
      <div class="ui-form__actions">
        <button id="btn-confirmar-eliminar-cargo" type="button" class="ui-btn ui-btn--primary">Sí, eliminar</button>
        <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
      </div>
    {% endcall %}
  </main>
{% endblock %}

{% block scripts %}
  <script src="{{ url_for('static', filename='js/cargos.js') }}"></script>
{% endblock %}
</file>

<file path="views/inventario.html">
{% extends 'components/layout/base.html' %}
{% from 'components/ui/modal.html' import modal %}

{% block title %}Ituaccesorio - Inventario{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/inventario.css') }}">
  <script src="{{ url_for('static', filename='js/inventario.js') }}" defer></script>
{% endblock %}

{% block content %}
<main class="page inventario-page">
  <!-- Breadcrumb unificado -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb__list">
      <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
      <li aria-current="page">
        <span class="breadcrumb__current">Inventario</span>
      </li>
    </ol>
  </nav>

  <!-- Hero unificado con glassmorphism -->
  <header class="hero" aria-label="Resumen del inventario">
    <div class="hero__copy">
      <p class="hero__eyebrow">Gestión de inventario</p>
      <h1 class="hero__title">Inventario</h1>
      <p class="hero__description">Vista completa para consultar y gestionar el inventario de productos.</p>

      <div class="hero__chips" aria-label="Filtros rápidos">
        <span class="chip chip--active" role="button" tabindex="0" aria-pressed="true" data-filter="all">Todos</span>
        <span class="chip" role="button" tabindex="0" aria-pressed="false" data-filter="tipo" data-value="Telefono">Teléfonos</span>
        <span class="chip" role="button" tabindex="0" aria-pressed="false" data-filter="tipo" data-value="Pantalla">Pantallas</span>
        <span class="chip" role="button" tabindex="0" aria-pressed="false" data-filter="tipo" data-value="Repuesto">Repuestos</span>
        <span class="chip" role="button" tabindex="0" aria-pressed="false" data-filter="low">Bajo stock</span>
      </div>
    </div>

    <div class="stats stats--grid" aria-label="Indicadores del inventario">
      <article class="stat-card">
        <span class="stat-card__label">Clases</span>
        <strong class="stat-card__value" id="inv-stat-clases">—</strong>
        <small class="stat-card__meta">Tipos de productos</small>
      </article>

      <article class="stat-card">
        <span class="stat-card__label">Marcas</span>
        <strong class="stat-card__value" id="inv-stat-marcas">—</strong>
        <small class="stat-card__meta">Marcas registradas</small>
      </article>

      <article class="stat-card">
        <span class="stat-card__label">Productos</span>
        <strong class="stat-card__value" id="inv-stat-modelos">—</strong>
        <small class="stat-card__meta">Modelos disponibles</small>
      </article>

      <article class="stat-card stat-card--accent">
        <span class="stat-card__label">Piezas en stock</span>
        <strong class="stat-card__value" id="inv-stat-piezas">—</strong>
        <small class="stat-card__meta">Total de unidades</small>
      </article>
    </div>
  </header>

  <!-- Contenido principal -->
  <section class="content inventario-grid" aria-label="Panel de inventario">
    <article class="card card--table" aria-label="Existencias por producto">
      <div class="card__header">
        <div class="card__header-left">
          <p class="card__subtitle">Stock operativo</p>
          <h2 class="card__title">Existencias por producto</h2>
        </div>
        <div class="card__actions">
          <button id="btn-reportes" class="ui-btn ui-btn--ghost" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
              <path d="M21 12v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            Reportes
          </button>
        </div>
      </div>

      <div class="table-wrap" role="region" aria-label="Tabla principal de inventario">
        <table class="table inventory-table">
          <thead>
            <tr>
              <th class="col-image">Imagen</th>
              <th>Clase</th>
              <th>Marca</th>
              <th>Producto</th>
              <th>Existencia</th>
              <th>Costo venta</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody id="inventario-tbody">
            <tr>
              <td colspan="7" class="table__loading">Cargando inventario…</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="table-note" id="inventario-note">La tabla une inventario, producto, marca, clase y atributos.</p>
    </article>
  </section>

  <!-- Modal de Reportes (usando el sistema unificado) -->
  {% call modal('modal-reportes', 'Reporte de inventario', 'lg') %}
    <div class="reportes-content">
      <div class="ui-form__grid ui-form__grid--two">
        <label class="field">
          <span>Búsqueda</span>
          <input type="text" id="reporte-busqueda" placeholder="Nombre, marca o clase..." class="field__input">
        </label>
        
        <label class="field">
          <span>Clase</span>
          <div class="select-wrapper">
            <select id="reporte-clase" class="field__input">
              <option value="">Todas</option>
            </select>
          </div>
        </label>
      </div>
      
      <div class="ui-form__grid ui-form__grid--two ui-form__grid--mt-sm">
        <label class="field">
          <span>Marca</span>
          <div class="select-wrapper">
            <select id="reporte-marca" class="field__input">
              <option value="">Todas</option>
            </select>
          </div>
        </label>
        
        <label class="field">
          <span>Stock mínimo</span>
          <input type="number" id="reporte-stock-min" min="0" placeholder="Ej: 0" class="field__input">
        </label>
      </div>
      
      <div class="ui-form__grid ui-form__grid--two ui-form__grid--mt-sm">
        <label class="field">
          <span>Stock máximo</span>
          <input type="number" id="reporte-stock-max" min="0" placeholder="Ej: 100" class="field__input">
        </label>
      </div>

      <div class="ui-form__actions ui-form__actions--mt-md">
        <button id="btn-generar-reporte" class="ui-btn ui-btn--primary">Generar reporte</button>
        <button id="btn-limpiar-filtros" class="ui-btn ui-btn--ghost">Limpiar filtros</button>
      </div>

      <div id="reporte-preview">
        <div class="reporte-preview__header">
          <strong id="reporte-total">Total de productos: 0</strong>
          <div class="reporte-preview__actions">
            <button id="btn-exportar-excel" class="ui-btn ui-btn--success ui-btn--sm" disabled>Excel</button>
            <button id="btn-exportar-pdf" class="ui-btn ui-btn--danger ui-btn--sm" disabled>PDF</button>
            <button id="btn-imprimir" class="ui-btn ui-btn--ghost ui-btn--sm" disabled>Imprimir</button>
          </div>
        </div>
        <div class="table-wrap table-wrap--scroll">
          <table class="table table--min">
            <thead>
              <tr>
                <th class="col-image">Imagen</th>
                <th>Producto</th>
                <th>Marca</th>
                <th>Clase</th>
                <th>Stock</th>
                <th>Costo</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody id="reporte-tabla"></tbody>
          </table>
        </div>
      </div>
    </div>
  {% endcall %}

</main>
{% endblock %}
</file>

<file path="views/ordenes_compra.html">
{% extends 'components/layout/base.html' %}
{% from 'components/ui/modal.html' import modal %}

