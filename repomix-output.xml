	height: 160px;
	background: linear-gradient(135deg, #f3c50030, #12121210);
	border-radius: 12px;
	margin-bottom: 0.75rem;
}

.producto-nombre {
	font-weight: 900;
	font-size: 1rem;
}

.producto-marca {
	color: var(--text-muted);
	font-size: 0.85rem;
}

.producto-precios {
	margin: 0.75rem 0;
}

.precio-usd {
	font-weight: 900;
	font-size: 1.25rem;
	color: var(--text-strong);
}

.precio-bs {
	font-size: 0.85rem;
	color: var(--text-muted);
}

.producto-stock {
	font-size: 0.8rem;
	color: #22c55e;
}

.btn-agregar {
	width: 100%;
	margin-top: 0.75rem;
}

.mas-vendidos-list {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}

.mas-vendido-item {
	display: flex;
	justify-content: space-between;
	font-size: 0.85rem;
	padding: 0.5rem;
	background: rgba(0, 0, 0, 0.03);
	border-radius: 12px;
}

.tasas-info {
	padding: 0.5rem;
	background: rgba(243, 197, 0, 0.1);
	border-radius: 12px;
	display: grid;
	gap: 0.25rem;
}

.cart-badge {
	position: absolute;
	top: -8px;
	right: -8px;
	background: #f3c500;
	color: #121212;
	border-radius: 999px;
	font-size: 11px;
	font-weight: 900;
	min-width: 18px;
	height: 18px;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0 5px;
}

.cart-icon-btn {
	position: relative;
	display: inline-flex;
	align-items: center;
	gap: 0.45rem;
	min-height: 42px;
	padding: 0.72rem 1rem;
	border-radius: 12px;
	background: rgba(255, 255, 255, 0.08);
	border: 1px solid rgba(255, 255, 255, 0.18);
	cursor: pointer;
	font-size: 0.95rem;
	font-weight: 900;
	color: #ffffff;
}

.cart-modal-panel {
	max-width: 500px;
	width: 90%;
}

.cart-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 1rem;
}

.cart-items {
	max-height: 400px;
	overflow-y: auto;
	display: grid;
	gap: 0.75rem;
}

.cart-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 0.75rem 0;
	border-bottom: 1px solid rgba(0, 0, 0, 0.1);
	gap: 0.75rem;
}

.cart-item-info {
	flex: 1;
}

.cart-item-name {
	font-weight: 700;
	color: var(--text-strong);
}

.cart-item-price {
	font-size: 0.85rem;
	color: rgba(0, 0, 0, 0.6);
}

.cart-item-controls {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	flex-wrap: wrap;
	justify-content: flex-end;
}

.cart-item-qty {
	width: 50px;
	text-align: center;
	font-weight: 900;
	color: var(--text-strong);
}

.cart-total {
	margin-top: 1rem;
	padding-top: 1rem;
	border-top: 2px solid var(--yellow);
	text-align: right;
	display: grid;
	gap: 0.25rem;
}

.sin-resultados,
.carrito-vacio {
	margin: 0;
	padding: 1rem;
	background: var(--bg-card);
	border: 1px dashed var(--border-light);
	border-radius: 14px;
	font-weight: 700;
	color: var(--text-muted);
}

.form-pago,
.resumen-card,
.pago-card,
.modal-rechazo .modal-panel {
	background: rgba(0, 0, 0, 0.03);
	border-radius: 16px;
	padding: 1rem;
	border: 1px solid rgba(0, 0, 0, 0.08);
}

.form-pago {
	margin-top: 1.5rem;
	display: grid;
	gap: 0.9rem;
}

.pago-info {
	padding: 0.5rem;
	background: rgba(243, 197, 0, 0.1);
	border-radius: 8px;
	font-size: 0.85rem;
	color: var(--text-strong);
}

.pagos-container {
	width: min(860px, 100%);
	margin: 0 auto;
}

.pagos-container > .card {
	display: grid;
	gap: 1rem;
}

.metodo-select {
	max-width: 100%;
}

.resumen-carrito {
	display: grid;
}

.resumen-card {
	display: grid;
	gap: 0.75rem;
	background: rgba(17, 24, 39, 0.03);
}

.resumen-card h3,
.modal-panel h3 {
	margin: 0;
	font-family: "Space Grotesk", sans-serif;
	font-weight: 900;
}

.resumen-card ul {
	margin: 0;
	padding-left: 1.15rem;
	display: grid;
	gap: 0.35rem;
	color: var(--text-muted);
	font-weight: 700;
}

.resumen-total {
	font-weight: 900;
	color: var(--text-strong);
}

.tabs {
	display: flex;
	gap: 0.5rem;
	margin-bottom: 1rem;
	padding-bottom: 0.5rem;
	border-bottom: 1px solid var(--border-light);
	flex-wrap: wrap;
}

.tab-btn {
	padding: 0.72rem 1rem;
	background: var(--card);
	border: 1px solid var(--border-light);
	border-radius: 12px;
	cursor: pointer;
	font-weight: 900;
	color: var(--text-strong);
}

.tab-btn.active {
	background: linear-gradient(180deg, var(--yellow), #f1bb00);
	color: #121212;
	border-color: transparent;
}

.tab-content {
	display: grid;
	gap: 0.75rem;
}

.pago-card {
	display: grid;
	gap: 0.45rem;
	margin-bottom: 1rem;
	background: var(--card);
	color: var(--text-strong);
}

.info-row {
	display: flex;
	justify-content: space-between;
	gap: 1rem;
    background: var(--chip-bg);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-light);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    border-radius: 14px;
    color: var(--text-strong);
	color: var(--text-strong);
}

.info-row strong,
.info-row span {
	color: #111111;
}

.pago-actions {
	display: flex;
	gap: 0.5rem;
	margin-top: 0.75rem;
	flex-wrap: wrap;
}

.modal-rechazo {
	position: fixed;
	inset: 0;
	background: rgba(0, 0, 0, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 100;
	padding: 1rem;
}

.modal-rechazo.is-hidden {
	display: none;
}

.modal-rechazo .modal-panel {
	width: min(420px, 100%);
	background: rgba(255,255,255,0.6);
	-webkit-backdrop-filter: blur(10px);
	backdrop-filter: blur(10px);
	border-radius: 20px;
	border: 1px solid rgba(255,255,255,0.14);
}

.venta-local-panel {
	max-width: 600px;
	width: min(600px, 100%);
	display: grid;
	gap: 1rem;
}

.motivo-rechazo {
	width: 100%;
	min-height: 96px;
	resize: vertical;
}

.rechazo-actions {
	margin-top: 1rem;
}

.items-local {
	display: grid;
	gap: 0.75rem;
}

@media (max-width: 1100px) {
	.products-grid,
	.ventas-grid {
		grid-template-columns: 1fr;
	}

	.table {
		min-width: 860px;
	}

	.filters-panel {
		position: static;
	}
}

@media (max-width: 720px) {
	.products-hero {
		flex-direction: column;
		align-items: stretch;
	}

	.products-hero__actions {
		justify-content: flex-start;
	}

	.filters-panel__row {
		grid-template-columns: 1fr;
	}

	.table__header,
	.info-row {
		align-items: flex-start;
		flex-direction: column;
	}


.catalogo-page {
	display: grid;
	gap: 1.2rem;
	position: relative;
	padding-bottom: 2.5rem;
}

.catalog-hero {
	position: relative;
	overflow: hidden;
	min-height: 320px;
	padding: clamp(1.5rem, 4vw, 3rem);
	width: 100%;
	margin: 0;
	border-radius: 0;
	background: linear-gradient(135deg, rgba(243, 197, 0, 0.24), rgba(243, 197, 0, 0.04) 34%, rgba(17, 24, 39, 0.12) 100%),
		linear-gradient(135deg, rgba(16, 16, 16, 0.92), rgba(40, 40, 40, 0.96));
	box-shadow: none;
	border: 0;
}

.catalog-hero::before,
.catalog-hero::after {
	content: "";
	position: absolute;
	border-radius: 999px;
	filter: blur(36px);
	opacity: 0.82;
	animation: floatGlow 14s ease-in-out infinite;
	pointer-events: none;
}

.catalog-hero::before {
	width: 38vw;
	height: 38vw;
	background: radial-gradient(circle, rgba(243, 197, 0, 0.58), rgba(243, 197, 0, 0.08));
	top: -16%;
	right: -10%;
}

.catalog-hero::after {
	width: 34vw;
	height: 34vw;
	background: radial-gradient(circle, rgba(88, 28, 135, 0.45), rgba(255, 255, 255, 0.05));
	left: -10%;
	bottom: -18%;
	animation-delay: -7s;
}

.catalog-hero__glow {
	position: absolute;
	border-radius: 999px;
	filter: blur(28px);
	animation: driftGlow 16s ease-in-out infinite;
	pointer-events: none;
}

.catalog-hero__glow--one {
	width: 28rem;
	height: 18rem;
	background: rgba(243, 197, 0, 0.26);
	right: 8%;
	top: 9%;
}

.catalog-hero__glow--two {
	width: 22rem;
	height: 22rem;
	background: rgba(255, 255, 255, 0.08);
	left: 12%;
	bottom: -20%;
	animation-delay: -5s;
}

.catalog-hero__content {
	position: relative;
	z-index: 1;
	width: min(1240px, calc(100% - 2.2rem));
	margin: 0 auto;
	max-width: 1240px;
	display: grid;
	gap: 0.7rem;
	background: rgba(255,255,255,0.08);
	-webkit-backdrop-filter: blur(6px);
	backdrop-filter: blur(6px);
	border: 1px solid rgba(255,255,255,0.12);
	border-radius: 12px;
}

[data-theme="light"] .catalog-hero__content {
	background: rgba(255,255,255,0.55);
}

/* Light theme overrides for glassmorphic components */
[data-theme="light"] .pago-card,
[data-theme="light"] .resumen-card,
[data-theme="light"] .modal-rechazo .modal-panel {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(17,24,39,0.06);
    color: #0b0b0b;
}

/* Dark theme tweaks to keep glass effect readable */
[data-theme="dark"] .pago-card,
[data-theme="dark"] .resumen-card,
[data-theme="dark"] .modal-rechazo .modal-panel {
    background: rgba(2,6,23,0.45);
    border: 1px solid rgba(255,255,255,0.04);
    color: #e6eef8;
}

.catalog-hero__eyebrow {
	margin: 0;
	text-transform: uppercase;
	letter-spacing: 0.18em;
	font-size: 0.77rem;
	font-weight: 900;
	color: rgba(255, 255, 255, 0.72);
}

.catalog-hero__title {
	margin: 0;
	font-family: "Space Grotesk", sans-serif;
	font-size: clamp(2.4rem, 6vw, 4.8rem);
	line-height: 0.92;
	letter-spacing: -0.05em;
	font-weight: 900;
	max-width: 10ch;
}

.catalog-hero__subtitle {
	margin: 0;
	max-width: 58ch;
	font-size: 1.05rem;
	line-height: 1.65;
	color: rgba(255, 255, 255, 0.82);
}

.catalog-hero__actions {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	flex-wrap: wrap;
	margin-top: 0.35rem;
}

.hero-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 42px;
	padding: 0.72rem 1rem;
	border-radius: 12px;
	text-decoration: none;
	background: rgba(255, 255, 255, 0.1);
	border: 1px solid rgba(255, 255, 255, 0.16);
	color: #fff;
	font-weight: 900;
}

.hero-link:hover {
	color: #fff;
}

.cart-icon-btn--hero {
	background: rgba(255, 255, 255, 0.08);
	backdrop-filter: blur(8px);
}

.catalog-categories {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 1rem;
}

.category-card,
.rail-card,
.offer-card {
	position: relative;
	overflow: hidden;
	border-radius: 24px;
	box-shadow: var(--shadow);
	background: #0f1115;
	min-height: 240px;
	border: 1px solid rgba(255, 255, 255, 0.1);
}

.category-card {
	min-height: 270px;
	isolation: isolate;
}

.category-card__image,
.rail-card img,
.offer-card img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.45s ease, filter 0.45s ease;
}

.category-card__overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(180deg, rgba(2, 6, 23, 0.12) 0%, rgba(2, 6, 23, 0.82) 100%);
}

.category-card__body {
	position: relative;
	z-index: 1;
	display: grid;
	align-content: end;
	height: 100%;
	padding: 1.2rem;
	color: #ffffff;
}

.category-card__kicker {
	display: inline-flex;
	align-self: start;
	justify-self: start;
	padding: 0.35rem 0.65rem;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.14);
	backdrop-filter: blur(10px);
	font-size: 0.74rem;
	font-weight: 900;
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

.category-card__title {
	margin: 0.6rem 0 0;
	font-family: "Space Grotesk", sans-serif;
	font-size: 1.65rem;
	font-weight: 900;
	letter-spacing: -0.04em;
}

.category-card:hover .category-card__image,
.rail-card:hover img,
.offer-card:hover img {
	transform: scale(1.04);
	filter: saturate(1.05);
}

.category-card--primary {
	grid-column: span 1;
}

.showcase-section {
	display: grid;
	gap: 0.85rem;
	padding: 0.2rem 0 0;
}

.showcase-section__header {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 1rem;
	flex-wrap: wrap;
}

.section-title {
	display: inline-flex;
	align-items: center;
	gap: 0.6rem;
	margin: 0;
	font-family: "Space Grotesk", sans-serif;
	font-weight: 900;
	font-size: clamp(1.3rem, 2vw, 1.8rem);
	letter-spacing: -0.04em;
	color: #ffffff;
}

.section-title__icon {
	width: 1.15rem;
	height: 1.15rem;
	color: #ff6a00;
	filter: drop-shadow(0 0 12px rgba(255, 106, 0, 0.4));
}

.section-subtitle {
	margin: 0;
	color: rgba(255, 255, 255, 0.72);
	font-weight: 600;
}

.rail-card-row,
.offers-grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 1rem;
}

.rail-card {
	min-height: 190px;
	padding: 1rem;
	background: #111317;
}

.rail-card img {
	border-radius: 18px;
	padding: 0.9rem;
	object-fit: contain;
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(241, 245, 249, 0.92));
}

.rail-card h3,
.offer-card h3 {
	position: relative;
	z-index: 1;
	margin: 0.85rem 0 0;
	font-family: "Space Grotesk", sans-serif;
	font-size: 1rem;
	font-weight: 800;
	color: #ffffff;
}

.offer-card {
	min-height: 240px;
	background: #121418;
	display: grid;
	align-content: end;
	padding: 1rem;
}

.offer-card img {
	padding: 1rem;
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(241, 245, 249, 0.9));
	border-radius: 24px;
}

.offer-card--feature {
	background: linear-gradient(135deg, rgba(17, 24, 39, 0.98), rgba(41, 37, 36, 0.96));
	padding: 1.2rem;
}

.offer-card--feature h3 {
	font-size: 1.45rem;
	margin-top: 0.85rem;
}

.offer-card--feature p {
	position: relative;
	z-index: 1;
	margin: 0.55rem 0 0;
	color: rgba(255, 255, 255, 0.76);
	line-height: 1.55;
}

.offer-card__tag {
	display: inline-flex;
	align-self: start;
	justify-self: start;
	padding: 0.35rem 0.65rem;
	border-radius: 999px;
	background: linear-gradient(180deg, var(--yellow), var(--yellow-soft));
	color: #111111;
	font-size: 0.74rem;
	font-weight: 900;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}

.catalog-browser {
	display: grid;
	gap: 1rem;
	padding-top: 0.2rem;
}

.catalog-browser__grid {
	grid-template-columns: 330px minmax(0, 1fr);
}

.catalog-browser__header {
	margin-bottom: 0;
	align-items: end;
}

.catalog-browser__subtitle {
	margin: 0.25rem 0 0;
	color: rgba(255, 255, 255, 0.72);
	font-weight: 600;
}

.catalog-browser__count {
	padding: 0.45rem 0.75rem;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.1);
	color: #ffffff;
	font-weight: 900;
}

.catalog-filters,
.catalog-results {
	min-height: 100%;
}

.catalog-results {
	display: grid;
	gap: 1rem;
}

.catalog-status {
	display: none;
	padding: 0.95rem 1rem;
	border-radius: 18px;
	font-weight: 700;
	line-height: 1.5;
	border: 1px solid transparent;
}

.catalog-status.is-visible {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
}

.catalog-status--loading {
	background: rgba(255, 255, 255, 0.08);
	border-color: rgba(255, 255, 255, 0.14);
	color: #ffffff;
}

.catalog-status--error {
	background: rgba(220, 38, 38, 0.12);
	border-color: rgba(248, 113, 113, 0.28);
	color: #fff4f4;
}

.catalog-status__content {
	display: flex;
	align-items: center;
	gap: 0.85rem;
	flex-wrap: wrap;
}

.catalog-spinner {
	width: 1rem;
	height: 1rem;
	border-radius: 999px;
	border: 2px solid rgba(255, 255, 255, 0.35);
	border-top-color: #ffffff;
	animation: spin 0.8s linear infinite;
}

.catalog-status__actions {
	display: flex;
	gap: 0.55rem;
	flex-wrap: wrap;
}

.catalog-retry {
	min-height: 38px;
	padding: 0.55rem 0.85rem;
	border-radius: 12px;
	border: 1px solid rgba(255, 255, 255, 0.16);
	background: rgba(255, 255, 255, 0.12);
	color: #ffffff;
	font-weight: 800;
	cursor: pointer;
}

.catalog-loading-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
	gap: 1rem;
}

.producto-card--skeleton {
	position: relative;
	overflow: hidden;
	min-height: 320px;
	background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.04));
	border: 1px solid rgba(255, 255, 255, 0.08);
	border-radius: 18px;
	padding: 1rem;
}

.producto-card--skeleton::before {
	content: "";
	position: absolute;
	inset: 0;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), transparent);
	transform: translateX(-100%);
	animation: shimmer 1.4s infinite;
}

.skeleton-block {
	position: relative;
	overflow: hidden;
	border-radius: 12px;
	background: rgba(255, 255, 255, 0.08);
	margin-bottom: 0.75rem;
}

.skeleton-block--image {
	height: 160px;
}

.skeleton-block--line {
	height: 14px;
	width: 78%;
}

.skeleton-block--line.short {
	width: 55%;
}

.catalog-empty,
.catalog-error-box {
