    color: var(--yellow, #f3c500);
}

/* Importante: asegurar que hidden SI oculte el icono (nuestro display:grid lo estaba anulando). */
.feedback-modal__icon[hidden] {
    display: none !important;
}

.feedback-modal__icon svg {
    width: 34px;
    height: 34px;
}

.feedback-modal__icon svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.feedback-modal__content[data-feedback-type="error"] .feedback-modal__icon {
    background: rgba(239, 68, 68, 0.12);
    color: var(--danger, #ef4444);
}

.feedback-modal__message {
    margin: 0;
    color: var(--text-strong);
    font-weight: 700;
    line-height: 1.35;
}

@keyframes feedback-pop {
    0% {
        transform: scale(0.75);
        opacity: 0;
    }
    70% {
        transform: scale(1.12);
        opacity: 1;
    }
    100% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes feedback-draw {
    from {
        stroke-dashoffset: 100;
        opacity: 0.9;
    }
    to {
        stroke-dashoffset: 0;
        opacity: 1;
    }
}

@keyframes feedback-fade {
    0% {
        transform: translateY(6px);
        opacity: 0;
    }
    100% {
        transform: translateY(0);
        opacity: 1;
    }
}

.feedback-modal__icon.is-anim {
    animation: feedback-pop 460ms cubic-bezier(0.2, 0.9, 0.2, 1);
}

.feedback-modal__icon.is-anim svg path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: feedback-draw 520ms ease-out 90ms forwards;
}

.feedback-modal__message.is-anim {
    animation: feedback-fade 220ms ease-out;
}

@media (max-width: 640px) {
    .ui-form__grid {
        grid-template-columns: 1fr;
    }
}

/* ===== Tablas y table-controls embebidos dentro de modales ===== */
.ui-modal .table-controls {
    color: var(--text-strong);
}

.ui-modal .table-controls__search,
.ui-modal .table-controls__size {
    color: var(--text-muted);
}

.ui-modal .table-controls__input,
.ui-modal .table-controls__select {
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    color: var(--input-text);
}

.ui-modal .table-controls__input::placeholder {
    color: var(--input-placeholder);
}

.ui-modal .table-controls__input:focus,
.ui-modal .table-controls__select:focus {
    border-color: rgba(243, 197, 0, 0.8);
    box-shadow: 0 0 0 3px rgba(243, 197, 0, 0.25);
}

.ui-modal .table-controls__select option {
    color: #121212;
}

.ui-modal .table-controls__btn {
    background: var(--yellow);
    border: 1px solid rgba(243, 197, 0, 0.6);
    color: #121212;
    font-weight: 900;
}

.ui-modal .table-controls__btn:hover:not(:disabled) {
    background: var(--yellow-soft);
}

.ui-modal .table-controls__btn:disabled {
    background: rgba(243, 197, 0, 0.35);
    color: rgba(18, 18, 18, 0.55);
}

.ui-modal .table-controls__info {
    color: var(--text-muted);
}

.ui-modal .table th {
    color: var(--text-muted);
    border-bottom: 1px solid rgba(243, 197, 0, 0.2);
}

.ui-modal .table td {
    color: var(--text-strong);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.ui-modal .table__empty,
.ui-modal .helper {
    color: var(--text-muted) !important;
}
</file>

<file path="app/static/css/navbar.css">
/* ============================================
   NAVBAR iOS 18 PREMIUM - UNIFICADO CON THEME.CSS
   ============================================ */

/* ============================================ */
/* BOTONES */
/* ============================================ */
.btn {
    appearance: none;
    border: 0;
    font: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: transform 0.18s ease, filter 0.18s ease;
}

.btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.04);
}

.btn:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
}

.btn--yellow {
    background: linear-gradient(180deg, var(--yellow-soft), var(--yellow));
    color: var(--navbar-black);
    font-weight: 800;
    box-shadow: 0 8px 18px rgba(243, 197, 0, 0.22);
}

.btn--yellow:hover {
    background: linear-gradient(180deg, #ffe07c, #f3c500);
    box-shadow: 0 10px 22px rgba(243, 197, 0, 0.3);
}

.btn--ghost {
    background: var(--glass-bg);
    color: var(--text-strong);
    border: 1px solid var(--glass-border);
}

.btn--ghost:hover {
    background: var(--ghost-hover-bg);
}

/* ============================================ */
/* SIDEBAR (DRAWER) - AHORA USA VARIABLES */
/* ============================================ */
.drawer {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: var(--sidebar-width-collapsed, 72px);
    background: var(--sidebar-bg, #0A0A0A);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 2px 0 32px var(--sidebar-shadow, rgba(0, 0, 0, 0.3));
    border-right: 1px solid var(--sidebar-border, rgba(255, 255, 255, 0.04));
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 30;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.4rem;
    gap: 0.4rem;
    will-change: width;
}

.drawer:hover {
    width: var(--sidebar-width-expanded, 240px);
}

/* ===== DRAWER HEADER ===== */
.drawer__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: 12px;
    background: var(--sidebar-header-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--sidebar-header-border, rgba(255, 255, 255, 0.04));
    flex-shrink: 0;
    margin-bottom: 0.3rem;
    overflow: hidden;
}

.drawer__logo {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.drawer__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 0.3s ease;
}

.drawer__title {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    color: var(--sidebar-text, #FFFFFF);
    font-size: 0.85rem;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: opacity;
}

.drawer:hover .drawer__title {
    opacity: 1;
}

/* ===== DRAWER NAV ===== */
.drawer__nav-wrapper {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

.drawer__nav {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 3px;
    scrollbar-width: thin;
    scrollbar-color: var(--sidebar-scrollbar, rgba(255, 214, 10, 0.2)) transparent;
}

.drawer__nav::-webkit-scrollbar {
    width: 3px;
}

.drawer__nav::-webkit-scrollbar-track {
    background: transparent;
}

.drawer__nav::-webkit-scrollbar-thumb {
    background: var(--sidebar-scrollbar, rgba(255, 214, 10, 0.25));
    border-radius: 999px;
}

/* ===== DRAWER LINKS ===== */
.drawer__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 36px;
    padding: 0.4rem 0.6rem;
    border-radius: 10px;
    color: var(--sidebar-link-color, rgba(255, 255, 255, 0.55));
    text-decoration: none;
    font-family: 'SF Pro Display', 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 500;
    font-size: 0.8rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    position: relative;
    width: 100%;
    overflow: hidden;
}

.drawer__link .drawer__link-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sidebar-icon-color, rgba(255, 255, 255, 0.4));
    transition: color 0.2s ease;
}

.drawer__link .drawer__link-icon svg {
    width: 18px;
    height: 18px;
}

.drawer__link .drawer__link-text {
    opacity: 0;
    transition: opacity 0.35s ease;
    font-size: 0.8rem;
    will-change: opacity;
    white-space: nowrap;
}

.drawer:hover .drawer__link .drawer__link-text {
    opacity: 1;
}

.drawer__link:hover {
    background: var(--sidebar-link-hover, rgba(255, 255, 255, 0.05));
    color: var(--sidebar-link-hover-text, #FFFFFF);
}

.drawer__link:hover .drawer__link-icon {
    color: var(--sidebar-link-hover-text, #FFFFFF);
}

.drawer__link.is-active {
    background: var(--yellow);
    color: var(--navbar-black);
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(255, 214, 10, 0.15);
}

.drawer__link.is-active .drawer__link-icon {
    color: var(--navbar-black);
}

.drawer__link.is-active:hover {
    background: var(--yellow-soft);
}

/* ===== GROUP TOGGLE ===== */
.drawer__group-toggle {
    appearance: none;
    border: 0;
    width: 100%;
    text-align: left;
    justify-content: space-between;
    font: inherit;
    cursor: pointer;
    background: transparent;
}

.drawer__group-toggle .drawer__link-text {
    flex: 1;
}

.drawer__group-toggle::after {
    content: "▾";
    font-size: 0.55rem;
    line-height: 1;
    transition: transform 0.25s ease, opacity 0.35s ease;
    color: var(--sidebar-link-color, rgba(255, 255, 255, 0.2));
    opacity: 0;
    will-change: opacity, transform;
}

.drawer:hover .drawer__group-toggle::after {
    opacity: 1;
}

.drawer__group-toggle[aria-expanded="true"]::after {
    transform: rotate(180deg);
}

.drawer__group-toggle.is-active {
    color: var(--sidebar-link-hover-text, #FFFFFF);
}

/* ===== SUBMENU ===== */
.drawer__submenu {
    display: grid;
    gap: 0.1rem;
    margin-left: 0.4rem;
    padding-left: 0.4rem;
    border-left: 1px solid var(--sidebar-border, rgba(255, 255, 255, 0.04));
    overflow: hidden;
}

.drawer__submenu[hidden] {
    display: none;
}

.drawer__submenu-link {
    display: flex;
    align-items: center;
    min-height: 30px;
    padding: 0.3rem 0.6rem 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-family: 'SF Pro Display', 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    background: transparent;
    color: var(--sidebar-link-color, rgba(255, 255, 255, 0.35));
    border-radius: 8px;
    transition: background 0.2s ease, color 0.2s ease;
    border: 0;
    cursor: pointer;
    width: 100%;
    text-align: left;
    overflow: hidden;
    text-decoration: none;
}

.drawer__submenu-link .drawer__link-text {
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: opacity;
    white-space: nowrap;
}

.drawer:hover .drawer__submenu-link .drawer__link-text {
    opacity: 1;
}

.drawer__submenu-link:hover {
    background: var(--sidebar-link-hover, rgba(255, 255, 255, 0.04));
    color: var(--sidebar-link-hover-text, #FFFFFF);
}

.drawer__submenu-link.is-active {
    background: rgba(255, 214, 10, 0.06);
    color: var(--sidebar-link-hover-text, #FFFFFF);
    box-shadow: inset 2px 0 0 var(--yellow);
}

/* ===== DRAWER FOOTER ===== */
.drawer__footer {
    padding-top: 0.4rem;
    border-top: 1px solid var(--sidebar-border, rgba(255, 255, 255, 0.04));
    flex-shrink: 0;
}

.drawer__footer .drawer__logout {
    width: 100%;
    padding: 0.4rem 0.6rem;
    border-radius: 10px;
    background: var(--sidebar-header-bg, rgba(255, 255, 255, 0.03));
    color: var(--sidebar-link-color, rgba(255, 255, 255, 0.35));
    border: 1px solid var(--sidebar-border, rgba(255, 255, 255, 0.03));
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    overflow: hidden;
}

.drawer__footer .drawer__logout .drawer__link-text {
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: opacity;
    white-space: nowrap;
}

.drawer:hover .drawer__footer .drawer__logout .drawer__link-text {
    opacity: 1;
}

.drawer__footer .drawer__logout:hover {
    background: var(--sidebar-link-hover, rgba(255, 255, 255, 0.06));
    color: var(--sidebar-link-hover-text, #FFFFFF);
}

.drawer__footer .drawer__logout .drawer__link-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sidebar-icon-color, rgba(255, 255, 255, 0.4));
}

.drawer__footer .drawer__logout:hover .drawer__link-icon {
    color: var(--sidebar-link-hover-text, #FFFFFF);
}

/* ============================================ */
/* TOPBAR */
/* ============================================ */
.topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    margin-left: var(--sidebar-width-collapsed, 72px);
    background: var(--navbar-topbar-start);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--navbar-white-border);
    transition: margin-left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'SF Pro Display', 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    will-change: margin-left;
}

.drawer:hover ~ .topbar,
.drawer:hover + .topbar {
    margin-left: var(--sidebar-width-expanded, 240px);
}

/* ============================================ */
/* MAIN CONTENT */
/* ============================================ */
main {
    margin-left: var(--sidebar-width-collapsed, 72px);
    transition: margin-left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 100vh;
    background: var(--bg-primary);
    padding: 0;
    margin-top: 0;
    overflow-x: hidden;
    width: auto;
    max-width: calc(100% - var(--sidebar-width-collapsed, 72px));
    will-change: margin-left;
}

.drawer:hover ~ main,
.drawer:hover + main {
    margin-left: var(--sidebar-width-expanded, 240px);
    max-width: calc(100% - var(--sidebar-width-expanded, 240px));
}

/* ============================================ */
/* TOPBAR ELEMENTOS */
/* ============================================ */
.topbar__left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-shrink: 0;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--navbar-white);
}

.brand__logo {
    height: 26px;
    width: auto;
    transition: filter 0.3s ease;
}

/* En modo claro, invertir colores del logo */
[data-theme="light"] .brand__logo {
    filter: invert(1) brightness(0.9);
}

/* En modo oscuro, normal */
[data-theme="dark"] .brand__logo {
    filter: invert(0);
}

/* Logo en el drawer */
[data-theme="light"] .drawer__logo img {
    filter: invert(1) brightness(0.9);
}

[data-theme="dark"] .drawer__logo img {
    filter: invert(0);
}

.topbar__center {
    flex: 1;
    max-width: 400px;
    margin: 0 1rem;
}

.search-spotlight {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 14px;
    background: var(--navbar-white-bg-soft);
    border-radius: 12px;
    border: 1px solid var(--navbar-white-border);
    transition: background 0.2s ease, border-color 0.2s ease;
}

.search-spotlight:focus-within {
    background: var(--navbar-white-bg-soft);
    border-color: var(--yellow);
    box-shadow: 0 0 0 3px rgba(255, 214, 10, 0.05);
}

.search-spotlight__icon {
    width: 15px;
    height: 15px;
    color: var(--navbar-white-muted);
    flex-shrink: 0;
}

.search-spotlight__input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--navbar-white);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
    font-size: 12px;
    outline: none;
}

.search-spotlight__input::placeholder {
    color: var(--navbar-white-muted);
    font-size: 12px;
}

.search-spotlight__shortcut {
    padding: 2px 7px;
    background: var(--navbar-white-bg-soft);
    border-radius: 6px;
    font-size: 9px;
    color: var(--navbar-white-muted);
    font-weight: 600;
    border: 1px solid var(--navbar-white-border);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.topbar__right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
}

.topbar__right-capsule {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.15rem 0.15rem 0.15rem 0.3rem;
    background: var(--navbar-white-bg-soft);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 50px;
    border: 1px solid var(--navbar-white-border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transition: background 0.2s ease, border-color 0.2s ease;
}

.topbar__right-capsule:hover {
    background: var(--navbar-white-bg-soft);
    border-color: var(--navbar-white-border);
}

.icon-btn {
    position: relative;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: transparent;
    color: var(--navbar-white-soft);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
}

.icon-btn:hover {
    background: var(--navbar-white-bg-soft);
    color: var(--navbar-white);
}

.icon-btn:active {
    transform: scale(0.92);
}

.icon-btn svg {
    width: 15px;
    height: 15px;
}

.notifications__badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--red);
    color: #FFFFFF;
    border-radius: 999px;
    font-size: 8px;
    font-weight: 700;
    min-width: 14px;
    height: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
    box-shadow: 0 2px 8px rgba(255, 59, 48, 0.25);
}

.notifications__badge[hidden] {
    display: none;
}

/* ===== Toggle de modo claro/oscuro ===== */
.theme-toggle__icon--sun {
    display: none;
}

.theme-toggle__icon--moon {
    display: block;
}

[data-theme="light"] .theme-toggle__icon--sun {
    display: block;
}

[data-theme="light"] .theme-toggle__icon--moon {
    display: none;
}

/* ============================================ */
/* CARRITO DE COMPRAS - WIDGET */
/* ============================================ */
.cart-widget {
    position: relative;
    display: inline-flex;
    align-items: center;
}

.cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background: var(--yellow);
    color: var(--navbar-black);
    border-radius: 999px;
    font-size: 8px;
    font-weight: 800;
    min-width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
    box-shadow: 0 2px 8px rgba(255, 214, 10, 0.3);
    transition: transform 0.2s ease;
}

.cart-badge[hidden] {
    display: none;
}

.cart-badge:not([hidden]) {
    animation: cartBadgePop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes cartBadgePop {
    0% { transform: scale(0); }
    100% { transform: scale(1); }
}

/* ============================================ */
/* PANEL DEL CARRITO */
/* ============================================ */
.cart-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    min-width: 320px;
    max-width: 380px;
    max-height: 480px;
    padding: 0.5rem;
    border-radius: 16px;
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    z-index: 45;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.cart-panel[hidden] {
    display: none;
}

.cart-panel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25rem 0.25rem 0.5rem 0.25rem;
    border-bottom: 1px solid var(--navbar-white-border);
    flex-shrink: 0;
}

.cart-panel__header strong {
    font-size: 0.85rem;
    color: var(--text-strong);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.cart-panel__header small {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 500;
}

.cart-panel__list {
    flex: 1;
    overflow-y: auto;
    padding: 0.25rem 0;
    min-height: 60px;
    max-height: 280px;
}

.cart-panel__list::-webkit-scrollbar {
    width: 3px;
}

.cart-panel__list::-webkit-scrollbar-track {
    background: transparent;
}

.cart-panel__list::-webkit-scrollbar-thumb {
    background: var(--sidebar-scrollbar, rgba(255, 214, 10, 0.25));
    border-radius: 999px;
}

/* ===== ITEM DEL CARRITO ===== */
.cart-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.3rem;
    border-radius: 10px;
    transition: background 0.2s ease;
}

.cart-item:hover {
    background: var(--navbar-white-bg-soft);
}

.cart-item__image {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--navbar-white-bg-soft);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.cart-item__image svg {
    width: 20px;
    height: 20px;
    color: var(--navbar-white-muted);
}

.cart-item__info {
    flex: 1;
    min-width: 0;
}

.cart-item__name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cart-item__detail {
    font-size: 0.65rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.cart-item__quantity {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
}

.cart-item__quantity button {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid var(--navbar-white-border);
    background: transparent;
    color: var(--text-strong);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 0.7rem;
    transition: background 0.2s ease;
}

.cart-item__quantity button:hover {
    background: var(--navbar-white-bg-soft);
}

.cart-item__quantity span {
    min-width: 16px;
    text-align: center;
    font-weight: 600;
    font-size: 0.7rem;
}

.cart-item__price {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-strong);
    white-space: nowrap;
}

.cart-item__remove {
    width: 22px;
    height: 22px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
}

.cart-item__remove:hover {
    background: rgba(255, 59, 48, 0.1);
    color: var(--red);
}

.cart-item__remove svg {
    width: 12px;
    height: 12px;
}

/* ===== CARRITO VACÍO ===== */
.cart-panel__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0.5rem;
    color: var(--text-muted);
    text-align: center;
}

.cart-panel__empty svg {
    width: 40px;
    height: 40px;
    color: var(--navbar-white-muted);
    margin-bottom: 0.5rem;
}

.cart-panel__empty p {
    font-size: 0.8rem;
    font-weight: 500;
    margin: 0;
}

/* ===== FOOTER DEL CARRITO ===== */
.cart-panel__footer {
    border-top: 1px solid var(--navbar-white-border);
    padding-top: 0.5rem;
    margin-top: 0.25rem;
    flex-shrink: 0;
}

.cart-panel__total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25rem 0.1rem;
    margin-bottom: 0.4rem;
}

.cart-panel__total span {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.cart-panel__total strong {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--yellow);
    font-family: 'Space Grotesk', 'SF Pro Display', sans-serif;
}

.cart-panel__checkout {
    width: 100%;
    padding: 0.5rem 0.8rem;
    border: none;
    border-radius: 10px;
    background: linear-gradient(180deg, var(--yellow-soft), var(--yellow));
    color: var(--navbar-black);
    font-weight: 700;
    font-size: 0.8rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.cart-panel__checkout:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255, 214, 10, 0.2);
}

.cart-panel__checkout:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
}

/* ============================================ */
/* USER MENU */
/* ============================================ */
.user__avatar {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--yellow), var(--yellow-soft));
    box-shadow: 0 2px 8px rgba(255, 214, 10, 0.15);
    color: var(--navbar-black);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 800;
    font-size: 0.6rem;
}

.user__avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.user__avatar-initial {
    line-height: 1;
}

.user__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
}

.user__name {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--navbar-white);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.user__role {
    font-size: 0.5rem;
    color: var(--navbar-white-muted);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.user-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
}

.user-menu summary {
    list-style: none;
}

.user-menu summary::-webkit-details-marker {
    display: none;
}

.user-menu__trigger {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.2rem 0.1rem 0.1rem;
    border-radius: 50px;
    background: transparent;
    color: var(--navbar-white);
    cursor: pointer;
    user-select: none;
    transition: background 0.2s ease;
}

.user-menu__trigger:hover {
    background: var(--navbar-white-bg-soft);
}

.user-menu__chevron {
    width: 12px;
    height: 12px;
    color: var(--navbar-white-muted);
    transition: transform 0.25s ease;
}

.user-menu[open] .user-menu__chevron {
    transform: rotate(180deg);
    color: var(--navbar-white);
}

.user-menu__panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    min-width: 200px;
    padding: 0.5rem;
    border-radius: 16px;
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    z-index: 40;
}

.user-menu__identity {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--navbar-white-border);
}

.user-menu__identity-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--yellow), var(--yellow-soft));
    margin-bottom: 0.3rem;
}

.user-menu__identity-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.user-menu__label {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--navbar-white-muted);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.user-menu__full-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navbar-white);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.user-menu__role-text {
    font-size: 0.7rem;
    color: var(--navbar-white-muted);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.user-menu__logout {
    margin: 0;
    display: grid;
    gap: 0.3rem;
}

.user-menu__action-btn {
    width: 100%;
    border-radius: 10px;
    border: none;
    padding: 0.4rem 0.6rem;
    background: var(--navbar-white-bg-soft);
    color: var(--navbar-white);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
    font-weight: 600;
    font-size: 0.75rem;
    cursor: pointer;
    transition: background 0.2s ease;
}

.user-menu__action-btn:hover {
    background: var(--navbar-white-bg-soft);
}

.user-menu__logout-btn {
    width: 100%;
    border: 0;
    border-radius: 10px;
    padding: 0.5rem 0.6rem;
    background: linear-gradient(180deg, var(--yellow-soft), var(--yellow));
    color: var(--navbar-black);
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.user-menu__logout-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255, 214, 10, 0.15);
}

.user--guest .btn {
    font-size: 0.75rem;
    padding: 0.4rem 0.8rem;
    font-family: 'SF Pro Display', 'Manrope', sans-serif;
}

.backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    z-index: 25;
}

/* ============================================ */
/* RESPONSIVE */
/* ============================================ */
@media (max-width: 992px) {
    .topbar__center {
        max-width: 240px;
        margin: 0 0.6rem;
    }
    
    .search-spotlight__shortcut {
        display: none;
    }
}

@media (max-width: 768px) {
    .drawer {
        width: 0;
        padding: 0;
        overflow: hidden;
        z-index: 35;
        transition: width 0.3s ease, padding 0.3s ease;
    }
    
    .drawer:hover {
        width: 0;
    }
    
    .drawer.is-open {
        width: clamp(260px, 85vw, 300px);
        padding: 0.6rem;
        overflow: visible;
    }
    
    .topbar {
        margin-left: 0;
        transition: margin-left 0.3s ease;
    }
    
    main {
        margin-left: 0;
        width: 100%;
        max-width: 100%;
        transition: margin-left 0.3s ease;
    }
    
    .topbar {
        padding: 0 1rem;
        height: 54px;
    }

    .brand__logo {
        height: 22px;
    }
    
    .topbar__center {
        max-width: 140px;
        margin: 0 0.4rem;
    }
    
    .search-spotlight {
        padding: 4px 10px;
        border-radius: 10px;
    }
    
    .search-spotlight__input {
        font-size: 11px;
    }
    
    .search-spotlight__icon {
        width: 13px;
        height: 13px;
    }
    
    .user__meta {
        display: none;
    }

    .user-menu__trigger {
        padding: 0.1rem;
        border-radius: 50%;
    }

    .user-menu__chevron {
        display: none;
    }
    
    .topbar__right-capsule {
        padding: 0.1rem;
        gap: 0.05rem;
    }
    
    .icon-btn {
        width: 26px;
        height: 26px;
    }
    
    .icon-btn svg {
        width: 13px;
        height: 13px;
    }
    
    .user__avatar {
        width: 22px;
        height: 22px;
        font-size: 0.5rem;
    }

    .cart-panel {
        min-width: 280px;
        max-width: 320px;
        right: -40px;
    }
}

@media (max-width: 480px) {
    .topbar {
        padding: 0 0.6rem;
        height: 48px;
    }
    
    .topbar__center {
        display: none;
    }

    .topbar__right {
        gap: 0.2rem;
    }
    
    .topbar__right-capsule {
        padding: 0.05rem;
        gap: 0.05rem;
    }

    .icon-btn {
        width: 24px;
        height: 24px;
    }
    
    .icon-btn svg {
        width: 12px;
        height: 12px;
    }

    .user__avatar {
        width: 20px;
        height: 20px;
        font-size: 0.45rem;
    }
    
    .drawer.is-open {
        width: 90vw;
        padding: 0.5rem;
    }

    .cart-panel {
        min-width: 260px;
        max-width: 290px;
        right: -60px;
    }
    
    .cart-item__name {
        font-size: 0.7rem;
    }
    
    .cart-item__price {
        font-size: 0.7rem;
    }
}

/* ============================================ */
/* MODO OSCURO - CARRITO */
/* ============================================ */
[data-theme="dark"] .cart-panel {
    background: rgba(30, 31, 36, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

[data-theme="dark"] .cart-panel__header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

[data-theme="dark"] .cart-panel__header small {
    color: rgba(255, 255, 255, 0.5);
}

[data-theme="dark"] .cart-item:hover {
    background: rgba(255, 255, 255, 0.05);
}

[data-theme="dark"] .cart-item__name {
    color: #ffffff;
}

[data-theme="dark"] .cart-item__detail {
    color: rgba(255, 255, 255, 0.5);
}

[data-theme="dark"] .cart-item__quantity button {
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
}

[data-theme="dark"] .cart-item__quantity button:hover {
    background: rgba(255, 255, 255, 0.08);
}

[data-theme="dark"] .cart-item__price {
    color: #ffffff;
}

[data-theme="dark"] .cart-panel__empty {
    color: rgba(255, 255, 255, 0.5);
}

[data-theme="dark"] .cart-panel__footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

[data-theme="dark"] .cart-panel__total span {
    color: rgba(255, 255, 255, 0.5);
}

[data-theme="dark"] .cart-panel__total strong {
    color: var(--yellow);
}

[data-theme="dark"] .cart-badge {
    background: var(--yellow);
    color: #121212;
}

/* ============================================ */
/* MODO CLARO - CARRITO */
/* ============================================ */
[data-theme="light"] .cart-panel {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.06);
}

[data-theme="light"] .cart-panel__header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

[data-theme="light"] .cart-panel__header small {
    color: rgba(26, 26, 30, 0.5);
}

[data-theme="light"] .cart-item:hover {
    background: rgba(0, 0, 0, 0.02);
}

[data-theme="light"] .cart-item__name {
    color: #1A1A1E;
}

[data-theme="light"] .cart-item__detail {
    color: rgba(26, 26, 30, 0.5);
}

[data-theme="light"] .cart-item__quantity button {
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #1A1A1E;
}

[data-theme="light"] .cart-item__quantity button:hover {
    background: rgba(0, 0, 0, 0.04);
}

[data-theme="light"] .cart-item__price {
    color: #1A1A1E;
}

[data-theme="light"] .cart-panel__empty {
    color: rgba(26, 26, 30, 0.5);
}

[data-theme="light"] .cart-panel__footer {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
}

[data-theme="light"] .cart-panel__total span {
    color: rgba(26, 26, 30, 0.5);
}

[data-theme="light"] .cart-panel__total strong {
    color: var(--yellow);
}

[data-theme="light"] .cart-badge {
    background: var(--yellow);
    color: #121212;
}
