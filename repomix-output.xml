    padding: 0.75rem 1.5rem;
    background: transparent;
    border: none;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 40px;
    transition: all 0.2s ease;
}

.tab-btn:hover {
    color: var(--text-strong);
    background: var(--ghost-hover-bg);
}

.tab-btn.is-active {
    background: var(--yellow);
    color: var(--ink);
}

.tab-content.is-hidden {
    display: none;
}

/* ============================================
   CARDS
   ============================================ */
.card--filters {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-2xl);
    padding: 1.5rem;
    color: var(--text-strong);
}

.card--table {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-2xl);
    padding: 1.5rem;
    color: var(--text-strong);
}

.card--table .card__title {
    color: var(--text-strong);
}

.card--table .card__subtitle {
    color: var(--text-muted);
}

/* ============================================
   FILTROS
   ============================================ */
.filters-section {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.filters-title {
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 1rem;
    margin: 0 0 0.75rem;
    color: var(--text-strong);
}

.filters-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
}

.filters-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

/* ============================================
   RESUMEN ESTADÍSTICO
   ============================================ */
.reporte-resumen {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.reporte-resumen.is-hidden {
    display: none;
}

.stats-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
}

.stat-summary {
    background: var(--glass-bg);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-light);
    text-align: center;
}

.stat-summary__label {
    display: block;
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
}

.stat-summary__value {
    display: block;
    font-size: 1.25rem;
    font-weight: 900;
    font-family: var(--font-family-heading);
    color: var(--text-strong);
}

.stat-summary--total .stat-summary__value {
    color: var(--text-strong);
}

.stat-summary--monto .stat-summary__value {
    color: var(--yellow);
}

.stat-summary--pendiente .stat-summary__value {
    color: #f59e0b;
}

.stat-summary--aprobado .stat-summary__value {
    color: #22c55e;
}

.stat-summary--rechazado .stat-summary__value {
    color: #ef4444;
}

/* ============================================
   PREVISUALIZACIÓN
   ============================================ */
.reporte-preview {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.reporte-preview.is-hidden {
    display: none;
}

/* ============================================
   EXPORTAR
   ============================================ */
.reporte-export {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.reporte-export.is-hidden {
    display: none;
}

.export-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    flex-wrap: wrap;
}

/* ============================================
   TABLA
   ============================================ */
.table-wrap--scroll {
    max-height: 500px;
    overflow-y: auto;
}

.table th,
.table td {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--border-light);
    text-align: center;
    vertical-align: middle;
}

.table th {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 900;
    background: var(--table-header);
}

.table td {
    font-weight: 700;
    color: var(--text-strong);
}

.table__empty {
    text-align: center;
    color: var(--text-muted);
    font-weight: 700;
    padding: 2rem;
}

.table__loading {
    text-align: center;
    color: var(--text-muted);
    font-weight: 700;
    padding: 2rem;
}

/* ============================================
   ESTADO DE PAGO (badge)
   ============================================ */
.pago-estado {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-block;
}

.pago-estado.pendiente {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.25);
}

.pago-estado.aprobado {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
}

.pago-estado.rechazado {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
}

/* ============================================
   BOTÓN VER DETALLE
   ============================================ */
.btn-ver-detalle-reporte {
    background: var(--yellow);
    border: none;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--ink);
    transition: all 0.2s ease;
    font-family: var(--font-family-heading);
}

.btn-ver-detalle-reporte:hover {
    background: var(--yellow-soft);
    transform: scale(1.02);
}

/* ============================================
   DETALLE DE VENTA
   ============================================ */
.detail-info {
    background: var(--glass-bg);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border-light);
}

.detail-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
}

.detail-info-item {
    display: flex;
    flex-direction: column;
}

.detail-info-item strong {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 800;
}

.detail-info-item span {
    font-size: 0.9rem;
    color: var(--text-strong);
    font-weight: 600;
}

.detalle-total-label {
    text-align: right;
    font-weight: 700;
    color: var(--text-strong);
}

.detalle-total-amount {
    font-weight: 700;
    color: var(--yellow);
    font-size: 1.1rem;
}

/* ============================================
   ITEMS LOCALES (carrito)
   ============================================ */
.items-local {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem 0;
}

.items-local .cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--glass-bg);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
}

.items-local .cart-item span {
    color: var(--text-strong);
}

.items-local .cart-item .icon-action {
    color: var(--text-muted);
    transition: color 0.2s;
}

.items-local .cart-item .icon-action:hover {
    color: #ef4444;
}

.items-local .cart-total {
    padding: 0.5rem 0.75rem;
    text-align: right;
    font-weight: 700;
    color: var(--text-strong);
    border-top: 2px solid var(--yellow);
    margin-top: 0.25rem;
}

.items-local .sin-resultados {
    padding: 1rem;
    text-align: center;
    color: var(--text-muted);
    background: var(--glass-bg);
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-light);
}

/* ============================================
   CLIENTE BUSCADOR (estilo proveedores)
   ============================================ */
.cliente-busqueda-container {
    position: relative;
}

.cliente-busqueda-input-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid var(--input-border);
    border-radius: var(--radius-md);
    background: var(--input-bg);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.cliente-busqueda-input-wrapper:focus-within {
    border-color: var(--yellow);
    box-shadow: 0 0 0 3px rgba(243, 197, 0, 0.15);
}

.cliente-busqueda-input-wrapper .field__input {
    border: none !important;
    box-shadow: none !important;
    flex: 1;
    background: transparent !important;
    color: var(--text-strong) !important;
}

.cliente-busqueda-input-wrapper .field__input::placeholder {
    color: var(--input-placeholder);
}

.cliente-busqueda-input-wrapper .field__input:focus {
    box-shadow: none !important;
}

.cliente-busqueda-input-wrapper .ui-btn--ghost {
    color: var(--text-muted);
    background: transparent !important;
    border: none !important;
}

.cliente-busqueda-input-wrapper .ui-btn--ghost:hover {
    color: var(--yellow);
    background: transparent !important;
}

.cliente-resultados-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    max-height: 240px;
    overflow-y: auto;
    z-index: 1000;
    box-shadow: var(--shadow-dash);
}

.cliente-resultados-dropdown .resultado-item {
    padding: 10px 14px;
    cursor: pointer;
    border-bottom: 1px solid var(--border-light);
    transition: background 0.15s;
    color: var(--text-strong);
    background: var(--bg-secondary);
}

.cliente-resultados-dropdown .resultado-item:hover {
    background: var(--ghost-hover-bg);
}

.cliente-resultados-dropdown .resultado-item:last-child {
    border-bottom: none;
}

.cliente-resultados-dropdown .resultado-item .nombre {
    font-weight: 600;
    color: var(--text-strong);
}

.cliente-resultados-dropdown .resultado-item .detalle {
    font-size: 0.85em;
    color: var(--text-muted);
}

.cliente-resultados-dropdown .sin-resultados {
    padding: 16px;
    text-align: center;
    color: var(--text-muted);
    background: var(--bg-secondary);
}

.cliente-seleccionado {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding: 8px 14px;
    background: rgba(34, 197, 94, 0.08);
    border-radius: var(--radius-md);
    border-left: 4px solid #22c55e;
}

.cliente-seleccionado #cliente-seleccionado-info {
    color: var(--text-strong);
    font-weight: 500;
}

.cliente-seleccionado .icon-action {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    padding: 4px;
    border-radius: 50%;
    transition: background 0.2s, color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cliente-seleccionado .icon-action:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
}

.cliente-seleccionado .icon-action svg {
    width: 16px;
    height: 16px;
}

.is-hidden {
    display: none !important;
}

/* ============================================
   PRODUCTO AGREGAR ROW
   ============================================ */
.producto-agregar-row {
    display: flex;
    gap: 10px;
    align-items: center;
}

.producto-agregar-row .field {
    margin-bottom: 0;
}

.producto-agregar-row .ui-btn--primary {
    display: flex;
    align-items: center;
    gap: 6px;
}

#cliente-buscar-btn {
    padding: 0 12px;
}

.select-flexible {
    flex: 1;
}

.campo-cantidad {
    width: 100px;
    margin: 0;
}

#cantidad-local {
    text-align: center;
}

/* ============================================
   MODAL - NUEVA VENTA LOCAL
   ============================================ */
#venta-local-modal .ui-modal__dialog {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
}

#venta-local-modal .ui-modal__title {
    color: var(--text-strong);
}

#venta-local-modal .ui-modal__close {
    color: var(--text-muted);
}

#venta-local-modal .ui-modal__close:hover {
    color: var(--text-strong);
    background: var(--ghost-hover-bg);
}

#venta-local-modal .ui-form__grid {
    background: transparent;
}

#venta-local-modal .field__label {
    color: var(--text-muted);
}

#venta-local-modal .field__input {
    background: var(--input-bg);
    color: var(--text-strong);
    border-color: var(--input-border);
}

#venta-local-modal .field__input:focus {
    border-color: var(--yellow);
    box-shadow: 0 0 0 3px rgba(243, 197, 0, 0.15);
}

#venta-local-modal .field__input::placeholder {
    color: var(--input-placeholder);
}

#venta-local-modal .field-hint {
    color: var(--text-muted-soft);
}

#venta-local-modal .select-wrapper select {
    background-color: var(--input-bg);
    color: var(--text-strong);
    border-color: var(--input-border);
}

#venta-local-modal .select-wrapper select option {
    background: var(--bg-secondary);
    color: var(--text-strong);
}

/* ============================================
   MODAL - DETALLE VENTA
   ============================================ */
#modal-detalle-venta .ui-modal__dialog {
    background: var(--bg-secondary);
    border: 1px solid var(--border-light);
}

#modal-detalle-venta .ui-modal__title {
    color: var(--text-strong);
}

#modal-detalle-venta .ui-modal__close {
    color: var(--text-muted);
}

#modal-detalle-venta .ui-modal__close:hover {
    color: var(--text-strong);
    background: var(--ghost-hover-bg);
}

#modal-detalle-venta .detail-info {
    background: var(--glass-bg);
    border-color: var(--border-light);
}

#modal-detalle-venta .detail-info-item strong {
    color: var(--text-muted);
}

#modal-detalle-venta .detail-info-item span {
    color: var(--text-strong);
}

#modal-detalle-venta .table {
    background: transparent;
}

#modal-detalle-venta .table th {
    color: var(--text-muted);
    background: var(--table-header);
}

#modal-detalle-venta .table td {
    color: var(--text-strong);
    border-bottom-color: var(--border-light);
}

#modal-detalle-venta .detalle-total-label {
    color: var(--text-strong);
}

#modal-detalle-venta .detalle-total-amount {
    color: var(--yellow);
}

/* ============================================
   SCROLLBAR PARA DROPDOWN
   ============================================ */
.cliente-resultados-dropdown::-webkit-scrollbar {
    width: 6px;
}

.cliente-resultados-dropdown::-webkit-scrollbar-track {
    background: var(--glass-bg);
    border-radius: 10px;
}

.cliente-resultados-dropdown::-webkit-scrollbar-thumb {
    background: rgba(243, 197, 0, 0.3);
    border-radius: 10px;
}

.cliente-resultados-dropdown::-webkit-scrollbar-thumb:hover {
    background: rgba(243, 197, 0, 0.5);
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 920px) {
    .hero__actions {
        justify-content: flex-start;
        width: 100%;
    }
    
    .hero__actions .ui-btn {
        flex: 1;
        min-width: 120px;
        justify-content: center;
    }
}

@media (max-width: 768px) {
    .page {
        padding: 1rem;
    }
    
    .hero {
        flex-direction: column;
        align-items: stretch;
    }
    
    .filters-row {
        grid-template-columns: 1fr;
    }
    
    .stats-summary {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .table {
        min-width: 700px;
    }
    
    .ui-modal__dialog {
        padding: 1rem;
        width: 95%;
        max-height: 95vh;
    }
    
    .ui-modal__body {
        max-height: calc(95vh - 120px);
        overflow-y: auto;
    }
    
    .tabs {
        overflow-x: auto;
        flex-wrap: nowrap;
        gap: 0.25rem;
    }
    
    .tab-btn {
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
        white-space: nowrap;
    }
    
    .detail-info-grid {
        grid-template-columns: 1fr 1fr;
    }
    
    .producto-agregar-row {
        flex-direction: column;
        align-items: stretch;
    }
    
    .producto-agregar-row .field {
        width: 100% !important;
    }
    
    .cliente-resultados-dropdown {
        max-height: 180px;
    }
}

@media (max-width: 480px) {
    .stats-summary {
        grid-template-columns: 1fr;
    }
    
    .ui-btn {
        font-size: 0.8rem;
        padding: 0.5rem 0.8rem;
    }
    
    .detail-info-grid {
        grid-template-columns: 1fr;
    }
    
    .export-actions {
        flex-direction: column;
        align-items: stretch;
    }
    
    .export-actions .ui-btn {
        width: 100%;
        justify-content: center;
    }
    
    .cliente-resultados-dropdown {
        max-height: 150px;
    }
    
    .cliente-resultados-dropdown .resultado-item {
        padding: 8px 12px;
        font-size: 0.9rem;
    }
}
