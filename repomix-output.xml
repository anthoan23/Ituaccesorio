                                 TALLER_CONFIG.VISTAS.REPARACION, TALLER_CONFIG.VISTAS.ASIGNADAS].includes(targetClass);
        
        document.querySelectorAll('.content').forEach(panel => {
            panel.hidden = !panel.classList.contains(targetClass);
