    background: var(--yellow);
    color: var(--ink);
    font-weight: 900;
    font-size: 1rem;
    box-shadow: 0 8px 24px rgba(243, 197, 0, 0.2);
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.tradein-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    filter: brightness(1.03);
    box-shadow: 0 12px 32px rgba(243, 197, 0, 0.3);
}

.tradein-submit:disabled {
    cursor: not-allowed;
    opacity: 0.58;
    box-shadow: none;
    transform: none;
}

