                SELECT 
                    e.ID_inventario,
                    p.Nombre_producto,
                    m.Nombre_marca,
                    c.Nombre_Clase,
                    e.Existencia,
                    e.Costo_venta 
                FROM Existencias_productos e
                JOIN Producto p ON e.ID_producto = p.ID_producto
                JOIN Clase_producto c ON p.ID_Clase = c.ID_Clase
                JOIN Marca_producto m ON p.ID_marca = m.ID_marca
                WHERE e.ID_categoria = 2
