    max-height: 70vh;
    border-radius: 8px;
    object-fit: contain;
}

/* ============================================
   9. FILE INPUT - Oculto
   ============================================ */
#file-input {
    display: none;
}

/* ============================================
   10. RESPONSIVE
   ============================================ */
@media (max-width: 560px) {
    .mobile-shell {
        padding: 1rem 0.75rem 1.5rem;
    }

    .mobile-header__logo {
