<file path="app/static/css/ordenes_servicio.css">
/* ============================================
   ORDENES_SERVICIO.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

/* Grid principal - 1 columna */
.ordenes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   HERO - STATS CON ESTILO ESPECIAL
   ============================================ */
.stats--grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
}

.stat-card--clickable {
    cursor: pointer;
    transition: var(--transition);
    position: relative;
}

.stat-card--clickable:hover {
    transform: translateY(-3px);
    border-color: rgba(243, 197, 0, 0.4);
    box-shadow: 0 8px 24px rgba(243, 197, 0, 0.15);
}

.stat-card--clickable:active {
    transform: scale(0.97);
}

.stat-card--clickable:focus-visible {
    outline: 3px solid rgba(243, 197, 0, 0.5);
    outline-offset: 4px;
}

.stat-card--accent {
    background: linear-gradient(145deg, rgba(243, 197, 0, 0.25), rgba(243, 197, 0, 0.12));
    border-color: rgba(243, 197, 0, 0.3);
}

.stat-card--accent .stat-card__value {
    color: var(--yellow);
}

.stat-card--accent .stat-card__label {
    color: var(--yellow-soft);
}

.stat-card--accent:hover {
    background: linear-gradient(145deg, rgba(243, 197, 0, 0.35), rgba(243, 197, 0, 0.18));
    border-color: rgba(243, 197, 0, 0.5);
}

/* ============================================
   TOOLBAR DE ÓRDENES
   ============================================ */
.ordenes-toolbar {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    align-items: end;
}

.ordenes-toolbar__field {
    margin: 0;
}

.ordenes-toolbar__field input,
.ordenes-toolbar__field .select-wrapper select {
    width: 100%;
}

/* ============================================
   BADGES DE ESTADO - Actualizado
   ============================================ */
.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
}

.badge--pendiente {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
}
.badge--asignada {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.25);
}
.badge--en-proceso {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
}
.badge--reparada {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.25);
}

/* ============================================
   COLUMNAS DE TABLA - TAMAÑOS AJUSTADOS
   ============================================ */
.col-id {
    width: 130px;
    min-width: 110px;
    white-space: nowrap;
}

.col-estado {
    width: 130px;
    min-width: 110px;
    white-space: nowrap;
}

.col-cliente {
    width: 180px;
    min-width: 140px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
}

.col-equipo {
    width: 150px;
    min-width: 120px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 150px;
}

.col-modelo {
    width: 160px;
    min-width: 130px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
}

.col-fecha {
    width: 130px;
    min-width: 110px;
    white-space: nowrap;
}

.col-acciones {
    width: 140px;
    min-width: 120px;
    white-space: nowrap;
}

/* Ajuste para celdas de la tabla */
.table th,
.table td {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--border-light);
    text-align: left;
    vertical-align: middle;
    overflow-wrap: break-word;
    word-break: normal;
}

/* Para el chip de ID - asegurar que no se rompa */
.table .chip {
    white-space: nowrap;
    display: inline-block;
}

/* ============================================
   MODAL SUBTITLE
   ============================================ */
.modal-subtitle {
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
}

/* ============================================
   FIELD HELP (mensajes de estado)
   ============================================ */
.field-help {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    display: block;
    transition: color 0.2s ease;
}

.field-help.is-error {
    color: var(--danger);
}

.field-help.is-success {
    color: var(--green);
}

/* ============================================
   CLASES PARA REEMPLAZAR ESTILOS INLINE
   ============================================ */

/* Contenedor de botones de acción */
.cliente-actions-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: flex-end;
}

.cliente-actions-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.cliente-actions-buttons .ui-btn {
    flex: 1;
    min-width: 120px;
}

.cliente-actions-buttons .ui-btn svg {
    display: inline-block;
    vertical-align: middle;
    margin-right: 4px;
}

/* Status messages */
.field-help--status {
    font-size: 0.7rem;
    color: var(--text-muted);
}

/* Equipo verification */
.equipo-verify-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.equipo-verify-wrapper .ui-btn {
    align-self: flex-start;
}

/* Revision modal */
.revision-header {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
}

.revision-components-header {
