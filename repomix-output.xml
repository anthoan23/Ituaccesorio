   ============================================ */
.tradein-result {
    display: grid;
    gap: 1rem;
}

.tradein-result__price-wrap {
    padding: 1.05rem;
    border-radius: var(--radius-md);
    background: rgba(243, 197, 0, 0.12);
    border: 1px solid rgba(243, 197, 0, 0.2);
    text-align: center;
}

.tradein-result__label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
}

.tradein-result__price {
    display: block;
    color: var(--text-strong);
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1;
}

.tradein-result__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
}

.tradein-result__grid > div,
.tradein-result__section {
    padding: 0.95rem 1rem;
    border-radius: var(--radius-md);
    background: var(--input-bg);
    border: 1px solid var(--border-light);
}

.tradein-result__grid span {
    display: block;
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-bottom: 0.45rem;
    font-weight: 600;
}

.tradein-result__grid strong {
