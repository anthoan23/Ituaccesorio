<file path="app/static/css/validacion_pagos.css">
/* ============================================
   VALIDACION_PAGOS.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

.pagos-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
}

/* ============================================
   HERO - ACCIONES
   ============================================ */
.hero__actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================
   TABS
   ============================================ */
.tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-light);
    padding-bottom: 0.5rem;
}

.tab-btn {
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: none;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 40px;
    transition: all 0.2s ease;
}

.tab-btn:hover {
    color: var(--text-strong);
    background: var(--ghost-hover-bg);
}

.tab-btn.is-active {
    background: var(--yellow);
    color: var(--ink);
}

/* ============================================
   TAB CONTENT
   ============================================ */
.tab-content {
    display: block;
}

.tab-content.is-hidden {
    display: none;
}

/* ============================================
   PAGO CARD
   ============================================ */
.pago-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
    padding: 1.25rem;
    box-shadow: var(--glass-shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.pago-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.pago-card--enter {
    animation: card-in 320ms ease both;
}

.status-updated {
    animation: status-flash 1.2s ease both;
}

.pago-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--border-light);
}

.pago-factura {
    font-family: var(--font-family-heading);
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--text-strong);
}

/* ============================================
   ESTADO DE PAGO (badge)
   ============================================ */
.pago-estado {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-block;
}

.pago-estado.pendiente {
    background: rgba(243, 197, 0, 0.15);
    color: var(--yellow);
    border: 1px solid rgba(243, 197, 0, 0.25);
}

.pago-estado.aprobado {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
}

.pago-estado.rechazado {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
}

/* ============================================
   PAGO MAIN - GRID DE CAPTURE + SUMMARY
   ============================================ */
.pago-main {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1rem;
    align-items: start;
}

.pago-capture {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.capture-image {
    background: var(--input-bg);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    border: 1px solid var(--border-light);
    text-align: center;
}

.capture-image img {
    max-width: 100%;
    max-height: 250px;
    border-radius: 8px;
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: transform 0.2s ease;
}

.capture-image img:hover {
    transform: scale(1.02);
}

.capture-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
