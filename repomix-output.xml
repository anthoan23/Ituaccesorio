          <div class="ui-form__actions">
            <button class="ui-btn ui-btn--primary" type="submit">Guardar rol</button>
            <button class="ui-btn ui-btn--ghost" type="button" data-reset-form="rol">Limpiar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Módulos -->
  <div id="modal-admin-modulos" class="ui-modal" data-modal hidden>
    <div class="ui-modal__dialog ui-modal__dialog--lg" role="dialog" aria-modal="true" aria-labelledby="modal-modulos-title">
      <div class="ui-modal__header">
        <div>
          <p class="modal__eyebrow">Módulos</p>
          <h2 id="modal-modulos-title" class="ui-modal__title">Administrar módulos</h2>
        </div>
        <button class="ui-modal__close" data-close-modal aria-label="Cerrar">×</button>
      </div>

      <div class="ui-modal__body">
        <form id="form-modulo" class="ui-form" autocomplete="off">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="id">
          
          <div class="ui-form__grid ui-form__grid--two">
            <div class="field">
              <span>Nombre <span class="required-indicator">*</span></span>
              <input name="nombre" 
                     type="text" 
                     placeholder="Nombre del módulo" 
                     required 
                     maxlength="50"
                     data-validation-rules="soloLetrasNumeros,sinEspacios"
                     title="Solo letras y números, sin espacios">
              <small class="field-hint">Solo letras y números, sin espacios (máximo 50 caracteres)</small>
            </div>
            
            <div class="field field--full">
              <span>Descripción</span>
              <textarea name="descripcion" 
                        rows="3" 
                        placeholder="Descripción del módulo"
                        maxlength="255"
                        data-validation-rules="sinCaracteresEspeciales"
                        title="Sin caracteres especiales"></textarea>
              <small class="field-hint">Sin caracteres especiales (máximo 255 caracteres)</small>
            </div>
          </div>
          
          <div class="ui-form__actions">
            <button class="ui-btn ui-btn--primary" type="submit">Guardar módulo</button>
            <button class="ui-btn ui-btn--ghost" type="button" data-reset-form="modulo">Limpiar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal de confirmación -->
  {% call modal('modal-confirmacion', 'Confirmar acción', 'sm') %}
    <p id="confirmacion-mensaje" class="confirm-text">¿Seguro que desea continuar?</p>
    <div class="ui-form__actions">
      <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
      <button id="confirmacion-btn" type="button" class="ui-btn ui-btn--danger">Confirmar</button>
    </div>
  {% endcall %}

  <!-- Toast -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
</main>
{% endblock %}

{% block scripts %}
  <script src="{{ url_for('static', filename='js/field-validator.js') }}"></script>
  <script src="{{ url_for('static', filename='js/usuarios.js') }}"></script>
{% endblock %}
</file>

