function toggleCamposCliente(tipo) {
    const { camposNatural, camposJuridico, clienteCedula, clienteNombre, clienteApellido, clienteRif, clienteRazonSocial } = getDomElements();
    
    if (!camposNatural || !camposJuridico) return;
    
