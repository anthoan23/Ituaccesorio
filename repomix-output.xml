        'script-src-elem': ["'self'", 'https://unpkg.com', 'https://cdn.jsdelivr.net', 'https://www.google.com', 'https://www.gstatic.com', 'https://www.recaptcha.net', "'sha256-cAtOZzBPIbdyvoH7Ew+1JU/GFM/683oB4RKnMSb1Pb4='"],
