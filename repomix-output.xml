            "tendencia": tendencia
        })
        
    except Exception as e:
        print(f"Error en api_incremento_ventas: {e}")
        return jsonify({"success": True, "total_actual": 0, "total_anterior": 0, "porcentaje": 0, "texto": "+0%", "tendencia": "neutral"})
