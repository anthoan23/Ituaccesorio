                WHERE LOWER(TRIM(mp.Estado_pago)) = 'pendiente'
                ORDER BY v.Fecha_venta DESC
            """)
            
            pagos = cursor.fetchall()
            
            for pago in pagos:
                if pago.get("Monto") and isinstance(pago["Monto"], Decimal):
