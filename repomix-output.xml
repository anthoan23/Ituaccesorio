<file path="app/static/css/login_phone.css">
* {
	box-sizing: border-box;
}

html {
	background-color: #1e1e1e;
}

html, body {
	min-height: 100%;
	height: 100%;
}

body {
	margin: 0;
	font-family: "Manrope", sans-serif;
	color: #ffffff;
	background: url("../img/FONDO.jpg") 80% 25% / 120% no-repeat fixed;
	position: relative;
	overflow: hidden;
}

body::before {
	content: "";
	position: fixed;
	inset: 0;
	background:
		radial-gradient(circle at 80% 40%, rgba(243, 197, 0, 0.18) 0%, transparent 52%),
		linear-gradient(120deg, rgba(10, 10, 10, 0.72), rgba(10, 10, 10, 0.48));
	pointer-events: none;
}

.login-phone {
	min-height: 100svh;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: clamp(1rem, 4vw, 4rem);
	padding: clamp(0.75rem, 2.5vw, 1.5rem);
	position: relative;
	z-index: 0;
	overflow: hidden;
}

.login-phone__layout {
	width: min(520px, 46vw);
	display: flex;
	align-items: center;
	justify-content: flex-end;
	max-height: calc(100svh - (clamp(0.75rem, 2.5vw, 1.5rem) * 2));
	overflow: visible;
	margin: 250px 100px 10px 10px;
}

.login-phone__info {
	width: min(720px, 54vw);
	display: flex;
	align-items: center;
	justify-content: center;
	align-self: stretch;
	max-height: calc(100svh - (clamp(0.75rem, 2.5vw, 1.5rem) * 2));
	overflow: hidden;
}

.login-phone__info img {
	width: min(560px, 100%);
	height: auto;
	display: block;
	margin: 0;
	filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.6));
}

.phone {
	width: 100%;
	display: flex;
	justify-content: flex-end;
	padding-right: clamp(0rem, 2.5vw, 1.75rem);
	overflow: visible;
}

.phone__device {
	height: min(calc(100svh - (clamp(0.75rem, 2.5vw, 1.5rem) * 2)), 840px);
	width: auto;
	margin: 0;
	max-width: 96vw;
	aspect-ratio: 100 / 200;
	border-radius: 52px;
	padding: 8px;
	background: linear-gradient(180deg, #0b0b0b, #171717 35%, #050505);
	border: 1px solid rgba(255, 255, 255, 0.10);
	box-shadow:
		0 28px 80px rgba(0, 0, 0, 0.65),
		inset 0 0 0 1px rgba(255, 255, 255, 0.07),
		inset 0 0 0 7px rgba(0, 0, 0, 0.86);
	position: relative;
	overflow: hidden;
	transition: box-shadow 200ms ease, border-color 200ms ease;
}

.phone__device:focus-within {
	border-color: color-mix(in srgb, var(--yellow) 40%, rgba(255, 255, 255, 0.10));
	box-shadow:
		0 28px 80px rgba(0, 0, 0, 0.65),
		0 0 0 2px color-mix(in srgb, var(--yellow) 22%, transparent),
		0 0 46px color-mix(in srgb, var(--yellow) 20%, transparent),
		inset 0 0 0 1px rgba(255, 255, 255, 0.07),
		inset 0 0 0 7px rgba(0, 0, 0, 0.86);
}

.phone__device::before {
	content: "";
	position: absolute;
	inset: 0;
	border-radius: 52px;
	background:
		linear-gradient(115deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.06) 22%, transparent 45%),
		radial-gradient(circle at 88% 12%, rgba(255, 255, 255, 0.10), transparent 55%),
		radial-gradient(circle at 18% 80%, rgba(255, 255, 255, 0.06), transparent 52%);
	opacity: 0.55;
	pointer-events: none;
	z-index: 0;
}

.phone__device::after {
	content: "";
	position: absolute;
	inset: 8px;
	border-radius: 52px;
	border: 1px solid rgba(255, 255, 255, 0.10);
	pointer-events: none;
	z-index: 4;
	transition: border-color 200ms ease, box-shadow 200ms ease;
}

.phone__device:focus-within::after {
	border-color: color-mix(in srgb, var(--yellow) 45%, rgba(255, 255, 255, 0.10));
	box-shadow: 0 0 26px color-mix(in srgb, var(--yellow) 18%, transparent);
}

.phone__notch {
	position: absolute;
	top: 20px;
	left: 50%;
	transform: translateX(-50%);
	width: 80px;
	height: 20px;
	background: rgba(0, 0, 0, 0.86);
	border-radius: 20px;
	z-index: 6;
	display: grid;
	place-items: center;
	box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
	transition: box-shadow 200ms ease;
}

.phone__notch-camera {
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: radial-gradient(circle at 30% 30%, rgba(120, 196, 255, 0.85), rgba(20, 20, 20, 0.95));
	border: 1px solid rgba(255, 255, 255, 0.14);
	transform: translateX(30px);
	transition: box-shadow 200ms ease, background 200ms ease;
}

.phone__device:focus-within .phone__notch-camera {
	background: radial-gradient(circle at 100% 100%, rgba(255, 255, 255, 0.98), rgba(230, 230, 230, 0.92));
	box-shadow:
		0 0 15px 15px rgba(255, 255, 255, 0.55),
		0 0 16px rgba(255, 255, 255, 0.55);
}

.phone__screen {
	height: 100%;
	border-radius: 42px;
	padding:
		clamp(3rem, 7vh, 3.5rem)
		clamp(1rem, 2.5vw, 1.3rem)
		clamp(0.8rem, 2vh, 1rem);
	background: linear-gradient(180deg, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.86));
	border: 1px solid rgba(255, 255, 255, 0.12);
	backdrop-filter: blur(10px);
	-webkit-backdrop-filter: blur(10px);
	position: relative;
	display: flex;
	flex-direction: column;
	overflow-y: auto;
	overflow-x: hidden;
	z-index: 2;
}

.phone__screen::-webkit-scrollbar {
	width: 0;
	background: transparent;
}

.phone__content {
	width: 100%;
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
	flex: 1;
}

.phone__bottom {
	grid-row: 3;
	align-self: end;
	justify-self: center;
	padding-bottom: 0.25rem;
	margin-top: 0rem;
}

.phone__screen::before {
	content: "";
	position: absolute;
	inset: 0;
	background:
		url("../img/FONDO.jpg") 89% 80% / cover no-repeat fixed;
	filter: saturate(0.85) contrast(1.12) brightness(0.62);
	transform: scale(1.26);
	opacity: 0.60;
	pointer-events: none;
	z-index: 0;
}

.phone__screen::after {
	content: "";
	position: absolute;
	inset: 0;
	background:
		radial-gradient(circle at 38% 34%, rgba(243, 197, 0, 0.40) 0%, rgba(243, 197, 0, 0.16) 34%, transparent 62%),
		linear-gradient(180deg, rgba(243, 197, 0, 0.14), rgba(0, 0, 0, 0.12) 42%, rgba(0, 0, 0, 0.55));
	opacity: 0.95;
	pointer-events: none;
	z-index: 0;
}

.phone__screen > * {
	position: relative;
	z-index: 1;
}

.phone__top {
	width: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.3rem;
}

.phone__logo {
	height: clamp(56px, 9vh, 82px);
	width: auto;
	display: block;
	opacity: 0.98;
	filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.45));
}

.phone__title {
	margin: 0;
	font-family: "Space Grotesk", sans-serif;
	letter-spacing: 0.06em;
	font-weight: 800;
	font-size: clamp(1.3rem, 2.5vh, 1.6rem);
}

.phone__body {
	width: 100%;
	flex: 1;
	overflow: hidden;
	display: grid;
	align-content: start;
}

.phone__form {
	width: min(100%, 280px);
	margin: 0 auto;
	display: flex;
	flex-direction: column;
	gap: 0.7rem;
}

.phone__form::-webkit-scrollbar {
	width: 0;
	height: 0;
}

.phone__captcha-wrapper {
	display: flex;
	justify-content: center;
	margin: 0;
	padding: 0;
}

.phone__captcha {
	transform: scale(0.95);
	transform-origin: center center;
	display: inline-block;
}

.phone__captcha > div {
	transform: scale(0.85);
	transform-origin: center center;
}

@supports (zoom: 1) {
	.phone__captcha > div {
		transform: none;
		zoom: 0.85;
	}
}

.phone__captcha .g-recaptcha {
	transform-origin: center center;
}

.pfield {
	height: clamp(20px, 4vh, 40px);
	border-radius: 5px;
	display: grid;
	grid-template-columns: 34px 1fr;
	align-items: center;
	background: rgba(255, 255, 255, 0.92);
	border: 1px solid rgba(255, 255, 255, 0.28);
	overflow: hidden;
}

.pfield__icon {
	height: 100%;
	display: grid;
	place-items: center;
	color: rgba(0, 0, 0, 0.45);
}

.pfield__icon svg {
	width: 16px;
	height: 16px;
	display: block;
}

.pfield__input {
	width: 100%;
	height: 100%;
	border: 0;
	outline: none;
	background: transparent;
	font: inherit;
	font-size: 0.5rem;
	color: rgba(0, 0, 0, 0.78);
	padding: 0 0.7rem 0 0;
}

.pfield .password-field {
	position: relative;
	display: flex;
	align-items: center;
	width: 100%;
	height: 100%;
}

.pfield .password-field .pfield__input {
	padding-right: 3.2rem;
}

.password-field {
	position: relative;
	display: flex;
	align-items: center;
	width: 100%;
}

.password-field input {
	width: 100%;
	padding-right: 3.2rem;
}

.password-toggle {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
	right: 0.45rem;
	border: 0;
	background: transparent;
	color: rgba(0, 0, 0, 0.55);
	font-size: 0.45rem;
	font-weight: 800;
	padding: 0.2rem 0.35rem;
	cursor: pointer;
}

/* En la vista de login colocamos el ojo en la esquina superior derecha del campo */
.login-phone .password-field .password-toggle {
	top: 6px;
	right: 8px;
}

.password-toggle:focus-visible {
	outline: 2px solid rgba(243, 197, 0, 0.45);
	outline-offset: 2px;
	border-radius: 6px;
}

.pfield__input::placeholder {
	color: rgba(0, 0, 0, 0.38);
}

/* Override field-validator visuals ONLY for the login page
	 This removes green/red borders and messages on login inputs without
	 affecting other pages that rely on validation UI. */
.login-phone .field-error,
.login-phone .pfield.field-error,
.login-phone .pfield__input.field-error,
.login-phone .password-field.field-error {
	border-color: rgba(255,255,255,0.28) !important;
	box-shadow: none !important;
}

.login-phone .field-success,
.login-phone .pfield.field-success,
.login-phone .pfield__input.field-success,
.login-phone .password-field.field-success {
	border-color: rgba(255,255,255,0.28) !important;
	box-shadow: none !important;
}

.login-phone .field-message,
.login-phone .required-indicator {
	display: none !important;
}

.pfield:focus-within {
	border-color: rgba(243, 197, 0, 0.8);
	box-shadow: 0 0 0 4px rgba(243, 197, 0, 0.16);
}

.phone__button {
	height: clamp(25px, 4.5vh, 44px);
	border: 0;
	border-radius: 8px;
	background: linear-gradient(135deg, var(--yellow), var(--yellow-soft));
	color: #ffffff;
	font: inherit;
	font-weight: 900;
	font-size: clamp(0.5rem, 1.7vh, 0.86rem);
	letter-spacing: 0.06em;
	cursor: pointer;
	margin-top: 0;
	box-shadow: 0 14px 28px rgba(243, 197, 0, 0.22);
}

.phone__button:focus-visible {
	outline: 3px solid rgba(243, 197, 0, 0.35);
	outline-offset: 3px;
}

.phone__links {
	margin-top: 0.55rem;
	display: flex;
	flex-direction: column;
	gap: 0.15rem;
	align-items: center;
}

.phone__link {
	color: rgba(255, 255, 255, 0.82);
	text-decoration: none;
	font-size: clamp(0.3rem, 1.2vh, 0.86rem);
	border-bottom: 1px solid rgba(255, 255, 255, 0.22);
	padding-bottom: 2px;
}

.phone__link:hover {
	color: rgba(255, 255, 255, 0.95);
	border-bottom-color: rgba(255, 255, 255, 0.35);
}

.phone__link--button {
	background: transparent;
	border-left: 0;
	border-right: 0;
	border-top: 0;
	cursor: pointer;
	font-family: inherit;
}

.registro-copy {
	margin: 0 0 0.85rem;
	color: #4b5563;
	font-size: 0.9rem;
}

.registro-copy--soft {
	margin-top: 0.15rem;
	margin-bottom: 0.2rem;
	font-size: 0.82rem;
	color: #6b7280;
}

@media (max-width: 900px) {
	.login-phone__layout {
		justify-content: center;
	}

	.phone {
		justify-content: center;
		padding-right: 0;
	}

	.login-phone__info {
		display: none;
	}
}

@media (min-width: 901px) {
	.phone__device {
		transform: translateX(34%) scale(1.85);
		transform-origin: 100% 50%;
	}
}

@media (max-height: 740px) {
	.phone__device {
		border-radius: 46px;
		padding: 12px;
	}

	.phone__screen {
		border-radius: 38px;
		padding:
			clamp(2.5rem, 6vh, 3rem)
			clamp(1rem, 2.5vw, 1.3rem)
			clamp(0.5rem, 1.5vh, 0.8rem);
	}
	
	.phone__form {
		gap: 0.5rem;
	}
}

.test-mode-flag {
	display: none;
}

.phone__captcha-wrapper--hidden {
	display: none;
}
</file>

<file path="app/static/css/productos.css">
/* ============================================
   PRODUCTOS.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

/* Grid principal - 2 columnas: tabla | filtros */
.productos-grid {
    display: grid;
    /* Igual que en proveedores: single-column por defecto para ocupar 100%.
       Si se necesita sidebar, convertir la sección a `productos-grid--with-filters`. */
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   HERO - ACCIONES
   ============================================ */
.hero__actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================
   TOOLBAR DE PRODUCTOS
   ============================================ */
.productos-toolbar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    align-items: end;
}

.productos-toolbar__field {
    margin: 0;
}

.productos-toolbar__field input,
.productos-toolbar__field .select-wrapper select {
    width: 100%;
}

/* ============================================
   CARD DE FILTROS
   ============================================ */
.card--filters {
    position: sticky;
    top: 90px;
    align-content: start;
}

.filters-section {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
}

.filters-section .field {
    display: grid;
    gap: 0.35rem;
}

.filters-section .field > span {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.filters__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
}

.filters__actions .ui-btn {
    flex: 1;
    min-width: 80px;
}

/* ============================================
   COLUMNA DE IMAGEN
   ============================================ */
.col-image {
    width: 90px;
}

/* Ajustes específicos para la tabla de productos: ocupar todo el ancho y centrar acciones */
.productos-table-card .table__actions {
    text-align: center;
}
.productos-table-card .row-actions {
    justify-content: center;
}

/* Forzar que la tabla de productos ocupe el ancho disponible
   Anula el `min-width` global definido en theme.css que provoca
   un comportamiento de overflow y deja espacio vacío. */
.productos-table-card .table-wrap {
    width: 100%;
    padding: 0; /* la card aporta el padding general */
}

.productos-table-card .table {
    width: 100%;
    min-width: 0 !important; /* override del min-width global */
    table-layout: fixed; /* mejor reparto de columnas cuando es 100% */
}

.productos-table-card .table th,
.productos-table-card .table td {
    padding-left: 0.85rem; /* mantener espacio interior uniforme */
    padding-right: 0.85rem;
    vertical-align: middle;
}

.productos-table-card .table__actions {
    width: 120px; /* reserva un ancho fijo para la columna de acciones */
}

/* ============================================
   PRODUCT THUMB
   ============================================ */
.product-thumb {
    display: inline-block;
    width: 52px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    background: var(--glass-bg);
}

.product-meta {
    display: grid;
    gap: 0.12rem;
}

.product-name {
    font-weight: 900;
    color: var(--text-strong);
}

.product-sku {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
}

/* ============================================
   ESTADOS DE PRODUCTO (stock)
   ============================================ */
.stock-out {
    color: var(--danger);
    font-weight: 700;
}

.stock-low {
    color: #f59e0b;
    font-weight: 700;
}

.stock-good {
    color: var(--green);
}

/* ============================================
   BADGES
   ============================================ */
.badge-clase {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
}

.badge-marca {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.25);
}

/* ============================================
   INDICADOR DE REQUERIDO
   ============================================ */
.required-indicator {
    color: var(--danger);
    margin-left: 0.15rem;
    font-weight: 900;
}

/* ============================================
   UTILITY - Ocultar
   ============================================ */
.is-hidden {
    display: none !important;
}

/* ============================================
   REPORTES
   ============================================ */
.reportes-content {
    width: 100%;
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 1100px) {
    .productos-grid {
        grid-template-columns: 1fr;
    }
    
    .card--filters {
        position: static;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        align-items: start;
    }
    
    .card--filters .card__header {
        grid-column: 1 / -1;
    }
    
    .filters-section {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }
    
    .filters-section .filters__actions {
        grid-column: 1 / -1;
    }
}

@media (max-width: 920px) {
    .productos-toolbar {
        grid-template-columns: 1fr;
    }
    
    .hero__actions {
        justify-content: flex-start;
        width: 100%;
    }
    
    .hero__actions .ui-btn {
        flex: 1;
        min-width: 120px;
        justify-content: center;
    }
    
    .card--filters {
        grid-template-columns: 1fr;
    }
    
    .filters-section {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 780px) {
    .col-image {
        width: auto;
    }
    
    .table {
        min-width: 600px;
    }
    
    .productos-toolbar {
        grid-template-columns: 1fr;
    }
    
    .filters__actions .ui-btn {
        flex: 1;
        justify-content: center;
    }
}

/* ============================================
   ESTILOS EXTRAIDOS DE INLINE STYLES
   ============================================ */
#p-clase-nueva-wrap {
    margin-top: 0.5rem;
}

#p-marca-nueva-wrap {
    margin-top: 0.5rem;
}

.ui-form__grid--mt-sm {
    margin-top: 0.5rem;
}

.ui-form__actions--start {
    margin-top: 0.5rem;
    justify-content: flex-start;
}

.ui-form__actions--mt-md {
    margin-top: 1rem;
}

.ui-form__actions--mt-lg {
    margin-top: 1.5rem;
}

.field--mt {
    margin-top: 0.5rem;
}

#reporte-preview {
    display: none;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.reporte-preview__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
}

.reporte-preview__actions {
    display: flex;
    gap: 0.5rem;
}

.table-wrap--scroll {
    max-height: 300px;
    overflow-y: auto;
}

.table--min {
    min-width: 500px;
}
</file>

<file path="app/static/css/proveedores.css">
/* ============================================
   PROVEEDORES.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

.proveedores-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   HERO - ACCIONES
   ============================================ */
.hero__actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================
   TOOLBAR DE PROVEEDORES
   ============================================ */
.proveedores-toolbar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    align-items: end;
}

.proveedores-toolbar__field {
    margin: 0;
}

.proveedores-toolbar__field input {
    width: 100%;
}

.proveedores-toolbar__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
}

.proveedores-toolbar__actions .ui-btn {
    white-space: nowrap;
}

/* ============================================
   COLUMNAS DE TABLA
   ============================================ */
.col-id {
    width: 110px;
}

.col-tipo {
    width: 160px;
}

.col-tel {
    width: 160px;
}

.col-cost {
    width: 130px;
    text-align: center;
}

/* ============================================
   MODAL TOOLBAR
   ============================================ */
.modal-toolbar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0.35rem 0 0.8rem;
    flex-wrap: wrap;
}

.modal-toolbar .helper {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
}

/* ============================================
   SECTION TITLE
   ============================================ */
.section-title {
    margin: 1.25rem 0 0.5rem 0;
    font-family: var(--font-family-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-strong);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 0.5rem;
}

/* ============================================
   INPUTS EN TABLA (edición de costos)
   ============================================ */
.table-input {
    width: 100%;
    border: 1px solid var(--input-border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.6rem;
    font: inherit;
    font-weight: 700;
    text-align: center;
    background: var(--input-bg);
    color: var(--input-text);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.table-input:focus {
    outline: none;
    border-color: rgba(243, 197, 0, 0.8);
    box-shadow: 0 0 0 3px rgba(243, 197, 0, 0.25);
}

/* ============================================
   DETALLE GRID (modal ver)
   ============================================ */
.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-bottom: 0.8rem;
}

.detail-item {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
}

.detail-item--full {
    grid-column: 1 / -1;
}

.detail-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--text-muted);
}

.detail-value {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-strong);
    line-height: 1.25;
    overflow-wrap: anywhere;
}

/* ============================================
   REPORTES
   ============================================ */
.reportes-content {
    width: 100%;
}

.reportes-content .field__input {
    width: 100%;
    border: 1px solid var(--input-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.85rem;
    font-size: 0.95rem;
    font-family: var(--font-family-base);
    outline: none;
    background: var(--input-bg);
    color: var(--input-text);
}

.reportes-content .field__input:focus {
    border-color: rgba(243, 197, 0, 0.8);
    box-shadow: 0 0 0 3px rgba(243, 197, 0, 0.25);
}

.reportes-content .select-wrapper select.field__input {
    padding-right: 2.5rem;
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 920px) {
    .proveedores-toolbar {
        grid-template-columns: 1fr;
    }
    
    .proveedores-toolbar__actions {
        justify-content: flex-start;
    }
    
    .hero__actions {
        justify-content: flex-start;
        width: 100%;
    }
    
    .hero__actions .ui-btn {
        flex: 1;
        min-width: 120px;
        justify-content: center;
    }
}

@media (max-width: 780px) {
    .detail-grid {
        grid-template-columns: 1fr;
    }
    
    .col-id,
    .col-tipo,
    .col-tel {
        width: auto;
    }
    
    .table {
        min-width: 600px;
    }
    
    .modal-toolbar {
        flex-direction: column;
        align-items: stretch;
    }
    
    .modal-toolbar .helper {
        text-align: center;
    }
}

@media (max-width: 480px) {
    .proveedores-toolbar__actions {
        flex-direction: column;
        width: 100%;
    }
    
    .proveedores-toolbar__actions .ui-btn {
        width: 100%;
        justify-content: center;
    }
}

/* ============================================
   ESTILOS EXTRAIDOS DE INLINE STYLES
   ============================================ */
#e-id {
    background: var(--input-bg);
    opacity: 0.7;
    cursor: not-allowed;
}

.ui-form__grid--mt-sm {
    margin-top: 0.5rem;
}

.ui-form__actions--mt-md {
    margin-top: 1rem;
}

#reporte-preview {
    display: none;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
}

.reporte-preview__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
}

.reporte-preview__actions {
    display: flex;
    gap: 0.5rem;
}

.table-wrap--scroll {
    max-height: 300px;
    overflow-y: auto;
}

.table--min {
    min-width: 600px;
}
</file>

<file path="app/static/css/tradein.css">
/* ============================================
   TRADEIN.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

.tradein-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(320px, 0.94fr);
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   HERO - ACCIONES Y CHIPS
   ============================================ */
.hero__actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================
   TRADEIN CHIPS (estado)
   ============================================ */
.tradein-chip {
    min-width: 172px;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    background: var(--glass-bg);
    border: 1px solid var(--border-light);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

.tradein-chip--soft {
    background: rgba(243, 197, 0, 0.12);
    border-color: rgba(243, 197, 0, 0.18);
}

.tradein-chip__label {
    display: block;
    color: var(--text-muted);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
}

.tradein-chip strong {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.98rem;
    color: var(--text-strong);
}

/* ============================================
   CARDS - TRADEIN
   ============================================ */
.card--tradein {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    color: var(--text-strong);
}

.card--tradein .card__title {
    color: var(--text-strong);
}

.card--tradein .card__subtitle {
    color: var(--text-muted);
}

/* ============================================
   FORMULARIO TRADEIN
   ============================================ */
.tradein-form {
    display: grid;
    gap: 1rem;
}

.tradein-fieldset {
    padding: 0;
    border: 0;
    margin: 0;
}

.tradein-choice-group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.25rem;
}

.tradein-choice,
.tradein-check {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-md);
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    color: var(--text-strong);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.tradein-choice:hover,
.tradein-check:hover {
    transform: translateY(-1px);
    border-color: rgba(243, 197, 0, 0.68);
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.05);
