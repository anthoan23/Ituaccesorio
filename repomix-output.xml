/* ============================================
   CATALOGO.CSS - Adaptado al tema
   Usa variables de theme.css para modo claro/oscuro
   ============================================ */

@import url("./theme.css");

* {
	box-sizing: border-box;
}

html {
	scroll-behavior: smooth;
	background-color: var(--bg, #171717);
}

body {
	margin: 0;
	min-height: 100vh;
	font-family: var(--font-family-base, "Manrope", sans-serif);
	color: var(--text-strong, #ffffff);
	background: var(--bg-gradient, 
		radial-gradient(circle at 15% 18%, rgba(243, 197, 0, 0.18) 0%, transparent 35%),
		radial-gradient(circle at 75% 12%, rgba(255, 255, 255, 0.06) 0%, transparent 32%),
		linear-gradient(135deg, #161616 0%, #222222 55%, #181818 100%)
	);
}

/* Overlay de fondo - solo en modo oscuro */
body::before {
	content: "";
	position: fixed;
	inset: 0;
	pointer-events: none;
	background:
		radial-gradient(circle at 20% 20%, rgba(243, 197, 0, 0.04) 0, transparent 22%),
		radial-gradient(circle at 70% 80%, rgba(255, 255, 255, 0.03) 0, transparent 24%);
	mix-blend-mode: screen;
	opacity: 0.8;
}

/* En modo claro, el overlay se reduce */
[data-theme="light"] body::before {
	opacity: 0.2;
	background:
		radial-gradient(circle at 20% 20%, rgba(243, 197, 0, 0.02) 0, transparent 22%),
		radial-gradient(circle at 70% 80%, rgba(18, 18, 18, 0.01) 0, transparent 24%);
}

.page.catalogo-page {
	width: 100%;
	max-width: none;
	margin: 0;
	padding: 0 0 2.5rem;
	overflow-x: clip;
}

/* ============================================
   HERO - Adaptado al tema
   ============================================ */
.catalog-hero {
	position: relative;
	width: 100%;
	min-height: 330px;
	padding: 2.5rem 0 2.35rem;
	overflow: hidden;
	background:
		linear-gradient(120deg, rgba(243, 197, 0, 0.44) 0%, rgba(243, 197, 0, 0.14) 18%, rgba(17, 17, 17, 0.08) 42%, rgba(255, 255, 255, 0.06) 66%, rgba(17, 17, 17, 0.30) 100%),
		linear-gradient(180deg, #0f0f0f 0%, #1c1c1c 100%);
	background-size: 320% 320%, 100% 100%;
	animation: heroGradientFloat 3s ease-in-out infinite;
	border-bottom: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
	box-shadow: inset 0 -1px 0 var(--border-light, rgba(255, 255, 255, 0.04));
}

/* Modo claro - Hero */
[data-theme="light"] .catalog-hero {
	background:
		linear-gradient(120deg, rgba(243, 197, 0, 0.35) 0%, rgba(243, 197, 0, 0.10) 18%, rgba(255, 255, 255, 0.30) 42%, rgba(18, 18, 18, 0.02) 66%, rgba(255, 255, 255, 0.15) 100%),
		linear-gradient(180deg, #e8e8ed 0%, #d5d5dd 100%);
	border-bottom: 1px solid rgba(18, 18, 18, 0.08);
	box-shadow: inset 0 -1px 0 rgba(18, 18, 18, 0.04);
}

.catalog-hero::before,
.catalog-hero::after {
	content: "";
	position: absolute;
	border-radius: 999px;
	filter: blur(40px);
	pointer-events: none;
}

.catalog-hero::before {
	width: 28rem;
	height: 20rem;
	right: -3rem;
	top: 3rem;
	background: radial-gradient(circle, rgba(243, 197, 0, 0.58), rgba(243, 197, 0, 0.08));
	animation: heroDriftRight 3s ease-in-out infinite;
}

[data-theme="light"] .catalog-hero::before {
	background: radial-gradient(circle, rgba(243, 197, 0, 0.30), rgba(243, 197, 0, 0.04));
}

.catalog-hero::after {
	width: 20rem;
	height: 20rem;
	left: -2rem;
	bottom: -8rem;
	background: radial-gradient(circle, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
	animation: heroDriftLeft 3s ease-in-out infinite;
}

[data-theme="light"] .catalog-hero::after {
	background: radial-gradient(circle, rgba(18, 18, 18, 0.04), rgba(18, 18, 18, 0.01));
}

.catalog-hero__glow {
	position: absolute;
	border-radius: 999px;
	filter: blur(32px);
	pointer-events: none;
}

.catalog-hero__glow--one {
	width: 24rem;
	height: 14rem;
	top: 4rem;
	right: 10%;
	background: rgba(243, 197, 0, 0.18);
	animation: glowDriftOne 3s ease-in-out infinite;
}

[data-theme="light"] .catalog-hero__glow--one {
	background: rgba(243, 197, 0, 0.10);
}

.catalog-hero__glow--two {
	width: 20rem;
	height: 20rem;
	left: 8%;
	bottom: -6rem;
	background: rgba(255, 255, 255, 0.05);
	animation: glowDriftTwo 3s ease-in-out infinite;
}

[data-theme="light"] .catalog-hero__glow--two {
	background: rgba(18, 18, 18, 0.03);
}

.catalog-hero__content {
	position: relative;
	z-index: 1;
	width: min(1240px, calc(100% - 2.2rem));
	margin: 0 auto;
	margin-top: 4rem;
	display: grid;
	gap: 0.85rem;
}

.catalog-hero__title {
	margin: 0;
	max-width: 100%;
    text-align: center;
	font-family: var(--font-family-heading, "Space Grotesk", sans-serif);
	font-size: clamp(2.8rem, 4vw, 4.8rem);
	line-height: 0.92;
	letter-spacing: -0.06em;
	font-weight: 900;
	color: var(--text-strong, #ffffff);
	text-wrap: balance;
}

.catalog-hero__subtitle {
	margin: 0;
	max-width: 100%;
    text-align: center;
	font-size: 1.08rem;
	line-height: 1.7;
	font-weight: 600;
	color: var(--text-secondary, rgba(255, 255, 255, 0.82));
}

[data-theme="light"] .catalog-hero__subtitle {
	color: var(--text-secondary, rgba(26, 26, 30, 0.72));
}

.catalog-hero__actions {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	flex-wrap: wrap;
	margin-top: 0.25rem;
}

.hero-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 44px;
	padding: 0.72rem 1rem;
	border-radius: 12px;
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.16));
	background: var(--glass-bg, rgba(255, 255, 255, 0.08));
	backdrop-filter: blur(10px);
	color: var(--text-strong, #ffffff);
	text-decoration: none;
	font-weight: 900;
	transition: transform 0.18s ease, background 0.18s ease;
}

[data-theme="light"] .hero-link {
	color: var(--text-strong, #1a1a1e);
	border-color: rgba(18, 18, 18, 0.12);
	background: rgba(255, 255, 255, 0.6);
}

.hero-link:hover {
	transform: translateY(-1px);
	background: var(--ghost-hover-bg, rgba(255, 255, 255, 0.12));
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .hero-link:hover {
	background: rgba(243, 197, 0, 0.12);
	color: var(--text-strong, #1a1a1e);
}

.cart-icon-btn {
	position: relative;
	display: inline-flex;
	align-items: center;
	gap: 0.45rem;
	min-height: 44px;
	padding: 0.72rem 1rem;
	border-radius: 12px;
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.16));
	background: var(--glass-bg, rgba(255, 255, 255, 0.08));
	backdrop-filter: blur(10px);
	color: var(--text-strong, #ffffff);
	font-family: var(--font-family-base, "Manrope", sans-serif);
	font-weight: 900;
	font-size: 0.95rem;
	cursor: pointer;
	transition: transform 0.18s ease, background 0.18s ease;
}

[data-theme="light"] .cart-icon-btn {
	color: var(--text-strong, #1a1a1e);
	border-color: rgba(18, 18, 18, 0.12);
	background: rgba(255, 255, 255, 0.6);
}

.cart-icon-btn:hover {
	transform: translateY(-1px);
	background: var(--ghost-hover-bg, rgba(255, 255, 255, 0.12));
}

[data-theme="light"] .cart-icon-btn:hover {
	background: rgba(243, 197, 0, 0.12);
}

.cart-badge {
	position: absolute;
	top: -8px;
	right: -8px;
	min-width: 18px;
	height: 18px;
	padding: 0 5px;
	border-radius: 999px;
	background: var(--yellow, #f3c500);
	color: var(--ink, #111111);
	font-size: 11px;
	font-weight: 900;
	display: flex;
	align-items: center;
	justify-content: center;
}

/* ============================================
   CONTENIDO PRINCIPAL
   ============================================ */
.catalog-content {
	width: min(1240px, calc(100% - 2.2rem));
	margin: 0 auto;
	display: grid;
	gap: 1.2rem;
	padding-top: 1.25rem;
}

/* ============================================
   CATEGORÍAS - Adaptado al tema
   ============================================ */
.catalog-categories {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 1rem;
}

.category-card,
.rail-card,
.offer-card {
	position: relative;
	overflow: hidden;
	border-radius: 24px;
	background: var(--bg-card, #111317);
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.1));
	box-shadow: var(--shadow, 0 18px 45px rgba(0, 0, 0, 0.35));
}

[data-theme="light"] .category-card,
[data-theme="light"] .rail-card,
[data-theme="light"] .offer-card {
	background: var(--bg-card, #f5f5f8);
	border: 1px solid rgba(18, 18, 18, 0.08);
	box-shadow: 0 8px 28px rgba(18, 18, 18, 0.06);
}

.category-card {
	min-height: 270px;
	isolation: isolate;
}

.category-card__image,
.rail-card img,
.offer-card img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
	transition: transform 0.45s ease, filter 0.45s ease;
}

.category-card__overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(180deg, rgba(3, 7, 18, 0.08) 0%, rgba(3, 7, 18, 0.84) 100%);
}

[data-theme="light"] .category-card__overlay {
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(18, 18, 18, 0.30) 100%);
}

.category-card__body {
	position: relative;
	z-index: 1;
	display: grid;
	align-content: end;
	height: 100%;
	padding: 1.2rem;
	color: var(--text-strong, #ffffff);
}

.category-card__kicker {
	display: inline-flex;
	align-self: start;
	justify-self: start;
	padding: 0.35rem 0.65rem;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.14);
	backdrop-filter: blur(10px);
	font-size: 0.72rem;
	font-weight: 900;
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .category-card__kicker {
	background: rgba(18, 18, 18, 0.08);
	color: var(--text-strong, #1a1a1e);
}

.category-card__title {
	margin: 0.55rem 0 0;
	font-family: var(--font-family-heading, "Space Grotesk", sans-serif);
	font-size: 1.65rem;
	letter-spacing: -0.04em;
	font-weight: 900;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .category-card__title {
	color: var(--text-strong, #1a1a1e);
}

.category-card:hover .category-card__image,
.rail-card:hover img,
.offer-card:hover img {
	transform: scale(1.04);
	filter: saturate(1.04);
}

/* ============================================
   SHOWCASE / OFERTAS
   ============================================ */
.showcase-section {
	display: grid;
	gap: 0.85rem;
}

.showcase-section__header,
.catalog-browser__header {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 1rem;
	flex-wrap: wrap;
}

.section-title,
.card__title {
	margin: 0;
	font-family: var(--font-family-heading, "Space Grotesk", sans-serif);
	font-weight: 900;
	letter-spacing: -0.04em;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .section-title,
[data-theme="light"] .card__title {
	color: var(--text-strong, #1a1a1e);
}

.section-title {
	display: inline-flex;
	align-items: center;
	gap: 0.6rem;
	font-size: clamp(1.3rem, 1.8vw, 1.85rem);
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .section-title {
	color: var(--text-strong, #1a1a1e);
}

.section-title__icon {
	width: 1.1rem;
	height: 1.1rem;
	color: #ff6f00;
	filter: drop-shadow(0 0 12px rgba(255, 111, 0, 0.45));
}

.section-subtitle,
.catalog-browser__subtitle {
	margin: 0.25rem 0 0;
	font-weight: 600;
	color: var(--text-secondary, rgba(255, 255, 255, 0.76));
}

[data-theme="light"] .section-subtitle,
[data-theme="light"] .catalog-browser__subtitle {
	color: var(--text-secondary, rgba(26, 26, 30, 0.6));
}

.catalog-browser .catalog-browser__subtitle {
	color: var(--text-secondary, rgba(255, 255, 255, 0.76));
}

.rail-card-row,
.offers-grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 1rem;
}

.rail-card {
	min-height: 188px;
	padding: 0;
	background: var(--bg-card, #111317);
}

[data-theme="light"] .rail-card {
	background: var(--bg-card, #f5f5f8);
}

.rail-card img {
	padding: 0;
	border-radius: 0;
	object-fit: cover;
	background: none;
}

.rail-card h3,
.offer-card h3 {
	position: relative;
	z-index: 1;
	margin: 0.85rem 0 0;
	font-family: var(--font-family-heading, "Space Grotesk", sans-serif);
	font-size: 1rem;
	font-weight: 800;
	color: var(--text-strong, #ffffff);
    margin-left: 20px;
}

[data-theme="light"] .rail-card h3,
[data-theme="light"] .offer-card h3 {
	color: var(--text-strong, #1a1a1e);
}

.offer-card {
	min-height: 240px;
	background: var(--bg-card, #121418);
	display: grid;
	align-content: end;
	padding: 1rem;
}

[data-theme="light"] .offer-card {
	background: var(--bg-card, #f5f5f8);
}

.offer-card img {
	padding: 1rem;
	border-radius: 22px;
	object-fit: cover;
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(241, 245, 249, 0.92));
}

.offer-card--feature {
	background: linear-gradient(135deg, rgba(17, 24, 39, 0.98), rgba(41, 37, 36, 0.96));
	padding: 1.25rem;
}

[data-theme="light"] .offer-card--feature {
	background: linear-gradient(135deg, #f0f0f5, #e8e8ed);
}

.offer-card--feature h3 {
	font-size: 1.45rem;
	margin-top: 0.85rem;
}

.offer-card--feature p {
	position: relative;
	z-index: 1;
	margin: 0.55rem 0 0;
	color: var(--text-secondary, rgba(255, 255, 255, 0.78));
	line-height: 1.55;
}

[data-theme="light"] .offer-card--feature p {
	color: var(--text-secondary, rgba(26, 26, 30, 0.7));
}

.offer-card__tag {
	display: inline-flex;
	align-self: start;
	justify-self: start;
	padding: 0.35rem 0.65rem;
	border-radius: 999px;
	background: linear-gradient(180deg, var(--yellow, #f3c500), var(--yellow-soft, #f8dd69));
	color: var(--ink, #111111);
	font-size: 0.72rem;
	font-weight: 900;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}

/* ============================================
   CATALOG BROWSER - Adaptado al tema
   ============================================ */
.catalog-browser {
	display: grid;
	gap: 1rem;
	background: var(--glass-bg, rgba(255, 255, 255, 0.96));
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.35));
	border-radius: 26px;
	padding: 1rem;
	box-shadow: var(--shadow, 0 20px 44px rgba(0, 0, 0, 0.22));
}

[data-theme="light"] .catalog-browser {
	background: rgba(255, 255, 255, 0.85);
	border: 1px solid rgba(18, 18, 18, 0.08);
	box-shadow: 0 8px 28px rgba(18, 18, 18, 0.06);
}

.catalog-toolbar {
	display: flex;
	align-items: center;
	gap: 0.7rem;
	flex-wrap: wrap;
	padding: 0.55rem 0.15rem;
}

.catalog-toolbar__search {
	display: flex;
	align-items: center;
	gap: 0.55rem;
	margin-right: auto;
	min-width: 0;
}

.catalog-search-toggle {
	width: 44px;
	height: 44px;
	border: 1px solid var(--input-border, rgba(255, 255, 255, 0.2));
	border-radius: 999px;
	background: var(--chip-bg, rgba(255, 255, 255, 0.08));
	color: var(--chip-text, #ffffff);
	display: grid;
	place-items: center;
	cursor: pointer;
	transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}

[data-theme="light"] .catalog-search-toggle {
	color: var(--chip-text, #1a1a1e);
	border-color: rgba(18, 18, 18, 0.12);
	background: rgba(255, 255, 255, 0.6);
}

.catalog-search-toggle svg {
	width: 1.15rem;
	height: 1.15rem;
}

.catalog-search-toggle:hover {
	transform: translateY(-1px);
	background: rgba(243, 197, 0, 0.14);
	border-color: rgba(243, 197, 0, 0.5);
}

[data-theme="light"] .catalog-search-toggle:hover {
	background: rgba(243, 197, 0, 0.12);
}

.catalog-search-toggle[aria-expanded="true"] {
	background: rgba(243, 197, 0, 0.2);
	border-color: rgba(243, 197, 0, 0.7);
}

.catalog-search-box {
	max-width: 0;
	opacity: 0;
	overflow: hidden;
	transform: translateX(-8px);
	transition: max-width 1s ease, opacity 1s ease, transform 1s ease;
	will-change: max-width, opacity, transform;
}

.catalog-search-box.is-open {
	max-width: 380px;
	opacity: 1;
	transform: translateX(0);
}

.catalog-search-box input {
	width: 380px;
	max-width: calc(100vw - 5.5rem);
	border-radius: 999px;
	background: var(--input-bg, rgba(255, 255, 255, 0.06));
	color: var(--input-text, #ffffff);
	padding-inline: 1rem;
	border-color: var(--input-border, rgba(243, 197, 0, 0.35));
}

[data-theme="light"] .catalog-search-box input {
	background: var(--input-bg, #f5f5f8);
	color: var(--input-text, #1a1a1e);
	border-color: rgba(18, 18, 18, 0.12);
}

.catalog-filter-select {
	display: grid;
	gap: 0.25rem;
	min-width: 170px;
	color: var(--chip-text, #ffffff);
	font-size: 0.72rem;
	font-weight: 900;
	letter-spacing: 0.06em;
	text-transform: uppercase;
}

[data-theme="light"] .catalog-filter-select {
	color: var(--chip-text, #1a1a1e);
}

.catalog-filter-select select {
	min-height: 44px;
	border-radius: 999px;
	padding: 0.6rem 0.95rem;
	font-size: 0.92rem;
	text-transform: none;
	letter-spacing: normal;
	font-weight: 700;
	background: var(--input-bg, rgba(255, 255, 255, 0.06));
	color: var(--input-text, #ffffff);
	border: 1px solid var(--input-border, rgba(243, 197, 0, 0.35));
}

[data-theme="light"] .catalog-filter-select select {
	background: var(--input-bg, #f5f5f8);
	color: var(--input-text, #1a1a1e);
	border-color: rgba(18, 18, 18, 0.12);
}

.catalog-browser__grid {
	display: grid;
	grid-template-columns: minmax(0, 1fr);
	gap: 1rem;
	align-items: start;
}

.catalog-browser__count {
	padding: 0.45rem 0.75rem;
	border-radius: 999px;
	background: var(--chip-bg, rgba(255, 255, 255, 0.08));
	color: var(--chip-text, #ffffff);
	font-weight: 900;
}

[data-theme="light"] .catalog-browser__count {
	background: rgba(18, 18, 18, 0.06);
	color: var(--chip-text, #1a1a1e);
}

.card {
	background: var(--card, rgba(255, 255, 255, 0.05));
	color: var(--text-strong, #ffffff);
	border-radius: var(--radius, 22px);
	box-shadow: var(--shadow, 0 18px 45px rgba(0, 0, 0, 0.35));
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
	padding: 1.2rem 1.25rem;
}

[data-theme="light"] .card {
	background: var(--card, #ffffff);
	color: var(--text-strong, #1a1a1e);
	border: 1px solid rgba(18, 18, 18, 0.08);
	box-shadow: 0 8px 28px rgba(18, 18, 18, 0.06);
}

.catalog-filters,
.catalog-results {
	min-height: 100%;
}

.filters-panel {
	position: sticky;
	top: 90px;
}

.tasas-info--inline {
	display: inline-flex;
	align-items: center;
	gap: 0.45rem;
	padding: 0.55rem 0.85rem;
	border-radius: 999px;
	background: var(--chip-bg, rgba(255, 255, 255, 0.08));
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
	color: var(--chip-text, #ffffff);
	font-size: 0.82rem;
	font-weight: 700;
}

[data-theme="light"] .tasas-info--inline {
	background: rgba(18, 18, 18, 0.04);
	border: 1px solid rgba(18, 18, 18, 0.08);
	color: var(--chip-text, #1a1a1e);
}

.tasas-info--inline small {
	font-size: 0.76rem;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
}

[data-theme="light"] .tasas-info--inline small {
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.filters-panel__section {
	margin-top: 1rem;
	padding-top: 1rem;
	border-top: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
}

[data-theme="light"] .filters-panel__section {
	border-top: 1px solid rgba(18, 18, 18, 0.08);
}

.filters-panel__title {
	margin: 0 0 0.75rem;
	font-family: var(--font-family-heading, "Space Grotesk", sans-serif);
	font-size: 1rem;
	font-weight: 900;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
}

[data-theme="light"] .filters-panel__title {
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.field {
	display: grid;
	gap: 0.35rem;
}

.field__label {
	font-size: 0.78rem;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
	font-weight: 900;
	text-transform: uppercase;
	letter-spacing: 0.06em;
}

[data-theme="light"] .field__label {
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

/* ============================================
   INPUTS - Adaptados al tema
   ============================================ */
input,
select,
textarea {
	width: 100%;
	border: 1px solid var(--input-border, rgba(243, 197, 0, 0.35));
	border-radius: 12px;
	padding: 0.75rem 0.85rem;
	font-size: 0.95rem;
	font-family: var(--font-family-base, "Manrope", sans-serif);
	outline: none;
	background: var(--input-bg, rgba(255, 255, 255, 0.06));
	color: var(--input-text, #ffffff);
}

[data-theme="light"] input,
[data-theme="light"] select,
[data-theme="light"] textarea {
	background: var(--input-bg, #f5f5f8);
	color: var(--input-text, #1a1a1e);
	border-color: rgba(18, 18, 18, 0.12);
}

input:focus,
select:focus,
textarea:focus {
	border-color: rgba(243, 197, 0, 0.7);
	box-shadow: 0 0 0 3px rgba(243, 197, 0, 0.22);
}

.filters-panel__actions {
	margin-top: 0.85rem;
	display: flex;
	gap: 0.6rem;
	justify-content: flex-end;
	flex-wrap: wrap;
}

/* ============================================
   BOTONES
   ============================================ */
.btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.45rem;
	min-height: 42px;
	padding: 0.72rem 1rem;
	border-radius: 12px;
	border: 1px solid transparent;
	font-family: var(--font-family-base, "Manrope", sans-serif);
	font-weight: 900;
	font-size: 0.95rem;
	cursor: pointer;
	transition: transform 0.15s ease, filter 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}

.btn:hover {
	transform: translateY(-1px);
}

.btn--yellow {
	background: linear-gradient(180deg, var(--yellow, #f3c500), #f1bb00);
	color: var(--ink, #111111);
}

.btn--ghost {
	background: var(--ghost-bg, rgba(255, 255, 255, 0.06));
	color: var(--ghost-text, #ffffff);
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
}

[data-theme="light"] .btn--ghost {
	background: rgba(18, 18, 18, 0.04);
	color: var(--ghost-text, #1a1a1e);
	border: 1px solid rgba(18, 18, 18, 0.08);
}

/* ============================================
   PRODUCTOS GRID - Adaptado al tema
   ============================================ */
.catalog-results {
	display: flex;
	gap: 1rem;
	background: var(--bg-card, rgba(255, 255, 255, 0.04));
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .catalog-results {
	background: var(--bg-card, #f5f5f8);
	color: var(--text-strong, #1a1a1e);
}

.catalog-status {
	display: none;
	padding: 0.95rem 1rem;
	border-radius: 18px;
	font-weight: 700;
	line-height: 1.5;
	border: 1px solid transparent;
}

.catalog-status.is-visible {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
}

.catalog-status--loading {
	background: var(--ghost-bg, rgba(255, 255, 255, 0.06));
	border-color: var(--border-light, rgba(255, 255, 255, 0.08));
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .catalog-status--loading {
	background: rgba(18, 18, 18, 0.04);
	border-color: rgba(18, 18, 18, 0.08);
	color: var(--text-strong, #1a1a1e);
}

.catalog-status--error {
	background: rgba(220, 38, 38, 0.1);
	border-color: rgba(220, 38, 38, 0.18);
	color: var(--danger-text, #f87171);
}

.catalog-status__content {
	display: flex;
	align-items: center;
	gap: 0.85rem;
	flex-wrap: wrap;
}

.catalog-status__actions {
	display: flex;
	gap: 0.55rem;
	flex-wrap: wrap;
}

.catalog-spinner {
	width: 1rem;
	height: 1rem;
	border-radius: 999px;
	border: 2px solid var(--border-light, rgba(255, 255, 255, 0.08));
	border-top-color: var(--text-strong, #ffffff);
	animation: spin 0.8s linear infinite;
}

[data-theme="light"] .catalog-spinner {
	border: 2px solid rgba(18, 18, 18, 0.1);
	border-top-color: var(--text-strong, #1a1a1e);
}

.catalog-retry {
	min-height: 38px;
	padding: 0.55rem 0.85rem;
	border-radius: 12px;
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
	background: var(--ghost-bg, rgba(255, 255, 255, 0.06));
	color: var(--ghost-text, #ffffff);
	font-weight: 800;
	cursor: pointer;
}

[data-theme="light"] .catalog-retry {
	border: 1px solid rgba(18, 18, 18, 0.08);
	background: rgba(18, 18, 18, 0.04);
	color: var(--ghost-text, #1a1a1e);
}

/* ============================================
   PRODUCTOS GRID - Adaptado al tema
   ============================================ */
.productos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    width: 100%;
}

.producto-card,
.producto-card--skeleton {
	position: relative;
	overflow: hidden;
	border-radius: 8px;
	padding: 0.95rem;
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
	box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
	background: linear-gradient(180deg, var(--card, rgba(255, 255, 255, 0.05)), var(--bg-card, rgba(255, 255, 255, 0.04)));
}

[data-theme="light"] .producto-card,
[data-theme="light"] .producto-card--skeleton {
	border: 1px solid rgba(18, 18, 18, 0.08);
	background: linear-gradient(180deg, var(--card, #ffffff), var(--bg-card, #f5f5f8));
}

.producto-card {
	width: 300px;
	height: auto;
	transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.producto-card:hover {
	transform: translateY(-4px);
	box-shadow: 0 18px 35px rgba(15, 23, 42, 0.12);
}

[data-theme="light"] .producto-card:hover {
	box-shadow: 0 18px 35px rgba(18, 18, 18, 0.08);
}

.producto-card--skeleton::before {
	content: "";
	position: absolute;
	inset: 0;
	background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
	transform: translateX(-100%);
	animation: shimmer 1.4s infinite;
}

[data-theme="light"] .producto-card--skeleton::before {
	background: linear-gradient(90deg, transparent, rgba(18, 18, 18, 0.06), transparent);
}

.skeleton-block {
	position: relative;
	overflow: hidden;
	border-radius: 12px;
	background: var(--skeleton-bg, rgba(255, 255, 255, 0.08));
	margin-bottom: 0.75rem;
}

[data-theme="light"] .skeleton-block {
	background: rgba(18, 18, 18, 0.06);
}

.skeleton-block--image {
	height: 170px;
}

.skeleton-block--line {
	height: 14px;
	width: 78%;
}

.skeleton-block--line.short {
	width: 55%;
}

.producto-imagen {
	width: 100%;
	aspect-ratio: 1 / 1;
	height: auto;
	background: linear-gradient(135deg, rgba(243, 197, 0, 0.18), rgba(17, 24, 39, 0.06));
	border-radius: 8px;
	margin-bottom: 0.75rem;
	overflow: hidden;
	position: relative;
}

[data-theme="light"] .producto-imagen {
	background: linear-gradient(135deg, rgba(243, 197, 0, 0.10), rgba(18, 18, 18, 0.04));
}

.producto-imagen img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	display: block;
}

.producto-nombre {
	font-weight: 900;
	font-size: 1rem;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .producto-nombre {
	color: var(--text-strong, #1a1a1e);
}

.producto-marca {
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
	font-size: 0.86rem;
}

[data-theme="light"] .producto-marca {
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.producto-precios {
	margin: 0.75rem 0 0.1rem;
}

.precio-usd {
	font-weight: 900;
	font-size: 1.25rem;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .precio-usd {
	color: var(--text-strong, #1a1a1e);
}

.precio-bs {
	font-size: 0.86rem;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
}

[data-theme="light"] .precio-bs {
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.producto-stock {
	font-size: 0.82rem;
	color: #16a34a;
	font-weight: 700;
}

.producto-stock--low {
	color: #b45309;
	font-weight: 800;
}

.btn-agregar {
	width: 100%;
	margin-top: 0.75rem;
}

.pager {
	display: inline-flex;
	align-items: center;
	gap: 0.6rem;
}

.catalog-empty,
.catalog-error-box {
	padding: 1rem;
	border-radius: 16px;
	border: 1px dashed var(--border-light, rgba(255, 255, 255, 0.08));
	background: var(--ghost-bg, rgba(255, 255, 255, 0.06));
	font-weight: 700;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
}

[data-theme="light"] .catalog-empty,
[data-theme="light"] .catalog-error-box {
	border: 1px dashed rgba(18, 18, 18, 0.08);
	background: rgba(18, 18, 18, 0.04);
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.catalog-error-box {
	display: grid;
	gap: 0.75rem;
	justify-items: start;
}

.catalog-error-box p,
.catalog-empty p {
	margin: 0;
}

/* ============================================
   CARRITO - Adaptado al tema
   ============================================ */
.cart-modal-panel {
	max-width: 540px;
	width: 100%;
}

.cart-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	margin-bottom: 1rem;
}

.cart-items {
	max-height: 400px;
	overflow-y: auto;
	display: grid;
	gap: 0.75rem;
}

.cart-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 0.75rem;
	padding: 0.75rem 0;
	border-bottom: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
}

[data-theme="light"] .cart-item {
	border-bottom: 1px solid rgba(18, 18, 18, 0.08);
}

.cart-item-info {
	flex: 1;
}

.cart-item-name {
	font-weight: 800;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .cart-item-name {
	color: var(--text-strong, #1a1a1e);
}

.cart-item-price {
	font-size: 0.85rem;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
}

[data-theme="light"] .cart-item-price {
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.cart-item-controls {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	flex-wrap: wrap;
	justify-content: flex-end;
}

.icon-action {
	width: 38px;
	height: 38px;
	border-radius: 12px;
	border: 1px solid var(--border-light, rgba(255, 255, 255, 0.08));
	background: var(--ghost-bg, rgba(255, 255, 255, 0.06));
	cursor: pointer;
	display: grid;
	place-items: center;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
	transition: transform 0.15s ease, filter 0.2s ease;
}

[data-theme="light"] .icon-action {
	border: 1px solid rgba(18, 18, 18, 0.08);
	background: rgba(18, 18, 18, 0.04);
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

.icon-action:hover {
	transform: translateY(-1px);
	filter: brightness(1.02);
}

.cart-item-qty {
	width: 50px;
	text-align: center;
	font-weight: 900;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .cart-item-qty {
	color: var(--text-strong, #1a1a1e);
}

.cart-total {
	margin-top: 1rem;
	padding-top: 1rem;
	border-top: 2px solid var(--yellow, #f3c500);
	display: grid;
	gap: 0.25rem;
	text-align: right;
	color: var(--text-strong, #ffffff);
}

[data-theme="light"] .cart-total {
	color: var(--text-strong, #1a1a1e);
}

.sin-resultados,
.carrito-vacio {
	margin: 0;
	padding: 1rem;
	background: var(--ghost-bg, rgba(255, 255, 255, 0.06));
	border: 1px dashed var(--border-light, rgba(255, 255, 255, 0.08));
	border-radius: 14px;
	font-weight: 700;
	color: var(--text-muted, rgba(255, 255, 255, 0.65));
}

[data-theme="light"] .sin-resultados,
[data-theme="light"] .carrito-vacio {
	background: rgba(18, 18, 18, 0.04);
	border: 1px dashed rgba(18, 18, 18, 0.08);
	color: var(--text-muted, rgba(26, 26, 30, 0.5));
}

/* ============================================
   MODAL
   ============================================ */
.modal {
	position: fixed;
	inset: 0;
	z-index: 50;
	display: grid;
	place-items: center;
	padding: 1.1rem;
}

.modal.is-hidden {
	display: none;
}

.modal__backdrop {
	position: absolute;
	inset: 0;
	background: rgba(0, 0, 0, 0.55);
}

.modal__panel {
	position: relative;
	width: min(860px, 100%);
	max-height: min(82vh, 820px);
	overflow: auto;
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 980px) {
	.catalog-toolbar {
		gap: 0.55rem;
	}

	.catalog-toolbar__search {
		width: 100%;
		margin-right: 0;
	}

	.catalog-search-box.is-open,
	.catalog-search-box input {
		width: 100%;
		max-width: 100%;
	}

	.catalog-filter-select {
		min-width: 0;
		flex: 1 1 160px;
	}

	.catalog-filter-select select {
		width: 100%;
	}

	.productos-grid {
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
    }
}

@media (max-width: 640px) {
    .productos-grid {
        grid-template-columns: 1fr;
    }
}

/* ============================================
   ANIMACIONES
   ============================================ */
@keyframes floatGlow {
	0%,
	100% {
		transform: translate3d(0, 0, 0) scale(1);
	}

	50% {
		transform: translate3d(18px, -12px, 0) scale(1.08);
	}
}

@keyframes heroGradientFloat {
	0% {
		background-position: 0% 50%, 0% 0%;
	}

