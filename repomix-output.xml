<file path="app/static/css/clientes.css">
/* ============================================
   CLIENTES - Estilos específicos
   Hereda de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

/* Grid principal - 1 columna (solo tabla) */
.clientes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   BADGES PARA TIPOS DE CLIENTE
   ============================================ */
.badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
}

.badge--natural {
    background: rgba(40, 167, 69, 0.15);
    color: #28a745;
    border: 1px solid rgba(40, 167, 69, 0.25);
}

.badge--juridico {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
}

/* ============================================
   CAMPOS CONDICIONALES (animación)
   ============================================ */
.campos-condicionales {
    transition: all 0.3s ease;
}

/* ============================================
   TOAST (notificación)
   ============================================ */
.toast {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 9999;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    background: var(--bg);
    color: var(--text-strong);
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    box-shadow: var(--shadow-card);
    pointer-events: none;
    font-weight: 700;
    border: 1px solid var(--glass-border);
}

.toast.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.toast--error {
    background: rgba(220, 38, 38, 0.92);
    color: #ffffff;
    border-color: rgba(220, 38, 38, 0.5);
}

/* ============================================
   COLUMNAS CON ANCHO AJUSTADO
   ============================================ */

/* Columna ID - más ancha para cédulas de 7-8 dígitos */
.col-id {
    min-width: 110px;
    max-width: 130px;
    white-space: nowrap;
}

/* Columna Tipo */
.table th:nth-child(2),
.table td:nth-child(2) {
    min-width: 130px;
    max-width: 150px;
    white-space: nowrap;
}

/* Columna Nombre */
.table th:nth-child(3),
.table td:nth-child(3) {
    min-width: 120px;
    max-width: 180px;
}

/* Columna Apellido / Razón Social */
.table th:nth-child(4),
.table td:nth-child(4) {
    min-width: 130px;
    max-width: 200px;
}

/* Columna Celular - más ancha para 11 dígitos */
.table th:nth-child(5),
.table td:nth-child(5) {
    min-width: 130px;
    max-width: 160px;
    white-space: nowrap;
}

/* Columna Correo */
.table th:nth-child(6),
.table td:nth-child(6) {
    min-width: 160px;
    max-width: 220px;
    word-break: break-all;
}

/* Columna Dirección */
.table th:nth-child(7),
.table td:nth-child(7) {
    min-width: 120px;
    max-width: 200px;
}

/* Columna Acciones */
.table th:nth-child(8),
.table td:nth-child(8) {
    min-width: 130px;
    max-width: 150px;
    white-space: nowrap;
}

/* ============================================
   CHIP - Mejorado para IDs
   ============================================ */
.chip {
    display: inline-block;
    background: rgba(243, 197, 0, 0.15);
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-strong);
    border: 1px solid rgba(243, 197, 0, 0.3);
    font-family: "SF Mono", "Consolas", "Monaco", monospace;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
}

.chip:hover {
    background: rgba(243, 197, 0, 0.3);
    transform: scale(1.05);
}

/* ============================================
   DETALLE DE CLIENTE (modal)
   ============================================ */
.cliente-detalle {
    padding: 0.5rem 0;
}

.cliente-detalle__avatar {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
}

.avatar-inicial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, var(--yellow), var(--yellow-soft));
    border-radius: 50%;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    box-shadow: 0 8px 20px rgba(243, 197, 0, 0.3);
}

.cliente-detalle__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
}

.detalle-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.detalle-item--full {
    grid-column: 1 / -1;
}

.detalle-item label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--text-muted);
}

.detalle-item p {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-strong);
    word-break: break-word;
    padding: 0.4rem 0;
    border-bottom: 1px dashed var(--border-light);
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 1100px) {
    .hero {
        grid-template-columns: 1fr;
    }
    .stats {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 780px) {
    .stats {
        grid-template-columns: 1fr;
    }
    
    .col-id {
        min-width: 80px;
        max-width: 100px;
    }
    
    .table th:nth-child(5),
    .table td:nth-child(5) {
        min-width: 110px;
        max-width: 130px;
    }
    
    .cliente-detalle__grid {
        grid-template-columns: 1fr;
    }
    .detalle-item--full {
        grid-column: 1;
    }
}

@media (max-width: 560px) {
    .col-id {
        min-width: 70px;
        max-width: 90px;
    }
    
    .table th:nth-child(5),
    .table td:nth-child(5) {
        min-width: 100px;
        max-width: 120px;
    }
    
    .table th:nth-child(2),
    .table td:nth-child(2) {
        min-width: 100px;
        max-width: 120px;
    }
}

/* Estilo para select deshabilitado */
select:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    background-color: #686a6c;
}

#campos-juridico {
    display: none;
}
