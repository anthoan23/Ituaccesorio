  <!-- Contenido principal -->
  <section class="content entregas-grid" aria-label="Tablas por pestañas">
    <article class="card card--tabs" aria-label="Panel de entregas y personal">
      <!-- Tabs -->
      <div class="tabs" role="tablist" aria-label="Pestañas de entregas">
        <button class="tab is-active" type="button" role="tab" aria-selected="true" aria-controls="tab-panel-entregas" id="tab-entregas" data-table-tab="entregas">Entregas</button>
        <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="tab-panel-personal" id="tab-personal" data-table-tab="personal">Personal Delivery</button>
      </div>

      <!-- Tabla de Entregas -->
      <section id="tab-panel-entregas" class="tab-panel" role="tabpanel" aria-labelledby="tab-entregas" data-table-panel="entregas">
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Entregas registradas</h2>
            <p class="card__subtitle">Listado de todas las entregas de pedidos.</p>
          </div>
          <div class="card__actions">
            <button id="btn-nueva-entrega" class="ui-btn ui-btn--primary" type="button" data-admin-target="entregas">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Registrar entrega
            </button>
          </div>
        </div>

        <div class="entregas-toolbar">
          <label class="field entregas-toolbar__field">
            <span>Buscar entregas</span>
            <input id="input-buscar-entregas" type="search" placeholder="Buscar por factura, delivery o dirección">
          </label>
          <label class="field entregas-toolbar__field">
            <span>Filtrar por estado</span>
            <div class="select-wrapper">
              <select id="filtro-estado">
                <option value="">Todos</option>
                <option value="0">Pendiente</option>
                <option value="1">En camino</option>
                <option value="2">Entregado</option>
                <option value="3">Cancelado</option>
                <option value="4">Programado</option>
              </select>
            </div>
          </label>
        </div>

        <div class="table-wrap" role="region" aria-label="Tabla de entregas">
          <table class="table">
            <thead>
              <tr>
                <th class="col-id">ID Entrega</th>
                <th>Factura</th>
                <th>Delivery</th>
                <th>Estado</th>
                <th>Dirección</th>
                <th>Fecha</th>
                <th class="table__actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-entregas">
              <tr><td colspan="7" class="table__loading">Cargando entregas...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Tabla de Personal Delivery -->
      <section id="tab-panel-personal" class="tab-panel" role="tabpanel" aria-labelledby="tab-personal" data-table-panel="personal" hidden>
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Personal de delivery</h2>
            <p class="card__subtitle">Listado de repartidores registrados.</p>
          </div>
          <div class="card__actions">
            <button id="btn-nuevo-personal" class="ui-btn ui-btn--primary" type="button" data-admin-target="personal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Registrar delivery
            </button>
          </div>
        </div>

        <div class="entregas-toolbar">
          <label class="field entregas-toolbar__field">
            <span>Buscar personal</span>
            <input id="input-buscar-personal" type="search" placeholder="Buscar por cédula o nombre">
          </label>
        </div>

        <div class="table-wrap" role="region" aria-label="Tabla de personal delivery">
          <table class="table">
            <thead>
              <tr>
                <th class="col-id">Cédula</th>
                <th>Nombre completo</th>
                <th class="table__actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-personal">
              <tr><td colspan="3" class="table__loading">Cargando personal...</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </article>
  </section>

  <!-- Modal Registrar/Editar Entrega -->
  {% call modal('modal-entrega', 'Registrar entrega', 'lg') %}
    <form id="form-entrega" class="ui-form" autocomplete="off">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="id" value="">

      <div class="ui-form__grid ui-form__grid--one">
        <label class="field">
          <span>Factura <span class="required-indicator">*</span></span>
          <div class="select-wrapper">
            <select name="factura_id" id="factura-id" required>
              <option value="">Seleccione una factura</option>
            </select>
          </div>
        </label>

        <label class="field">
          <span>Delivery <span class="required-indicator">*</span></span>
          <div class="select-wrapper">
            <select name="cedula_delivery" id="delivery-cedula" required>
              <option value="">Seleccione un delivery</option>
            </select>
          </div>
        </label>

        <label class="field">
          <span>Dirección de entrega <span class="required-indicator">*</span></span>
          <textarea name="direccion" rows="3" placeholder="Dirección completa" required
                    maxlength="60" data-validation-rules="sinCaracteresEspeciales" title="Sin caracteres especiales"></textarea>
          <small class="field-hint">Sin caracteres especiales (máximo 60 caracteres)</small>
        </label>

        <label class="field">
          <span>Estado</span>
          <div class="select-wrapper">
            <select name="estado" id="estado-entrega">
              <option value="0">Pendiente</option>
              <option value="1">En camino</option>
              <option value="2">Entregado</option>
              <option value="3">Cancelado</option>
              <option value="4">Programado</option>
            </select>
          </div>
        </label>
      </div>

      <div class="ui-form__actions">
        <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
        <button type="button" class="ui-btn ui-btn--ghost" data-reset-form="entrega">Limpiar</button>
        <button type="submit" class="ui-btn ui-btn--primary">Guardar entrega</button>
      </div>
    </form>
  {% endcall %}

  <!-- Modal Registrar/Editar Personal -->
  {% call modal('modal-personal', 'Registrar delivery', 'lg') %}
    <form id="form-personal" class="ui-form" autocomplete="off">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="cedula_original" id="personal-cedula-original" value="">

      <div class="ui-form__grid ui-form__grid--two">
        <label class="field">
          <span>Cédula <span class="required-indicator">*</span></span>
          <input name="cedula" id="personal-cedula" type="text" placeholder="12345678" required 
                 maxlength="15" data-validation-rules="soloNumeros" title="Solo números">
          <small class="field-hint">Solo números, máximo 15 caracteres</small>
        </label>

        <label class="field">
          <span>Nombre <span class="required-indicator">*</span></span>
          <input name="nombre" id="personal-nombre" type="text" placeholder="Carlos" required 
                 maxlength="15" data-validation-rules="soloLetras,capitalizar" title="Solo letras, espacios, acentos y ñ">
          <small class="field-hint">Solo letras, espacios, acentos y ñ (máximo 15 caracteres)</small>
        </label>

        <label class="field">
          <span>Apellido <span class="required-indicator">*</span></span>
          <input name="apellido" id="personal-apellido" type="text" placeholder="Pérez" required 
                 maxlength="15" data-validation-rules="soloLetras,capitalizar" title="Solo letras, espacios, acentos y ñ">
          <small class="field-hint">Solo letras, espacios, acentos y ñ (máximo 15 caracteres)</small>
        </label>
      </div>

      <div class="ui-form__actions">
        <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
        <button type="button" class="ui-btn ui-btn--ghost" data-reset-form="personal">Limpiar</button>
        <button type="submit" class="ui-btn ui-btn--primary">Guardar delivery</button>
      </div>
    </form>
  {% endcall %}

  <!-- Modal de confirmación para eliminar -->
  {% call modal('modal-eliminar', 'Eliminar registro', 'sm') %}
    <p id="confirmar-mensaje" class="confirm-text">¿Estás seguro de que quieres eliminar este registro?</p>
    <div class="ui-form__actions">
      <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
      <button id="btn-confirmar-eliminar" type="button" class="ui-btn ui-btn--danger">Confirmar</button>
    </div>
  {% endcall %}

  <div id="toast" class="toast" role="status" aria-live="polite"></div>
</main>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/field-validator.js') }}"></script>
<script src="{{ url_for('static', filename='js/entregas.js') }}"></script>
{% endblock %}
</file>

<file path="views/especialidades.html">
{% extends 'components/layout/base.html' %}
{% from 'components/ui/modal.html' import modal %}

{% block title %}Ituaccesorio - Especialidades{% endblock %}

{% block head_extra %}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/especialidades.css') }}">
{% endblock %}

{% block content %}
  <main class="page especialidades-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li><a href="{{ url_for('home.home') }}">Inicio</a></li>
        <li aria-current="page">
          <span class="breadcrumb__current">Especialidades</span>
        </li>
      </ol>
    </nav>

    <header class="especialidades-hero">
      <div class="especialidades-hero__copy">
        <p class="especialidades-hero__eyebrow">Gestión de especialidades</p>
        <h1 class="especialidades-hero__title">Especialidades</h1>
        <p class="especialidades-hero__description">Vista simple para consultar y registrar especialidades.</p>
      </div>

      <div class="stats stats--single" aria-label="Resumen de especialidades">
        <article class="stat-card">
          <span class="stat-card__label">Especialidades</span>
          <strong class="stat-card__value" data-count="7">0</strong>
          <small class="stat-card__meta">Total de especialidades visibles</small>
        </article>
      </div>
    </header>

    <section class="content vista-1 especialidades-grid" aria-label="Gestión de especialidades">
      <article class="card card--table especialidades-table-card" aria-label="Especialidades registradas">
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Catálogo de especialidades</h2>
            <p class="card__subtitle">Tabla principal de especialidades registradas.</p>
          </div>
        </div>

        <div class="table-wrap table-wrap--tall" role="region" aria-label="Tabla de especialidades">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="table__actions">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-especialidades"></tbody>
          </table>
        </div>
      </article>

      <article class="card card--form especialidad-create-card" aria-label="Registrar nueva especialidad">
        <div class="card__header">
          <div class="card__header-left">
            <h2 class="card__title">Registrar nueva especialidad</h2>
            <p class="card__subtitle">Completa nombre y descripción para crear una especialidad.</p>
          </div>
        </div>

        <form id="form-especialidad" class="cargo-form" autocomplete="off">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
          
          <label class="cargo-form__field">
            <span>Nombre</span>
            <input type="text" 
                   name="nombre_especialidad" 
                   placeholder="Ej: Soporte Técnico" 
                   minlength="3"
                   maxlength="30"
                   required
                   data-validation-rules="soloLetras,capitalizar"
                   title="Solo letras, espacios, acentos y ñ">
            <small class="field-hint" >Solo letras, espacios, acentos y ñ (mínimo 3 caracteres)</small>
          </label>

          <label class="cargo-form__field cargo-form__field--full">
            <span>Descripción</span>
            <textarea name="descripcion_especialidad" 
                      rows="4" 
                      placeholder="Ej: Responsable de la reparación y mantenimiento de equipos"
                      minlength="3"
                      maxlength="250"
                      required
                      data-validation-rules="sinNumeros,sinSimbolos"
                      title="No se permiten números ni símbolos especiales"></textarea>
            <small class="field-hint" >No se permiten números ni símbolos especiales (mínimo 3 caracteres)</small>
          </label>
          
          <div class="cargo-form__actions cargo-form__actions--top cargo-form__actions--center">
            <button class="btn-icon-action--success" type="submit">
              Registrar especialidad
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                <polyline points="17 21 17 13 7 13 7 21"/>
                <polyline points="7 3 7 8 15 8"/>
              </svg>
            </button>
          </div>
        </form>
      </article>
    </section>

    {% call modal('modal-editar-especialidad', 'Modificar especialidad', 'sm') %}
      <form id="form-editar-especialidad" class="ui-form" autocomplete="off">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="id_especialidad" id="editar-id-especialidad">

        <div class="ui-form__grid ui-form__grid--one">
          <label class="cargo-form__field">
            <span>Nombre</span>
            <input id="editar-nombre-especialidad" 
                   type="text" 
                   name="nombre_especialidad" 
                   required
                   minlength="3"
                   maxlength="30"
                   data-validation-rules="soloLetras,capitalizar"
                   title="Solo letras, espacios, acentos y ñ">
            <small class="field-hint" >Solo letras, espacios, acentos y ñ (mínimo 3 caracteres)</small>
          </label>
          <label class="cargo-form__field cargo-form__field--full">
            <span>Descripción</span>
            <textarea id="editar-descripcion-especialidad" 
                      name="descripcion_especialidad" 
                      rows="4" 
                      required
                      minlength="3"
                      maxlength="250"
                      data-validation-rules="sinNumeros,sinSimbolos"
                      title="No se permiten números ni símbolos especiales"></textarea>
            <small class="field-hint" >No se permiten números ni símbolos especiales (mínimo 3 caracteres)</small>
          </label>
        </div>

        <div class="ui-form__actions">
          <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
          <button type="submit" class="ui-btn ui-btn--primary">Guardar cambios</button>
        </div>
      </form>
    {% endcall %}

    {% call modal('modal-eliminar-especialidad', 'Eliminar especialidad', 'sm') %}
      <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
      <p id="texto-confirmar-eliminar-especialidad" class="confirm-text">¿Estás seguro de que quieres eliminar este registro?</p>
      <div class="ui-form__actions">
        <button id="btn-confirmar-eliminar-especialidad" type="button" class="ui-btn ui-btn--primary">Sí, eliminar</button>
        <button type="button" class="ui-btn ui-btn--ghost" data-close-modal>Cancelar</button>
      </div>
    {% endcall %}
  </main>
{% endblock %}

{% block scripts %}
  <script src="{{ url_for('static', filename='js/especialidades.js') }}"></script>
{% endblock %}
</file>

<file path="views/index.html">
{% extends 'components/layout/base.html' %}

{% block title %}iTuAccesorio - Dashboard{% endblock %}

{% block head_extra %}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/index.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* Asegurar que el body no tenga márgenes */
        body {
            margin: 0;
            padding: 0;
            background: #0A0A0A;
            overflow-x: hidden;
        }
        main {
            background: #0A0A0A;
            min-height: 100vh;
            padding: 0;
            margin: 0;
        }
        .page {
            max-width: 100%;
            padding: 0;
            margin: 0;
        }
    </style>
{% endblock %}

{% block content %}
<div class="dashboard">
    <!-- ============================================================ -->
    <!-- KPI CARDS -->
    <!-- ============================================================ -->
    <section class="kpi-grid">
        <!-- Card 1: Ventas Hoy -->
        <div class="kpi-card">
            <div class="kpi-card__top">
                <div class="kpi-card__icon kpi-card__icon--yellow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <span class="kpi-card__trend trend-up">+12.5%</span>
            </div>
            <div class="kpi-card__value" id="kpi-ventas-hoy">$0.00</div>
            <div class="kpi-card__label">Ventas Hoy</div>
            <div class="kpi-card__chart">
                <svg viewBox="0 0 120 30" preserveAspectRatio="none">
                    <polyline points="0,25 20,18 40,22 60,10 80,15 100,8 120,12" fill="none" stroke="#FFD60A" stroke-width="2"/>
                    <polyline points="0,25 20,18 40,22 60,10 80,15 100,8 120,12" fill="none" stroke="#FFD60A" stroke-width="4" opacity="0.15"/>
                </svg>
            </div>
        </div>

        <!-- Card 2: Órdenes Activas -->
        <div class="kpi-card">
            <div class="kpi-card__top">
                <div class="kpi-card__icon kpi-card__icon--blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                </div>
                <span class="kpi-card__trend trend-up">+8.3%</span>
            </div>
            <div class="kpi-card__value" id="kpi-ordenes-activas">0</div>
            <div class="kpi-card__label">Órdenes Activas</div>
            <div class="kpi-card__chart">
                <svg viewBox="0 0 120 30" preserveAspectRatio="none">
                    <polyline points="0,20 20,15 40,18 60,5 80,12 100,5 120,8" fill="none" stroke="#007AFF" stroke-width="2"/>
                    <polyline points="0,20 20,15 40,18 60,5 80,12 100,5 120,8" fill="none" stroke="#007AFF" stroke-width="4" opacity="0.15"/>
                </svg>
            </div>
        </div>

        <!-- Card 3: Equipos Reparados -->
        <div class="kpi-card">
            <div class="kpi-card__top">
                <div class="kpi-card__icon kpi-card__icon--green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
                <span class="kpi-card__trend trend-up">+5.2%</span>
            </div>
            <div class="kpi-card__value" id="kpi-reparados">0</div>
            <div class="kpi-card__label">Equipos Reparados</div>
            <div class="kpi-card__chart">
                <svg viewBox="0 0 120 30" preserveAspectRatio="none">
                    <polyline points="0,22 20,12 40,20 60,10 80,18 100,5 120,5" fill="none" stroke="#34C759" stroke-width="2"/>
                    <polyline points="0,22 20,12 40,20 60,10 80,18 100,5 120,5" fill="none" stroke="#34C759" stroke-width="4" opacity="0.15"/>
                </svg>
            </div>
        </div>

        <!-- Card 4: Ingresos Mensuales -->
        <div class="kpi-card">
            <div class="kpi-card__top">
                <div class="kpi-card__icon kpi-card__icon--red">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <span class="kpi-card__trend trend-down">-2.1%</span>
            </div>
            <div class="kpi-card__value" id="kpi-ingresos">$0</div>
            <div class="kpi-card__label">Ingresos Mensuales</div>
            <div class="kpi-card__chart">
                <svg viewBox="0 0 120 30" preserveAspectRatio="none">
                    <polyline points="0,18 20,25 40,15 60,20 80,12 100,18 120,10" fill="none" stroke="#FF3B30" stroke-width="2"/>
                    <polyline points="0,18 20,25 40,15 60,20 80,12 100,18 120,10" fill="none" stroke="#FF3B30" stroke-width="4" opacity="0.15"/>
                </svg>
            </div>
        </div>
    </section>

    <!-- ============================================================ -->
    <!-- GRÁFICO + ACTIVIDAD -->
    <!-- ============================================================ -->
    <section class="two-col-grid">
        <div class="chart-card">
            <div class="chart-card__header">
                <div>
                    <h3 class="chart-card__title">Ingresos vs Gastos</h3>
                    <p class="chart-card__subtitle">Últimos 7 días</p>
                </div>
                <div class="chart-card__legend">
                    <span><span class="legend-dot legend-dot--income"></span> Ingresos</span>
                    <span><span class="legend-dot legend-dot--expense"></span> Gastos</span>
                </div>
            </div>
            <div class="chart-card__body" id="chart-container">
                <canvas id="main-chart"></canvas>
            </div>
        </div>

        <div class="activity-card">
