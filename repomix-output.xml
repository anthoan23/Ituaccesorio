/* ============================================
   BITACORA.CSS - UNIFICADO CON THEME.CSS
   Hereda todas las variables de theme.css
   ============================================ */

@import url("./theme.css");

/* ============================================
   LAYOUT PRINCIPAL
   ============================================ */

.bitacora-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
    width: 100%;
}

/* ============================================
   HERO - ACCIONES
   ============================================ */
.hero__actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================
   COLUMNAS DE TABLA
   ============================================ */
.col-id {
    width: 100px;
    min-width: 80px;
    white-space: nowrap;
}

.col-usuario {
    width: 200px;
    min-width: 160px;
}

.col-accion {
    width: 150px;
    min-width: 120px;
}

.col-modulo {
    width: 150px;
    min-width: 120px;
}

.col-fecha {
    width: 200px;
    min-width: 170px;
}

/* Columna de descripción */
.table td:not(.col-id):not(.col-usuario):not(.col-accion):not(.col-modulo):not(.col-fecha),
.table th:not(.col-id):not(.col-usuario):not(.col-accion):not(.col-modulo):not(.col-fecha) {
    min-width: 150px;
    max-width: 350px;
    word-break: break-word;
}

/* ============================================
   CHIP PARA ID
   ============================================ */
.chip {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    background: var(--glass-bg);
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.8rem;
    min-width: 35px;
    text-align: center;
    border: 1px solid var(--border-light);
    color: var(--text-strong);
}

/* ============================================
   USUARIO CELL
   ============================================ */
.user-cell {
    display: flex;
    align-items: center;
    gap: 8px;
}

.user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 0.8rem;
    flex-shrink: 0;
    text-transform: uppercase;
}

.user-cell span {
    font-weight: 700;
    color: var(--text-strong);
}

/* ============================================
   BADGES DE ACCIÓN
   ============================================ */
.badge {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.badge--crear {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.25);
}

.badge--actualizar {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.25);
}

.badge--eliminar {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
}

.badge--login {
    background: rgba(139, 92, 246, 0.15);
    color: #8b5cf6;
    border: 1px solid rgba(139, 92, 246, 0.25);
}

.badge--logout {
    background: rgba(107, 114, 128, 0.15);
    color: #6b7280;
    border: 1px solid rgba(107, 114, 128, 0.25);
}

.badge--error {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
}

.badge--default {
    background: var(--glass-bg);
    color: var(--text-muted);
    border: 1px solid var(--border-light);
}

/* ============================================
   EVENTO ROW (clickeable)
   ============================================ */
.evento-row {
    cursor: pointer;
    transition: background 0.2s ease;
}

.evento-row:hover {
    background: var(--ghost-hover-bg) !important;
}

/* ============================================
   DETALLE GRID
   ============================================ */
.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
}

.detail-item {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    background: var(--glass-bg);
}

.detail-item--full {
    grid-column: 1 / -1;
}

.detail-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--text-muted);
}

.detail-value {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-strong);
    line-height: 1.4;
    white-space: pre-wrap;
    word-break: break-word;
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 1100px) {
    .bitacora-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 920px) {
    .hero__actions {
        justify-content: flex-start;
        width: 100%;
    }
    
    .hero__actions .ui-btn {
        flex: 1;
        min-width: 120px;
        justify-content: center;
    }
}

@media (max-width: 780px) {
    .col-id,
    .col-usuario,
    .col-accion,
    .col-modulo,
    .col-fecha {
        width: auto;
        min-width: 0;
        white-space: normal;
    }
    
    .table {
        min-width: 650px;
    }
    
    .detail-grid {
        grid-template-columns: 1fr;
    }
    
    .user-avatar {
        width: 28px;
        height: 28px;
        font-size: 0.7rem;
    }
    
    .chip {
        font-size: 0.7rem;
        padding: 0.1rem 0.4rem;
        min-width: 28px;
    }
}

@media (max-width: 480px) {
    .table {
        min-width: 550px;
    }
    
    .user-cell span {
        font-size: 0.8rem;
    }
    
    .col-id {
        width: 70px;
        min-width: 60px;
    }
    
    .col-usuario {
        width: 150px;
        min-width: 120px;
    }
    
    .col-accion {
        width: 120px;
        min-width: 100px;
    }

    .col-modulo {
        width: 120px;
        min-width: 100px;
    }

    .col-fecha {
        width: 160px;
        min-width: 140px;
    }
}
